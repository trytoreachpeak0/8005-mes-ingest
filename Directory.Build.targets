<Project>

  <!-- Fourth enforcement layer of the toolchain baseline, 8005-agv-program
       docs/adr/cross/0056. A banned package fails the build here rather than
       being noticed later by check-toolchain.ps1 from the workspace root.

       This landed together with the MesIngest.Tests xunit v3 migration:
       installing it earlier would have broken that project's build, and an
       exemption for it would have been a permanent hole.

       Item identities match exactly, so xunit.v3 is not caught by "xunit". -->
  <ItemGroup>
    <BannedPackage Include="xunit" />
    <BannedPackage Include="xunit.core" />
    <BannedPackage Include="xunit.assert" />
    <BannedPackage Include="xunit.extensibility.core" />
    <BannedPackage Include="NUnit" />
    <BannedPackage Include="NUnit3TestAdapter" />
    <BannedPackage Include="MSTest.TestFramework" />
    <BannedPackage Include="MSTest.TestAdapter" />
    <BannedPackage Include="coverlet.collector" />
  </ItemGroup>

  <!-- Only banned packages are guarded here, and that is a limit worth knowing.
       An inline Version= under central package management CANNOT be caught at
       build time: NuGet strips the metadata during project evaluation, so by the
       time any target runs, %(PackageReference.Version) is empty even for a
       project that spells a version out. Verified on SDK 8.0.424 — a project
       asking for Oracle.ManagedDataAccess.Core 23.6.0 resolved 23.9.0 from
       Directory.Packages.props, with no NU1008, no warning, and nothing for a
       target to read. CentralPackageVersionOverrideEnabled=false does not cover
       it either; that governs the VersionOverride attribute, not Version.
       The version therefore never actually drifts — the central value always
       wins — but whoever wrote the inline one is not told it was ignored.
       Catching that is check-toolchain.ps1's job at the workspace root: it reads
       the csproj as text, which is the only place the inline version still
       exists. Do not add an MSBuild target for it; one was written and removed
       after it silently passed every case it was meant to fail. -->

  <Target Name="GuardBannedPackages" BeforeTargets="CollectPackageReferences;Build">
    <ItemGroup>
      <_AllowedPackage Include="@(PackageReference)" Exclude="@(BannedPackage)" />
      <_BannedInUse Include="@(PackageReference)" Exclude="@(_AllowedPackage)" />
    </ItemGroup>
    <Error Condition="'@(_BannedInUse)' != ''"
           Code="W2G0056"
           Text="$(MSBuildProjectName) references banned package(s): @(_BannedInUse). The workspace test stack is xunit.v3 3.2.2 + Microsoft.NET.Test.Sdk 18.8.1 + xunit.runner.visualstudio 3.1.5. See 8005-agv-program docs/adr/cross/0056-dotnet-toolchain-baseline.md." />
  </Target>

</Project>
