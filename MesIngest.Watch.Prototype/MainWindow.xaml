<!--
  PROTOTYPE — throw away after review.
  Three structural variants of the six-area MesIngestWatch V2 shell, switchable with
  the fixed bottom bar or the variant command-line option. Fake data only; no Host is contacted.
-->
<Window x:Class="MesIngest.Watch.Prototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MesIngest.Watch.Prototype"
        Title="MesIngestWatch V2 — THROWAWAY PROTOTYPE"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#F2F5F8" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMuted" Color="#E9EEF3" />
        <SolidColorBrush x:Key="Line" Color="#CBD5DF" />
        <SolidColorBrush x:Key="Ink" Color="#182330" />
        <SolidColorBrush x:Key="InkMuted" Color="#5A6978" />
        <SolidColorBrush x:Key="Accent" Color="#0B5E75" />
        <SolidColorBrush x:Key="Good" Color="#217A52" />
        <SolidColorBrush x:Key="Warning" Color="#A45D00" />
        <SolidColorBrush x:Key="Danger" Color="#B32D2E" />
        <SolidColorBrush x:Key="Offline" Color="#5D6875" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="PanelHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,11" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>

        <DataTemplate x:Key="NavigationItemTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="28" Height="22" CornerRadius="3"
                        Background="{DynamicResource SurfaceMuted}" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Freshness}" Style="{StaticResource MutedText}" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:OverviewPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource Panel}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="接入状态" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding DataContext.HealthLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,3" />
                                <TextBlock Text="{Binding DataContext.HealthDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="活动异常" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding DataContext.ActiveAlertCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,3" />
                                <TextBlock Text="需关注，不提供确认/关闭" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="VISIBLE Demand" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding DataContext.VisibleDemandCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,3" />
                                <TextBlock Text="权威投影当前窗口" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="最近链路耗时" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding DataContext.LatencyLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,3" />
                                <TextBlock Text="MES 数据年龄单独显示" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="当前需定位的问题" Style="{StaticResource PanelHeading}" />
                                <ItemsControl ItemsSource="{Binding DataContext.Alerts, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Severity}" FontWeight="Bold" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="查看证据" Click="OnAlertDetailsClick" Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding DataContext.EmptyStateText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="最近一轮四阶段链路" Style="{StaticResource PanelHeading}" />
                                <TextBlock Text="处理耗时，不含轮询等待；数值与颜色同时表达状态。"
                                           Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding DataContext.Stages, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="16" Maximum="100" Value="{Binding Percent}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding DataContext.AgeLatencySummary, RelativeSource={RelativeSource AncestorType=Window}}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DemandsPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <WrapPanel>
                        <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="105" SelectedIndex="0" Margin="0,0,12,0">
                            <ComboBoxItem Content="VISIBLE" />
                            <ComboBoxItem Content="GONE" />
                        </ComboBox>
                        <TextBlock Text="TASK_TYPE" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="130" Margin="0,0,12,0" />
                        <TextBlock Text="SUBLOT" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="120" Margin="0,0,12,0" />
                        <Button Content="提交查询" Style="{StaticResource PrimaryButton}" Click="OnRefreshClick" />
                        <Button Content="清除" />
                    </WrapPanel>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding DataContext.Demands, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DataContext.SelectedDemand, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="180" />
                        <DataGridTextColumn Header="TASK_TYPE" Binding="{Binding TaskType}" Width="130" />
                        <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="115" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85" />
                        <DataGridTextColumn Header="AREA / EQP" Binding="{Binding Location}" Width="150" />
                        <DataGridTextColumn Header="MES 数据年龄" Binding="{Binding DataAge}" Width="120" />
                        <DataGridTextColumn Header="最近见到" Binding="{Binding LastSeen}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="上一页" IsEnabled="False" />
                        <Button Content="下一页" Click="OnNextPageClick" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataContext.PageLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AlertsPage}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="活动 Alert（只读）" Style="{StaticResource PanelHeading}" />
                            <TextBlock Text="筛选、排序和游标分页均在 Host 端；选中后在右侧查看证据。"
                                       Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding DataContext.Alerts, RelativeSource={RelativeSource AncestorType=Window}}"
                                 SelectedItem="{Binding DataContext.SelectedAlert, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Severity}" FontWeight="Bold" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LastSeen}" Style="{StaticResource MutedText}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel DataContext="{Binding DataContext.SelectedAlert, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="Alert 证据" Style="{StaticResource PanelHeading}" />
                        <TextBlock Text="{Binding Code, TargetNullValue=请选择左侧 Alert}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8" />
                        <Separator Margin="0,8" />
                        <TextBlock Text="关联 Demand" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding DemandId, TargetNullValue=—}" FontFamily="Consolas" Margin="0,3,0,10" />
                        <TextBlock Text="首次 / 最近" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TimeRange, TargetNullValue=—}" Margin="0,3,0,10" />
                        <Button Content="转到关联 Demand" HorizontalAlignment="Left" />
                        <Button Content="复制诊断摘要" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="不提供确认、指派、备注或手工关闭。" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:PerformancePage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="4*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="24 小时端到端链路趋势（原型占位）" Style="{StaticResource PanelHeading}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="1h" />
                                <Button Content="24h" Style="{StaticResource PrimaryButton}" />
                                <Button Content="7d" />
                                <Button Content="30d" />
                            </StackPanel>
                        </DockPanel>
                        <Canvas Grid.Row="1" Background="#F7FAFC" Margin="0,8,0,0" ClipToBounds="True">
                            <Polyline Stroke="#0B5E75" StrokeThickness="3"
                                      Points="0,170 90,160 180,175 270,145 360,152 450,88 540,120 630,72 720,96 810,42 900,70 1020,58" />
                            <Polyline Stroke="#B32D2E" StrokeThickness="2" StrokeDashArray="5,3"
                                      Points="0,120 1020,120" />
                            <TextBlock Canvas.Left="12" Canvas.Top="12" Text="P95 2.84 s · Max 7.91 s · 阈值 3.00 s" FontWeight="SemiBold" />
                        </Canvas>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="选中轮次阶段瀑布" Style="{StaticResource PanelHeading}" />
                            <ItemsControl ItemsSource="{Binding DataContext.Stages, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" />
                                            <ProgressBar Grid.Column="1" Height="18" Maximum="100" Value="{Binding Percent}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="语义摘要" Style="{StaticResource PanelHeading}" />
                            <TextBlock Text="MES 读取占本轮 71%，超过该阶段 P95；本地投影正常。" TextWrapping="Wrap" />
                            <TextBlock Text="图表所有精确值同时出现在可键盘访问的表格中。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DiagnosticsPage}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="统一事件日志" Style="{StaticResource PanelHeading}" />
                        <ItemsControl ItemsSource="{Binding DataContext.Events, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="脱敏诊断包" Style="{StaticResource PanelHeading}" />
                        <CheckBox Content="Host 契约与版本" IsChecked="True" Margin="0,5" />
                        <CheckBox Content="最近 24 小时结构化遥测" IsChecked="True" Margin="0,5" />
                        <CheckBox Content="当前筛选和分页上下文" IsChecked="True" Margin="0,5" />
                        <CheckBox Content="Watch 本机事件（秘密脱敏）" IsChecked="True" Margin="0,5" />
                        <Button Content="生成诊断包（假动作）" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                        <TextBlock Text="不会导出连接字符串、凭据或任意原始 MES 数据。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SettingsPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="单 Host 连接" Style="{StaticResource PanelHeading}" />
                            <TextBlock Text="Host API 地址" Style="{StaticResource MutedText}" />
                            <TextBox Text="http://127.0.0.1:5080" Margin="0,5,0,12" />
                            <Button Content="测试只读连接" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="按页刷新" Style="{StaticResource PanelHeading}" />
                            <CheckBox Content="概览页自动刷新（30 秒）" Margin="0,5" />
                            <CheckBox Content="运输需求页自动刷新（关闭）" Margin="0,5" />
                            <CheckBox Content="告警分析页自动刷新（关闭）" Margin="0,5" />
                            <TextBlock Text="只刷新当前页；请求单飞、可取消、不排队。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="保留与容量" Style="{StaticResource PanelHeading}" />
                            <TextBlock Text="原始链路追踪 30 天 · 5 分钟聚合 365 天 · 本机事件 30 天" />
                            <TextBlock Text="正式规格将在遥测契约确定后固定物理 schema 与容量上限。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MesIngestWatch V2" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="THROWAWAY · 假数据 · 单 Host 只读运维台" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="场景" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox x:Name="ScenarioPicker" Width="145" Margin="0,0,12,0" SelectionChanged="OnScenarioChanged">
                        <ComboBoxItem Content="健康" Tag="Healthy" IsSelected="True" />
                        <ComboBoxItem Content="活动异常" Tag="Alert" />
                        <ComboBoxItem Content="慢链路" Tag="Slow" />
                        <ComboBoxItem Content="Host 离线" Tag="Offline" />
                        <ComboBoxItem Content="空状态" Tag="Empty" />
                        <ComboBoxItem Content="分页浏览" Tag="Paging" />
                    </ComboBox>
                    <CheckBox x:Name="AutoRefreshToggle" Content="当前页自动刷新" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" />
                    <Button x:Name="RefreshButton" Content="刷新当前页" Style="{StaticResource PrimaryButton}" Click="OnRefreshClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- A: balanced command board. Navigation + page are the primary hierarchy. -->
        <Grid x:Name="VariantA" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" x:Name="ADetailWidth" />
            </Grid.ColumnDefinitions>
            <Border Background="#E5EBF0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14" Background="#D9E4EA">
                        <StackPanel>
                            <TextBlock Text="方案 A" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="全局态势看板" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>
                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Navigation}"
                             ItemTemplate="{StaticResource NavigationItemTemplate}" SelectedItem="{Binding SelectedNavigation}" />
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding SelectedNavigation.Label}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedNavigation.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
                <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" />
            </Grid>
        </Grid>

        <!-- B: incident-first split. Persistent alert queue is the primary affordance. -->
        <Grid x:Name="VariantB" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="318" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#162B35" BorderBrush="#29414C" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12">
                        <StackPanel>
                            <TextBlock Text="方案 B" FontSize="16" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="事件处置优先" Foreground="#B9CBD3" />
                        </StackPanel>
                    </Border>
                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Navigation}"
                             ItemTemplate="{StaticResource NavigationItemTemplate}" SelectedItem="{Binding SelectedNavigation}" Foreground="White" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#FFF8EB" BorderBrush="#D5C49E" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="处置队列" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="只读定位，不在 Watch 内处置" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#D5C49E" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Severity}" FontWeight="Bold" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <Border DockPanel.Dock="Right" Background="#FFF0CF" BorderBrush="#D5C49E" BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <TextBlock Text="先选事件，再核对 Demand 与链路证据" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedNavigation.Label}" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedNavigation.Description}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </DockPanel>
                <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" />
            </Grid>
        </Grid>

        <!-- C: evidence timeline. Persistent chronology is the primary hierarchy. -->
        <Grid x:Name="VariantC" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border Background="#ECE9E2" BorderBrush="#C8C1B4" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14" Background="#DFD8CB">
                        <StackPanel>
                            <TextBlock Text="方案 C" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="证据时间线优先" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>
                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Navigation}"
                             ItemTemplate="{StaticResource NavigationItemTemplate}" SelectedItem="{Binding SelectedNavigation}" />
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding SelectedNavigation.Label}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedNavigation.Description}" Style="{StaticResource MutedText}" />
                </StackPanel>
                <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" />
            </Grid>
            <Border Grid.Column="2" Background="#FCFAF6" BorderBrush="#C8C1B4" BorderThickness="1,0,0,0" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="证据时间线" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="连接事件、IngestAlert 与 poll trace 分轨显示" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,12" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11" />
                                    <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Kind}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E7EDF2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="← / → 切换方案（输入框聚焦时不拦截）" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding RefreshStatus}" FontFamily="Consolas" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#111820" Padding="10" HorizontalAlignment="Center" CornerRadius="20" Margin="0,8,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="←" Click="OnPreviousVariantClick" Margin="0,0,8,0" AutomationProperties.Name="上一个原型方案" />
                <TextBlock x:Name="VariantLabel" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="190" TextAlignment="Center" />
                <Button Content="→" Click="OnNextVariantClick" Margin="8,0,0,0" AutomationProperties.Name="下一个原型方案" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
