<!--
  PROTOTYPE — throw away after review.
  Three visual redesigns plus two selected-design relationship states,
  switchable with variant A/B/C/D/E or the bottom prototype bar.

  Language rule:
  - Chinese: navigation, actions, explanations, operational conclusions.
  - English: entity names, schema fields, enum values, task types, alert codes.
  Never combine both languages into one slash-separated heading.
-->
<Window x:Class="MesIngest.Watch.Prototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MesIngest Watch 视觉原型"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#F5F7FA" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSubtle" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Line" Color="#E2E7EE" />
        <SolidColorBrush x:Key="LineStrong" Color="#C9D2DE" />
        <SolidColorBrush x:Key="Ink" Color="#152033" />
        <SolidColorBrush x:Key="InkSoft" Color="#4B5B70" />
        <SolidColorBrush x:Key="InkMuted" Color="#728096" />
        <SolidColorBrush x:Key="Blue" Color="#2563EB" />
        <SolidColorBrush x:Key="BlueSoft" Color="#EAF1FF" />
        <SolidColorBrush x:Key="Green" Color="#16845B" />
        <SolidColorBrush x:Key="GreenSoft" Color="#E9F7F1" />
        <SolidColorBrush x:Key="Amber" Color="#A45A00" />
        <SolidColorBrush x:Key="AmberSoft" Color="#FFF4DE" />
        <SolidColorBrush x:Key="Red" Color="#C43D4B" />
        <SolidColorBrush x:Key="RedSoft" Color="#FFF0F2" />
        <SolidColorBrush x:Key="Navy" Color="#14243B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="CodeValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Blue}" />
            <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="RefreshToggle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="#CBD5E1" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="3" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Blue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        </Style>

        <Style x:Key="Segment" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource Blue}" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{StaticResource Blue}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="RowBackground" Value="{StaticResource Surface}" />
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}" />
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TaskGrid">
            <DataGrid ItemsSource="{Binding DataContext.Tasks, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding DataContext.SelectedTask, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      AlternationCount="2"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TASK_TYPE" Binding="{Binding TaskType}" Width="185" />
                    <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="130" />
                    <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="82" />
                    <DataGridTextColumn Header="EQP" Binding="{Binding Eqp}" Width="98" />
                    <DataGridTextColumn Header="STEP" Binding="{Binding Step}" Width="110" />
                    <DataGridTextColumn Header="DATES" Binding="{Binding Dates}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <DataTemplate x:Key="InputFields">
            <Grid DataContext="{Binding DataContext.SelectedTask, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,12,13"><TextBlock Text="TASK_TYPE" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding TaskType}" Style="{StaticResource CodeValue}" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,0,13"><TextBlock Text="SUBLOT" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding Sublot}" Style="{StaticResource CodeValue}" /></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,12,13"><TextBlock Text="AREA" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding Area}" Style="{StaticResource CodeValue}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,13"><TextBlock Text="EQP" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding Eqp}" Style="{StaticResource CodeValue}" /></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,12,13"><TextBlock Text="STEP" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding Step}" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,13"><TextBlock Text="DATES" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding Dates}" Style="{StaticResource CodeValue}" /></StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2"><TextBlock Text="PACKAGE" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding Package}" Style="{StaticResource CodeValue}" TextWrapping="Wrap" /></StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootLayout" Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Blue}" Margin="0,0,12,0">
                        <TextBlock Text="MI" Foreground="White" FontFamily="Cascadia Mono" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="MesIngest Watch" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="只读接入运维台" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource GreenSoft}" CornerRadius="14" Padding="10,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,6,0" /><TextBlock Text="连接正常" Foreground="{StaticResource Green}" FontSize="12" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <CheckBox x:Name="AutoRefreshToggle" Content="自动刷新" Style="{StaticResource RefreshToggle}" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged" />
                    <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource PrimaryButton}" Click="OnRefreshClick" />
                    <StackPanel x:Name="PrototypeControls" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="评审数据" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedText}" />
                        <ComboBox x:Name="ScenarioPicker" Width="128" SelectionChanged="OnScenarioChanged">
                            <ComboBoxItem Content="当前异常" Tag="Active" IsSelected="True" />
                            <ComboBoxItem Content="健康" Tag="Healthy" />
                            <ComboBoxItem Content="连接中断" Tag="Offline" />
                            <ComboBoxItem Content="无结果" Tag="Empty" />
                            <ComboBoxItem Content="分页浏览" Tag="Paging" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- A — Explainable operations workbench: navigation + list + inspector. -->
        <Grid x:Name="VariantA" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="194" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Navy}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,18">
                        <Border Background="#20344F" CornerRadius="8" Padding="12">
                            <StackPanel><TextBlock Text="只读模式" Foreground="#AFC3DC" FontSize="11" /><TextBlock Text="不会修改业务数据" Foreground="White" Margin="0,4,0,0" /></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="12,22,12,0">
                        <TextBlock Text="工作区" Foreground="#7790AE" FontSize="11" Margin="10,0,0,10" />
                        <Border CornerRadius="7" Padding="11,9" Margin="0,2"><TextBlock Text="概览" Foreground="#BFCDE0" /></Border>
                        <Border Background="#29466C" CornerRadius="7" Padding="11,9" Margin="0,2"><StackPanel><TextBlock Text="任务浏览" Foreground="White" FontWeight="SemiBold" /><TextBlock Text="TransportDemand" Foreground="#9FC2F9" FontFamily="Cascadia Mono" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border>
                        <Border CornerRadius="7" Padding="11,9" Margin="0,2"><StackPanel><TextBlock Text="接入告警" Foreground="#BFCDE0" /><TextBlock Text="IngestAlert" Foreground="#7790AE" FontFamily="Cascadia Mono" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border>
                        <Border CornerRadius="7" Padding="11,9" Margin="0,2"><TextBlock Text="设置" Foreground="#BFCDE0" /></Border>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="24,18,20,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="TRANSPORTDEMAND" Style="{StaticResource Eyebrow}" /><TextBlock Text="任务浏览" Style="{StaticResource PageTitle}" Margin="0,3,0,0" /><TextBlock Text="查看输入快照与本地投影。此页面仅提供只读查询。" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="数据时间" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" /><TextBlock Text="2026-08-08 09:30:00" Style="{StaticResource CodeValue}" Margin="0,4,0,0" /></StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,16,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><ToggleButton Content="VISIBLE" Style="{StaticResource Segment}" IsChecked="True" /><ToggleButton Content="GONE" Style="{StaticResource Segment}" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="任务类型" Style="{StaticResource MutedText}" FontSize="10" /><TextBlock Text="全部" VerticalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="3" Margin="12,0,0,0"><TextBlock Text="子批次" Style="{StaticResource MutedText}" FontSize="10" /><TextBlock Text="不限" VerticalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                        <TextBlock Grid.Column="4" Text="筛选条件作用于当前状态，不会改变其它视图。" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal"><Button Content="重置" Margin="0,0,8,0" /><Button Content="查询" Style="{StaticResource PrimaryButton}" /></StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel Margin="14,12"><TextBlock DockPanel.Dock="Right" Text="8 条结果" Style="{StaticResource MutedText}" /><TextBlock Text="查询结果" Style="{StaticResource SectionTitle}" /></DockPanel>
                            <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" ContentTemplate="{StaticResource TaskGrid}" />
                            <DockPanel Grid.Row="2" Margin="14,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" Margin="0,0,8,0" /><Button Content="下一页" /></StackPanel><TextBlock Text="第 1 页 · 每页 100 条" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></DockPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="字段解释" Style="{StaticResource SectionTitle}" /><TextBlock Text="同一条记录由两层数据组成。字段保持原始名称，解释使用中文。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,16" />
                            <TextBlock Text="MES INPUT" Style="{StaticResource Eyebrow}" /><TextBlock Text="输入字段" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,13" />
                            <ContentControl Content="{Binding SelectedPage}" ContentTemplate="{StaticResource InputFields}" />
                            <Separator Margin="0,18" Background="{StaticResource Line}" />
                            <TextBlock Text="LOCAL PROJECTION" Style="{StaticResource Eyebrow}" /><TextBlock Text="本地投影" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,13" />
                            <StackPanel DataContext="{Binding SelectedTask}"><TextBlock Text="DemandId" Style="{StaticResource FieldKey}" /><TextBlock Text="{Binding DemandId}" Style="{StaticResource CodeValue}" /><TextBlock Text="STATUS" Style="{StaticResource FieldKey}" Margin="0,13,0,3" /><TextBlock Text="{Binding Status}" Style="{StaticResource CodeValue}" /></StackPanel>
                            <Border Background="{StaticResource BlueSoft}" CornerRadius="7" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="为什么分成两层？" FontWeight="SemiBold" /><TextBlock Text="输入字段描述源数据；本地投影负责稳定标识、可见状态与生命周期。" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource InkSoft}" /></StackPanel></Border>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- B — Relationship explainer: concept rail + wide list + selected record narrative. -->
        <Grid x:Name="VariantB" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="{StaticResource Navy}" Padding="20,0">
                <DockPanel><TextBlock DockPanel.Dock="Left" Text="关系解释器" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,28,0" /><StackPanel Orientation="Horizontal"><TextBlock Text="概览" Foreground="#9FB0C8" VerticalAlignment="Center" Margin="0,0,28,0" /><StackPanel VerticalAlignment="Center" Margin="0,0,28,0"><TextBlock Text="任务浏览" Foreground="White" FontWeight="SemiBold" /><Border Height="2" Background="#61A0FF" Margin="0,5,0,0" /></StackPanel><TextBlock Text="接入告警" Foreground="#9FB0C8" VerticalAlignment="Center" Margin="0,0,28,0" /><TextBlock Text="设置" Foreground="#9FB0C8" VerticalAlignment="Center" /></StackPanel></DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel><TextBlock Text="HOW TO READ" Style="{StaticResource Eyebrow}" /><TextBlock Text="如何理解一条任务" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,18" />
                        <Border Background="{StaticResource BlueSoft}" CornerRadius="8" Padding="12"><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Blue}" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="查看来源字段" FontWeight="SemiBold" Margin="0,9,0,4" /><TextBlock Text="先确认设备、区域、工序和进入时间。" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" /><TextBlock Text="MES INPUT" Style="{StaticResource FieldKey}" Margin="0,10,0,0" /></StackPanel></Border>
                        <TextBlock Text="↓" FontSize="22" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center" Margin="0,5" />
