                    <StackPanel Margin="12,22,12,0"><TextBlock Text="工作区" Foreground="#7790AE" FontSize="11" Margin="10,0,0,10" /><Border CornerRadius="7" Padding="11,9" Margin="0,2"><TextBlock Text="概览" Foreground="#BFCDE0" /></Border><Border CornerRadius="7" Padding="11,9" Margin="0,2"><StackPanel><TextBlock Text="任务浏览" Foreground="#BFCDE0" /><TextBlock Text="TransportDemand" Foreground="#7790AE" FontFamily="Cascadia Mono" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border><Border Background="#29466C" CornerRadius="7" Padding="11,9" Margin="0,2"><StackPanel><TextBlock Text="接入告警" Foreground="White" FontWeight="SemiBold" /><TextBlock Text="IngestAlert" Foreground="#9FC2F9" FontFamily="Cascadia Mono" FontSize="10" Margin="0,3,0,0" /></StackPanel></Border><Border CornerRadius="7" Padding="11,9" Margin="0,2"><TextBlock Text="设置" Foreground="#BFCDE0" /></Border></StackPanel>
