                    <TextBlock Text="SEVERITY" Style="{StaticResource FieldKey}" /><Border Height="36" Background="White" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="10,0" Margin="0,5,0,12"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" /><TextBlock Text="ALL" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /></DockPanel></Border>
                    <TextBlock Text="CODE" Style="{StaticResource FieldKey}" /><Border Height="36" Background="White" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="10,0" Margin="0,5,0,12"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" /><TextBlock Text="REAPPEAR_AFTER_GONE" FontFamily="Cascadia Mono" FontSize="10" VerticalAlignment="Center" /></DockPanel></Border>
