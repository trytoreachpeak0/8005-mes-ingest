                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="205" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions><TextBlock Text="ERROR" Foreground="{StaticResource Red}" FontFamily="Cascadia Mono" Margin="10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="DUPLICATE_RECONCILE_KEY" FontFamily="Cascadia Mono" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="BusinessKey" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="DIE_TO_WIRE_STAGING" FontFamily="Cascadia Mono" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="4" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /></Grid>
                    <Grid Grid.Row="3" Background="#FBFCFE"><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="205" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions><TextBlock Text="ERROR" Foreground="{StaticResource Red}" FontFamily="Cascadia Mono" Margin="10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="PAUSED_ZERO_DROP" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="TaskType" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="STAGING_TO_WIRE" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="2" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /></Grid>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="205" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions><TextBlock Text="ERROR" Foreground="{StaticResource Red}" FontFamily="Cascadia Mono" Margin="10,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="POLL_FAILURE" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="Global" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="—" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="3" Style="{StaticResource CodeValue}" VerticalAlignment="Center" /></Grid>
                    <DockPanel Grid.Row="6" Margin="12,7"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一页" Padding="10,4" MinHeight="26" Margin="0,0,7,0" /><Button Content="下一页" Padding="10,4" MinHeight="26" /></StackPanel><TextBlock Text="第 1 页 · 每页 100 条" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></DockPanel>
                </Grid></Border>
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="285" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="SELECTED" Style="{StaticResource Eyebrow}" /><TextBlock Text="当前告警" Style="{StaticResource SectionTitle}" Margin="0,4,0,10" /><TextBlock Text="REAPPEAR_AFTER_GONE" Foreground="{StaticResource Amber}" FontFamily="Cascadia Mono" FontWeight="SemiBold" /><TextBlock Text="同一业务键在 GONE 后再次出现，系统创建了新的 DemandId。" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,7,18,0" /><Border Background="{StaticResource BlueSoft}" CornerRadius="7" Padding="10" Margin="0,13,18,0"><TextBlock Text="找到 2 个精确任务目标" Foreground="{StaticResource Blue}" FontWeight="SemiBold" /></Border></StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource Line}" />
                    <Grid Grid.Column="2" Margin="18,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel><TextBlock DockPanel.Dock="Right" Text="TransportDemand" Style="{StaticResource Eyebrow}" /><TextBlock Text="相关任务" Style="{StaticResource SectionTitle}" /></DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceSubtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,10,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PREVIOUS" Style="{StaticResource FieldKey}" /><TextBlock Text="先前 GONE" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DemandId" Style="{StaticResource FieldKey}" /><TextBlock Text="dmd-old-116a" Style="{StaticResource CodeValue}" /></StackPanel><Button Grid.Column="2" Content="精确查看" Padding="10,5" /></Grid></Border>
                        <Border Grid.Row="2" Background="{StaticResource GreenSoft}" BorderBrush="#B9E2D1" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NEW" Style="{StaticResource FieldKey}" /><TextBlock Text="当前再现" Foreground="{StaticResource Green}" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DemandId" Style="{StaticResource FieldKey}" /><TextBlock Text="dmd-2a10bd44" Style="{StaticResource CodeValue}" /></StackPanel><Button Grid.Column="2" Content="精确查看" Style="{StaticResource PrimaryButton}" Padding="10,5" /></Grid></Border>
