                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IngestAlert" Style="{StaticResource Eyebrow}" /><TextBlock Text="接入告警" Style="{StaticResource PageTitle}" Margin="0,2,0,0" /><TextBlock Text="选中告警后，区分精确目标、业务键范围与不可定位范围。" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Background="{StaticResource RedSoft}" CornerRadius="8" Padding="11,7" VerticalAlignment="Bottom"><TextBlock Text="6 条活动告警" Foreground="{StaticResource Red}" FontWeight="SemiBold" /></Border></Grid>
