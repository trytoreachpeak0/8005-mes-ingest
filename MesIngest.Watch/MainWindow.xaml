                        <Border x:Name="AlertResultBadge" Grid.Column="1" Background="{StaticResource WatchErrorSoftBrush}" CornerRadius="8" Padding="11,7" VerticalAlignment="Bottom">
                            <TextBlock x:Name="AlertResultBadgeText" Text="0 条活动告警" Foreground="{StaticResource WatchErrorBrush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="AlertCountText" AutomationProperties.Name="IngestAlert 查询结果摘要" Visibility="Collapsed" />
                    </Grid>
                    <DataGrid x:Name="AlertsGrid"
                              AutomationProperties.Name="IngestAlert 单页结果"
                              Grid.Row="1"
                              Grid.Column="2"
                              Margin="0,13,20,52"
                              BorderThickness="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              HorizontalScrollBarVisibility="Auto"
                              HeadersVisibility="Column"
                              SelectionChanged="OnAlertSelectionChanged"
                              Sorting="OnAlertsSorting"
                              MouseDoubleClick="OnAlertsDoubleClick"
                              PreviewKeyDown="OnAlertsPreviewKeyDown"
                              PreviewMouseRightButtonDown="OnAlertsPreviewMouseRightButtonDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AlertId}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SEVERITY" AutomationProperties.Name="IngestAlert Severity 列" SortMemberPath="Severity" Width="82" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Severity}" FontFamily="Cascadia Mono">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WatchErrorBrush}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Severity}" Value="WARNING"><Setter Property="Foreground" Value="{StaticResource WatchWarningBrush}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CODE" AutomationProperties.Name="IngestAlert Code 列" SortMemberPath="Code" Width="205" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Click="OnAlertViewDetailsClick"
                                                AutomationProperties.AutomationId="AlertDetailsButton"
                                                AutomationProperties.Name="{Binding Code}"
                                                ToolTip="查看 Alert 详情"
                                                Cursor="Hand"
                                                Focusable="False"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Foreground="{StaticResource WatchTextBrush}"
                                                HorizontalContentAlignment="Left">
                                            <TextBlock Text="{Binding Code}" />
                                        </ui:Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SCOPE" AutomationProperties.Name="IngestAlert 关联范围列" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Cascadia Mono" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Global" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Code}" Value="FIELD_DRIFT"><Setter Property="Text" Value="Demand" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Code}" Value="REAPPEAR_AFTER_GONE"><Setter Property="Text" Value="Demand" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Code}" Value="DUPLICATE_RECONCILE_KEY"><Setter Property="Text" Value="BusinessKey" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Code}" Value="PAUSED_ZERO_DROP"><Setter Property="Text" Value="TaskType" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TASK_TYPE" AutomationProperties.Name="IngestAlert TASK_TYPE 列" Binding="{Binding TaskType}" Width="*" CanUserSort="True" />
                            <DataGridTextColumn Header="COUNT" AutomationProperties.Name="IngestAlert OccurrenceCount 列" Binding="{Binding OccurrenceCount}" Width="92" CanUserSort="False" />
                            <DataGridTextColumn Header="AlertId" AutomationProperties.Name="IngestAlert AlertId 列" Binding="{Binding AlertId}" Width="180" CanUserSort="True" Visibility="Collapsed" />
                            <DataGridTextColumn Header="last seen" AutomationProperties.Name="IngestAlert LastSeenAt 列" Binding="{Binding LastSeenAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" Visibility="Collapsed" />
                            <DataGridTextColumn Header="first seen" AutomationProperties.Name="IngestAlert FirstSeenAt 列" Binding="{Binding FirstSeenAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" Visibility="Collapsed" />
                            <DataGridTextColumn Header="SUBLOT" AutomationProperties.Name="IngestAlert SUBLOT 列" Binding="{Binding Sublot}" Width="130" CanUserSort="True" Visibility="Collapsed" />
                            <DataGridTextColumn Header="DemandId" AutomationProperties.Name="IngestAlert DemandId 列" Binding="{Binding DemandId}" Width="200" CanUserSort="True" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Message" AutomationProperties.Name="IngestAlert Message 列" Binding="{Binding Message}" Width="260" CanUserSort="True" Visibility="Collapsed" />
                            <DataGridTextColumn Header="IsActive" AutomationProperties.Name="IngestAlert IsActive 列" Binding="{Binding IsActive}" Width="90" CanUserSort="False" Visibility="Collapsed" />
                            <DataGridTextColumn Header="ResolvedAt" AutomationProperties.Name="IngestAlert ResolvedAt 列" Binding="{Binding ResolvedAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="False" Visibility="Collapsed" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="查看详情" AutomationProperties.Name="查看所选 IngestAlert 详情" Click="OnAlertViewDetailsMenu" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <Border x:Name="AlertRelationshipPanel" Grid.Row="2" Grid.Column="2" Margin="0,0,20,13" Background="{StaticResource WatchSurfaceBrush}" BorderBrush="{StaticResource WatchBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" AutomationProperties.Name="IngestAlert 关联 TransportDemand">
                        <Grid>
                            <TextBlock x:Name="AlertRelationshipPlaceholder" Text="选择一条 IngestAlert，查看它能否关联 TransportDemand。" Foreground="{StaticResource WatchMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid x:Name="AlertRelationshipContent" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="285" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SELECTED" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="当前告警" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,10" />
                                    <TextBlock x:Name="AlertRelationshipCodeText" FontFamily="Cascadia Mono" FontWeight="SemiBold" Foreground="{StaticResource WatchWarningBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="AlertRelationshipMessageText" Foreground="{StaticResource WatchSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,18,0" />
                                    <Border Background="{StaticResource WatchAccentSoftBrush}" CornerRadius="7" Padding="10" Margin="0,13,18,0"><StackPanel><TextBlock x:Name="AlertRelationshipScopeText" AutomationProperties.Name="IngestAlert 关联范围类型" Style="{StaticResource FilterFieldLabel}" /><TextBlock x:Name="AlertRelationshipValueText" AutomationProperties.Name="IngestAlert 关联范围值" FontFamily="Cascadia Mono" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock x:Name="AlertRelationshipHeadingText" AutomationProperties.Name="IngestAlert 关联范围结论" Foreground="{StaticResource WatchAccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel></Border>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource WatchBorderBrush}" />
                                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="TransportDemand" Style="{StaticResource EyebrowText}" /><TextBlock Text="相关任务" FontSize="16" FontWeight="SemiBold" /></DockPanel>
                                    <TextBlock x:Name="AlertRelationshipExplanationText" Foreground="{StaticResource WatchMutedTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <Border x:Name="AlertTargetOnePanel" Background="#F8FAFC" BorderBrush="{StaticResource WatchBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4,0,5" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock x:Name="AlertTargetOneRoleText" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="AlertTargetOneIdText" Grid.Column="1" FontFamily="Cascadia Mono" VerticalAlignment="Center" /><ui:Button x:Name="AlertTargetOneButton" AutomationProperties.AutomationId="AlertTargetOneButton" AutomationProperties.Name="精确查看第一个关联 TransportDemand" Grid.Column="2" Content="精确查看" Padding="9,4" Click="OnAlertTargetOneClick" /></Grid></Border>
                                    <Border x:Name="AlertTargetTwoPanel" Background="{StaticResource WatchSuccessSoftBrush}" BorderBrush="{StaticResource WatchSuccessBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,5" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock x:Name="AlertTargetTwoRoleText" Foreground="{StaticResource WatchSuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="AlertTargetTwoIdText" Grid.Column="1" FontFamily="Cascadia Mono" VerticalAlignment="Center" /><ui:Button x:Name="AlertTargetTwoButton" Style="{StaticResource PrimaryActionButton}" AutomationProperties.AutomationId="AlertTargetTwoButton" AutomationProperties.Name="精确查看第二个关联 TransportDemand" Grid.Column="2" Content="精确查看" Padding="9,4" Click="OnAlertTargetTwoClick" /></Grid></Border>
                                    <ui:Button x:Name="AlertBusinessKeyButton" AutomationProperties.AutomationId="AlertBusinessKeyButton" AutomationProperties.Name="按业务键查 TransportDemand" Content="按业务键查任务" HorizontalAlignment="Left" Padding="12,5" Visibility="Collapsed" Click="OnAlertBusinessKeyClick" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="1" Grid.Column="2" Margin="12,0,32,16" VerticalAlignment="Bottom">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button x:Name="AlertPreviousButton" AutomationProperties.Name="IngestAlert 上一页" Content="上一页" Padding="14,4" IsEnabled="False" Click="OnAlertPreviousClick" />
                            <TextBlock x:Name="AlertPageText" Text="第 1 页" Margin="14,5" VerticalAlignment="Center" />
                            <ui:Button x:Name="AlertNextButton" AutomationProperties.Name="IngestAlert 下一页" Content="下一页" Padding="14,4" IsEnabled="False" Click="OnAlertNextClick" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </DockPanel>

