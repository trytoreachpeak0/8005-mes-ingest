                        <StackPanel>
                            <TextBlock Text="IngestAlert" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="接入告警" Style="{StaticResource PageTitleText}" Margin="0,2,0,0" />
                            <TextBlock Text="选中告警后，区分精确目标、业务键范围与不可定位范围。" Foreground="{StaticResource WatchMutedTextBrush}" Margin="0,4,0,0" />
