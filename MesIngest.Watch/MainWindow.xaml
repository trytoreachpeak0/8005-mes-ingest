<Window x:Class="MesIngest.Watch.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MesIngest.Watch"
        Title="MesIngest Watch"
        Height="720"
        Width="1180"
        MinHeight="600"
        MinWidth="720"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WatchBackgroundBrush}"
        AutomationProperties.Name="MesIngestWatch 主窗口"
        KeyboardNavigation.TabNavigation="Continue">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:WatchThemeDictionary />
            </ResourceDictionary.MergedDictionaries>
        <local:LocalDateTimeOffsetConverter x:Key="LocalTime" />
        <DataTemplate x:Key="DemandDetailFieldTemplate">
            <Grid Margin="0,2,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontFamily="Consolas"
                           FontWeight="SemiBold" />
                <TextBox Grid.Column="1"
                         Text="{Binding Value, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{Binding Name}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Explanation}"
                           Foreground="{StaticResource WatchMutedTextBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <Style x:Key="DemandStatusTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource WatchSecondaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource WatchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WatchBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="SegmentBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource WatchAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{StaticResource WatchAccentBrush}" />
                                <Setter TargetName="SegmentBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource WatchAccentBrush}" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{StaticResource WatchAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryNavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource WatchNavigationTextBrush}" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <TextBlock x:Name="NavPrimaryText" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="NavSecondaryText" Visibility="Collapsed" Foreground="#9FC2F9" FontFamily="Cascadia Mono" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Demand"><Setter TargetName="NavPrimaryText" Property="Text" Value="任务浏览" /><Setter TargetName="NavPrimaryText" Property="FontWeight" Value="SemiBold" /><Setter TargetName="NavSecondaryText" Property="Text" Value="TransportDemand" /><Setter TargetName="NavSecondaryText" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="Tag" Value="Alert"><Setter TargetName="NavPrimaryText" Property="Text" Value="接入告警" /><Setter TargetName="NavPrimaryText" Property="FontWeight" Value="SemiBold" /><Setter TargetName="NavSecondaryText" Property="Text" Value="IngestAlert" /><Setter TargetName="NavSecondaryText" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#20344F" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource WatchNavigationSelectedBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WatchAccentBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FilterFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WatchMutedTextBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource WatchTextBrush}" />
            <Setter Property="Background" Value="{StaticResource WatchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WatchStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource WatchAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WatchAccentBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="{StaticResource WatchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WatchStrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource WatchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WatchStrongBorderBrush}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource WatchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WatchBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource WatchBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource WatchMutedTextBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="BorderBrush" Value="{StaticResource WatchBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource WatchAccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource WatchTextBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource WatchAccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource WatchTextBrush}" /></Trigger></Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="194" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource WatchNavigationBrush}" Padding="12">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="#20344F" CornerRadius="8" Padding="12" Margin="2,0,2,6">
                    <StackPanel><TextBlock Text="只读模式" Foreground="#AFC3DC" FontSize="11" /><TextBlock Text="不会修改业务数据" Foreground="White" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="10,10,4,18">
                    <TextBlock Text="MesIngest Watch" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="只读接入运维台" Margin="0,4,0,0" Foreground="{StaticResource WatchNavigationMutedBrush}" />
                </StackPanel>
                <ListBox x:Name="PrimaryNavigation"
                         AutomationProperties.Name="主导航"
                         SelectedIndex="0"
                         SelectionChanged="OnPrimaryNavigationChanged"
                         ItemContainerStyle="{StaticResource PrimaryNavigationItemStyle}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBoxItem Content="概览" AutomationProperties.Name="概览导航" />
                    <ListBoxItem Content="MES 任务 / TransportDemand" Tag="Demand" AutomationProperties.Name="TransportDemand 导航" />
                    <ListBoxItem Content="IngestAlert" Tag="Alert" AutomationProperties.Name="IngestAlert 导航" />
                    <ListBoxItem Content="设置" AutomationProperties.Name="设置导航" />
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="12,0,12,8">
                <Border Padding="10,6" Background="{StaticResource WatchSurfaceBrush}" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="CurrentHostContextText"
                                   AutomationProperties.Name="当前 Host 基址"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PageRefreshContextText"
                                   AutomationProperties.Name="当前视图刷新上下文"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource WatchSecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border x:Name="ErrorBanner" Background="{StaticResource WatchErrorBrush}" Padding="10,8" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorBannerText" AutomationProperties.Name="连接错误" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14" />
                </Border>
                <Border x:Name="WarningBanner" Background="{StaticResource WatchWarningBrush}" Padding="10,8" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WarningBannerText" AutomationProperties.Name="连接警告" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14" />
                </Border>
            </StackPanel>

            <Grid x:Name="OverviewPage" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel x:Name="OverviewHeaderPanel" Margin="12,8,12,12">
                    <StackPanel MinWidth="320" Margin="0,0,24,8">
                        <TextBlock Text="概览" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverviewConclusionText"
                                   AutomationProperties.Name="概览健康结论"
                                   Margin="0,8,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="○ 正在连接" />
                        <TextBlock x:Name="OverviewBusyText"
                                   AutomationProperties.Name="概览刷新状态"
                                   Margin="0,4,0,0"
                                   Text="正在刷新三个概览资源，可取消"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="OverviewNoticeText"
                                   AutomationProperties.Name="概览刷新提示"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource WatchMutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,8">
                        <CheckBox x:Name="OverviewAutoRefreshCheckBox"
                                  Tag="{x:Static local:WatchRefreshView.Overview}"
                                  Content="自动刷新"
                                  AutomationProperties.Name="概览自动刷新"
                                  VerticalAlignment="Center"
                                  Checked="OnAutoRefreshEnabledChanged"
                                  Unchecked="OnAutoRefreshEnabledChanged" />
                        <ComboBox x:Name="OverviewAutoRefreshInterval"
                                  Tag="{x:Static local:WatchRefreshView.Overview}"
                                  Width="78"
                                  Margin="8,0,8,0"
                                  AutomationProperties.Name="概览自动刷新间隔"
                                  SelectionChanged="OnAutoRefreshIntervalChanged" />
                        <Button x:Name="OverviewRefreshButton"
                                AutomationProperties.Name="刷新概览"
                                Content="刷新"
                                Padding="16,7"
                                Click="OnOverviewRefreshClick" />
                        <Button x:Name="OverviewCancelButton"
                                AutomationProperties.Name="取消概览刷新"
                                Content="取消"
                                Margin="8,0,0,0"
                                Padding="16,7"
                                IsEnabled="False"
                                Click="OnOverviewCancelClick" />
                    </StackPanel>
                </WrapPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <Border Margin="6" Padding="16" BorderBrush="{StaticResource WatchBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Host 接入状态" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="OverviewHostText"
                                           AutomationProperties.Name="Host 接入状态"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="16" BorderBrush="{StaticResource WatchBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="最近轮询健康" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="OverviewPollHealthText"
                                           AutomationProperties.Name="最近轮询健康"
                                           Margin="0,8,0,0"
                                           Text="尚无成功轮询"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="OverviewAlertsButton"
                                AutomationProperties.Name="查看活动 IngestAlert 默认查询"
                                Margin="6"
                                Padding="16"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="White"
                                BorderBrush="{StaticResource WatchBorderBrush}"
                                Click="OnOverviewAlertsClick">
                            <StackPanel>
                                <TextBlock Text="活动 IngestAlert" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="OverviewAlertText"
                                           Margin="0,8,0,0"
                                           Text="活动告警：0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="进入活动告警默认查询 →" Margin="0,12,0,0" Foreground="{StaticResource WatchAccentBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OverviewDemandsButton"
                                AutomationProperties.Name="查看 VISIBLE TransportDemand 默认查询"
                                Margin="6"
                                Padding="16"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="White"
                                BorderBrush="{StaticResource WatchBorderBrush}"
                                Click="OnOverviewDemandsClick">
                            <StackPanel>
                                <TextBlock Text="VISIBLE TransportDemand" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="OverviewDemandText"
                                           Margin="0,8,0,0"
                                           Text="VISIBLE TransportDemand：0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="进入 VISIBLE 默认查询 →" Margin="0,12,0,0" Foreground="{StaticResource WatchAccentBrush}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </ScrollViewer>
            </Grid>

            <DockPanel x:Name="AlertsPage" Grid.Row="1" Visibility="Collapsed" Margin="20,12,20,12">
                <WrapPanel x:Name="AlertHeaderPanel" DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel MinWidth="320" Margin="0,0,24,8">
                        <TextBlock Text="IngestAlert" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="接入告警" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <TextBlock Text="选中告警后，区分精确目标、业务键范围与不可定位范围。"
                                   Foreground="{StaticResource WatchMutedTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <CheckBox x:Name="AlertAutoRefreshCheckBox"
                                  Tag="{x:Static local:WatchRefreshView.Alerts}"
                                  Content="自动刷新"
                                  AutomationProperties.Name="IngestAlert 自动刷新"
                                  VerticalAlignment="Center"
                                  Checked="OnAutoRefreshEnabledChanged"
                                  Unchecked="OnAutoRefreshEnabledChanged" />
                        <ComboBox x:Name="AlertAutoRefreshInterval"
                                  Tag="{x:Static local:WatchRefreshView.Alerts}"
                                  Width="78"
                                  Margin="8,0,8,0"
                                  AutomationProperties.Name="IngestAlert 自动刷新间隔"
                                  SelectionChanged="OnAutoRefreshIntervalChanged" />
                        <Button x:Name="AlertRefreshButton" Style="{StaticResource PrimaryActionButton}" AutomationProperties.Name="刷新 IngestAlert 当前页" Content="刷新当前页" Padding="12,5" Click="OnAlertRefreshClick" />
                        <Button x:Name="AlertCancelButton" AutomationProperties.Name="取消 IngestAlert 刷新" Content="取消" Margin="8,0,0,0" Padding="12,5" IsEnabled="False" Click="OnAlertCancelClick" />
                    </StackPanel>
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="230" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Background="{StaticResource WatchFilterBrush}" BorderBrush="{StaticResource WatchBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <ScrollViewer x:Name="AlertFiltersScrollViewer"
                                      AutomationProperties.AutomationId="AlertFiltersScrollViewer"
                                      AutomationProperties.Name="IngestAlert 筛选条件"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16">
                        <StackPanel>
                            <TextBlock Text="FILTERS" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="筛选条件" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,3" />
                            <TextBlock Text="条件只作用于告警列表。" Foreground="{StaticResource WatchMutedTextBrush}" Margin="0,0,0,18" />
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="生命周期" Foreground="{StaticResource WatchMutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="AlertActivityFilter" AutomationProperties.Name="IngestAlert 状态筛选" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="CODE" Style="{StaticResource FilterFieldLabel}" />
                                    <ComboBox x:Name="AlertCodeFilter" AutomationProperties.Name="IngestAlert Code 筛选" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="SEVERITY" Style="{StaticResource FilterFieldLabel}" />
                                    <ComboBox x:Name="AlertSeverityFilter" AutomationProperties.Name="IngestAlert Severity 筛选" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="LastSeenAt" Style="{StaticResource FilterFieldLabel}" />
                                    <TextBlock Text="起始时间（含时区）" Foreground="{StaticResource WatchMutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                    <TextBox x:Name="AlertRangeFromFilter" AutomationProperties.Name="IngestAlert LastSeenAt 起始" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Text="结束时间（含时区）" Foreground="{StaticResource WatchMutedTextBrush}" FontSize="11" />
                                    <TextBox x:Name="AlertRangeToFilter" AutomationProperties.Name="IngestAlert LastSeenAt 结束" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <Button x:Name="AlertQueryButton" Style="{StaticResource PrimaryActionButton}" AutomationProperties.Name="查询 IngestAlert" Content="应用条件" Padding="16,7" Click="OnAlertQueryClick" />
                                    <Button x:Name="AlertResetButton" AutomationProperties.Name="重置 IngestAlert 查询" Content="清空条件" Margin="0,8,0,0" Padding="16,7" Click="OnAlertResetClick" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="AlertValidationText" AutomationProperties.Name="IngestAlert 查询校验" Foreground="{StaticResource WatchErrorBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="AlertCommittedQueryText" AutomationProperties.Name="IngestAlert 已提交查询" Margin="0,12,0,0" Foreground="{StaticResource WatchSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock x:Name="AlertBusyText" Text="正在刷新，保留上次成功窗口" Visibility="Collapsed" />
                                <TextBlock x:Name="AlertNoticeText" AutomationProperties.Name="IngestAlert 刷新提示" Foreground="{StaticResource WatchMutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
