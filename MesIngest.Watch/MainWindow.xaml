                                <StackPanel>
                                    <ui:Button x:Name="DemandQueryButton" Style="{StaticResource PrimaryActionButton}" AutomationProperties.Name="查询 TransportDemand" Content="应用条件" Padding="16,7" Click="OnDemandQueryClick" />
                                    <ui:Button x:Name="DemandResetButton" AutomationProperties.Name="重置 TransportDemand 查询" Content="清空条件" Margin="0,8,0,0" Padding="16,7" Click="OnDemandResetClick" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="DemandValidationText" AutomationProperties.Name="TransportDemand 查询校验" Foreground="{StaticResource WatchErrorBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DemandCommittedQueryText" AutomationProperties.Name="TransportDemand 已提交查询" Visibility="Collapsed" />
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock x:Name="DemandBusyText" Text="正在刷新，保留上次成功窗口" Visibility="Collapsed" />
                                <TextBlock x:Name="DemandNoticeText" AutomationProperties.Name="TransportDemand 刷新提示" Foreground="{StaticResource WatchMutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button x:Name="DemandViewDetailsButton"
                                    Content="查看详情"
                                    AutomationProperties.Name="查看所选 TransportDemand 详情"
                                    IsEnabled="False"
                                    Visibility="Collapsed"
                                    Click="OnDemandViewDetailsClick" />
                            <Border Background="{StaticResource WatchAccentSoftBrush}" CornerRadius="8" Padding="11" Margin="0,17,0,0">
                                <StackPanel>
                                    <TextBlock Text="关联规则" FontWeight="SemiBold" />
                                    <TextBlock Text="相关告警按精确标识或业务键匹配；全局与任务类型告警不会伪装成精确关联。" Foreground="{StaticResource WatchSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <DockPanel x:Name="DemandWorkspace" Margin="20,15,20,13">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="TransportDemand" Style="{StaticResource EyebrowText}" /><TextBlock Text="任务浏览" Style="{StaticResource PageTitleText}" Margin="0,2,0,0" /><TextBlock Text="选中任务后，查看与它有关的接入告警及关联依据。" Foreground="{StaticResource WatchMutedTextBrush}" Margin="0,4,0,0" /></StackPanel>
                        <Border x:Name="DemandResultBadge" Grid.Column="1" Background="{StaticResource WatchSuccessSoftBrush}" CornerRadius="8" Padding="11,7" VerticalAlignment="Bottom"><TextBlock x:Name="DemandResultBadgeText" Text="0 条结果" Foreground="{StaticResource WatchSuccessBrush}" FontWeight="SemiBold" /></Border>
                    </Grid>
                    <Grid x:Name="PanesGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="DemandsRow" Height="*" MinHeight="120" />
                            <RowDefinition Height="10" />
                            <RowDefinition x:Name="AlertsRow" Height="252" MinHeight="140" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                        <DataGrid x:Name="DemandsGrid"
                                  AutomationProperties.Name="TransportDemand 单页结果"
                                  Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  FrozenColumnCount="4"
                                  HeadersVisibility="Column"
                                  SelectionChanged="OnDemandSelectionChanged"
                                  SelectedCellsChanged="OnDemandSelectedCellsChanged"
                                  MouseDoubleClick="OnDemandsDoubleClick"
                                  PreviewKeyDown="OnDemandsPreviewKeyDown"
                                  Sorting="OnDemandsSorting">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DemandId}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TASK_TYPE" AutomationProperties.Name="TransportDemand TASK_TYPE 列" Binding="{Binding TaskType}" Width="175" CanUserSort="True" SortMemberPath="TaskType" />
                                <DataGridTextColumn Header="SUBLOT" AutomationProperties.Name="TransportDemand SUBLOT 列" Binding="{Binding Sublot}" Width="128" CanUserSort="True" SortMemberPath="Sublot" />
                                <DataGridTextColumn Header="AREA" AutomationProperties.Name="TransportDemand AREA 列" Binding="{Binding Area}" Width="92" CanUserSort="True" SortMemberPath="Area" />
                                <DataGridTextColumn Header="EQP" AutomationProperties.Name="TransportDemand EQP 列" Binding="{Binding Eqp}" Width="102" CanUserSort="True" SortMemberPath="Eqp" />
                                <DataGridTextColumn Header="DATES" AutomationProperties.Name="TransportDemand DATES 列" Binding="{Binding Dates, Converter={StaticResource LocalTime}}" Width="*" CanUserSort="True" SortMemberPath="Dates" />
                                <DataGridTextColumn Header="DemandId" AutomationProperties.Name="TransportDemand DemandId 列" Binding="{Binding DemandId}" Width="180" CanUserSort="True" SortMemberPath="DemandId" Visibility="Collapsed" />
                                <DataGridTextColumn Header="STEP" AutomationProperties.Name="TransportDemand STEP 列" Binding="{Binding Step}" Width="100" CanUserSort="True" SortMemberPath="Step" Visibility="Collapsed" />
                                <DataGridTextColumn Header="PACKAGE" AutomationProperties.Name="TransportDemand PACKAGE 列" Binding="{Binding Package}" Width="140" CanUserSort="True" SortMemberPath="Package" Visibility="Collapsed" />
                                <DataGridTextColumn Header="status" AutomationProperties.Name="TransportDemand status 列" Binding="{Binding Status}" Width="90" CanUserSort="True" SortMemberPath="Status" Visibility="Collapsed" />
                                <DataGridTextColumn Header="last seen" AutomationProperties.Name="TransportDemand MesLastSeenAt 列" Binding="{Binding MesLastSeenAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="MesLastSeenAt" Visibility="Collapsed" />
                                <DataGridTextColumn Header="disappear" AutomationProperties.Name="TransportDemand disappear count 列" Binding="{Binding DisappearCount}" Width="90" CanUserSort="True" SortMemberPath="DisappearCount" Visibility="Collapsed" />
                                <DataGridTextColumn Header="locationRisk" AutomationProperties.Name="TransportDemand location risk 列" Binding="{Binding LocationRisk}" Width="110" CanUserSort="True" SortMemberPath="LocationRisk" Visibility="Collapsed" />
                                <DataGridTextColumn Header="locationRiskCode" AutomationProperties.Name="TransportDemand location risk code 列" Binding="{Binding LocationRiskCode}" Width="160" CanUserSort="False" Visibility="Collapsed" />
                                <DataGridTextColumn Header="created" AutomationProperties.Name="TransportDemand created at 列" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="CreatedAt" Visibility="Collapsed" />
                                <DataGridTextColumn Header="gone at" AutomationProperties.Name="TransportDemand gone at 列" Binding="{Binding GoneAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="GoneAt" Visibility="Collapsed" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="查看详情" AutomationProperties.Name="查看所选 TransportDemand 详情" Click="OnDemandViewDetailsMenu" />
                                    <MenuItem Header="复制 DemandId" AutomationProperties.Name="复制所选 TransportDemand DemandId" Click="OnDemandCopyIdMenu" />
                                    <MenuItem Header="复制完整任务行" AutomationProperties.Name="复制所选 TransportDemand 完整任务行" Click="OnDemandCopyFullRowMenu" />
                                    <Separator />
                                    <MenuItem Header="按隐藏字段排序" AutomationProperties.Name="TransportDemand 隐藏字段排序">
                                        <MenuItem Header="DemandId" Tag="DemandId" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="STEP" Tag="STEP" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="PACKAGE" Tag="PACKAGE" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="status" Tag="status" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="last seen" Tag="last seen" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="disappear" Tag="disappear" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="locationRisk" Tag="locationRisk" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="created" Tag="created" Click="OnDemandSortMenuClick" />
                                        <MenuItem Header="gone at" Tag="gone at" Click="OnDemandSortMenuClick" />
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                            <DockPanel Grid.Row="1" Margin="12,7">
                                <TextBlock x:Name="RowCountText" Foreground="{StaticResource WatchMutedTextBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button x:Name="DemandPreviousButton" AutomationProperties.Name="TransportDemand 上一页" Content="上一页" Padding="10,4" MinHeight="26" IsEnabled="False" Click="OnDemandPreviousClick" />
                                    <TextBlock x:Name="DemandPageText" Text="第 1 页" Margin="14,5" VerticalAlignment="Center" />
                                    <ui:Button x:Name="DemandNextButton" AutomationProperties.Name="TransportDemand 下一页" Content="下一页" Padding="10,4" MinHeight="26" IsEnabled="False" Click="OnDemandNextClick" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                        <GridSplitter x:Name="PanesSplitter"
                                      AutomationProperties.Name="调整 TransportDemand 表格和详情区域"
                                      Grid.Row="1"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="True"
                                      MouseDoubleClick="OnPanesSplitterDoubleClick" />
                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource WatchBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Background="{StaticResource WatchSurfaceBrush}">
                            <Grid>
                                <TextBlock x:Name="DemandDetailsPlaceholder"
                                           Text="选择一条 TransportDemand，或双击 / 使用“查看详情”查看完整值。"
                                           Foreground="{StaticResource WatchMutedTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="TransportDemand 详情未选择" />
                                <Grid x:Name="DemandDetailsPanel"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="所选 TransportDemand 只读详情">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="SELECTED" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="当前任务"
                                                   Style="{StaticResource SectionTitleText}"
                                                   Margin="0,4,0,11"
                                                   AutomationProperties.AutomationId="DemandDetailsPanel"
                                                   AutomationProperties.Name="所选 TransportDemand 只读详情" />
                                        <TextBlock Text="DemandId" Style="{StaticResource FieldKeyText}" />
                                        <TextBlock Text="{Binding DemandId}" Style="{StaticResource CodeValueText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="TASK_TYPE + SUBLOT" Style="{StaticResource FieldKeyText}" Margin="0,12,0,3" />
                                        <TextBlock Text="{Binding TaskType}" Style="{StaticResource CodeValueText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sublot}" Style="{StaticResource CodeValueText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <Border Background="{StaticResource WatchSuccessSoftBrush}" CornerRadius="7" Padding="10" Margin="0,14,4,0">
                                            <TextBlock Text="{Binding RelatedAlertSummary}" Foreground="{StaticResource WatchSuccessBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource WatchBorderBrush}" />
                                    <Grid Grid.Column="2" Margin="16,0,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="IngestAlert" Style="{StaticResource EyebrowText}" /><TextBlock Text="相关告警" Style="{StaticResource SectionTitleText}" /></DockPanel>
                                        <DataGrid x:Name="DemandRelatedAlertsGrid" Grid.Row="1" ItemsSource="{Binding RelatedAlerts}" AutomationProperties.Name="当前 TransportDemand 相关 IngestAlert" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="None" HorizontalScrollBarVisibility="Disabled" GridLinesVisibility="None" RowHeight="76" Margin="0,10,0,0">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="{StaticResource WatchWarningSoftBrush}" />
                                                    <Setter Property="Margin" Value="0,0,0,6" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Severity}" Value="ERROR"><Setter Property="Background" Value="{StaticResource WatchErrorSoftBrush}" /></DataTrigger><DataTrigger Binding="{Binding Code}" Value="DUPLICATE_RECONCILE_KEY"><Setter Property="Background" Value="{StaticResource WatchWarningSoftBrush}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="CODE" Width="240">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource WatchErrorBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Code}" Value="DUPLICATE_RECONCILE_KEY"><Setter Property="Foreground" Value="{StaticResource WatchWarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Message}" Foreground="{StaticResource WatchSecondaryTextBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="RELATION" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding RelationshipBasis}" Style="{StaticResource FieldKeyText}" /><TextBlock Text="{Binding RelationshipLabel}" FontWeight="SemiBold" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                                <Grid x:Name="DemandFullDetailsPanel"
                                      Panel.ZIndex="2"
                                      Visibility="Collapsed"
                                      Background="{StaticResource WatchSurfaceBrush}"
                                      AutomationProperties.Name="TransportDemand 完整只读字段">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button x:Name="DemandCopyFullRowButton"
                                                       Content="复制完整行"
                                                       AutomationProperties.Name="复制所选 TransportDemand 完整任务行"
                                                       Padding="10,4"
                                                       Margin="0,0,8,0"
                                                       Click="OnDemandCopyFullRowMenu" />
                                            <ui:Button x:Name="DemandFullDetailsCloseButton"
                                                       Content="返回关系卡片"
                                                       AutomationProperties.Name="关闭 TransportDemand 完整字段"
                                                       Padding="10,4"
                                                       Click="OnDemandFullDetailsCloseClick" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="FULL DETAILS" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="完整任务字段" Style="{StaticResource SectionTitleText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock Text="{Binding MesInputGroup.Title}" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <ItemsControl x:Name="DemandMesInputFields"
                                                              ItemsSource="{Binding MesInputGroup.Fields}"
                                                              ItemTemplate="{StaticResource DemandDetailFieldTemplate}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LocalProjectionGroup.Title}" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <ItemsControl x:Name="DemandLocalProjectionFields"
                                                              ItemsSource="{Binding LocalProjectionGroup.Fields}"
                                                              ItemTemplate="{StaticResource DemandDetailFieldTemplate}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </DockPanel>

        </Grid>

        <StatusBar x:Name="WatchStatusBar"
                   Grid.Row="2"
                   Grid.ColumnSpan="3"
                   Height="28"
                   Background="#EDF1F5"
                   BorderBrush="{StaticResource WatchBorderBrush}"
                   BorderThickness="0,1,0,0"
                   Padding="12,4">
            <StatusBar.Resources><Style TargetType="StatusBarItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></StatusBar.Resources>
            <DockPanel>
                <TextBlock x:Name="StatusBarShortcutText"
                           DockPanel.Dock="Right"
                           Text="F5 刷新 · Esc 取消 · 方向键切换方案"
                           Foreground="{StaticResource WatchMutedTextBrush}"
                           FontSize="11" />
                <TextBlock x:Name="StatusBarSummaryText"
                           Foreground="{StaticResource WatchSecondaryTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusBarText"
                           AutomationProperties.Name="MesIngestWatch 状态栏"
                           Visibility="Collapsed" />
            </DockPanel>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
