                                <DataGridTextColumn Header="last seen" AutomationProperties.Name="TransportDemand MesLastSeenAt 列" Binding="{Binding MesLastSeenAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="MesLastSeenAt" />
                                <DataGridTextColumn Header="disappear" AutomationProperties.Name="TransportDemand disappear count 列" Binding="{Binding DisappearCount}" Width="90" CanUserSort="True" SortMemberPath="DisappearCount" />
                                <DataGridTextColumn Header="locationRisk" AutomationProperties.Name="TransportDemand location risk 列" Binding="{Binding LocationRisk}" Width="110" CanUserSort="True" SortMemberPath="LocationRisk" />
                                <DataGridTextColumn Header="locationRiskCode" AutomationProperties.Name="TransportDemand location risk code 列" Binding="{Binding LocationRiskCode}" Width="160" CanUserSort="False" />
                                <DataGridTextColumn Header="created" AutomationProperties.Name="TransportDemand created at 列" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="CreatedAt" />
                                <DataGridTextColumn Header="gone at" AutomationProperties.Name="TransportDemand gone at 列" Binding="{Binding GoneAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="GoneAt" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="查看详情" AutomationProperties.Name="查看所选 TransportDemand 详情" Click="OnDemandViewDetailsMenu" />
                                    <MenuItem Header="复制 DemandId" AutomationProperties.Name="复制所选 TransportDemand DemandId" Click="OnDemandCopyIdMenu" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                        <GridSplitter x:Name="PanesSplitter"
                                      AutomationProperties.Name="调整 TransportDemand 表格和详情区域"
                                      Grid.Row="1"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="True"
                                      MouseDoubleClick="OnPanesSplitterDoubleClick" />
                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource WatchBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Background="{StaticResource WatchSurfaceBrush}">
                            <Grid>
                                <TextBlock x:Name="DemandDetailsPlaceholder"
                                           Text="选择一条 TransportDemand，或双击 / 使用“查看详情”查看完整值。"
                                           Foreground="{StaticResource WatchMutedTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="TransportDemand 详情未选择" />
                                <Grid x:Name="DemandDetailsPanel"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="所选 TransportDemand 只读详情">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="当前任务"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           AutomationProperties.AutomationId="DemandDetailsPanel"
                                                           AutomationProperties.Name="所选 TransportDemand 只读详情" />
                                                <Button DockPanel.Dock="Right" Content="复制 DemandId" AutomationProperties.Name="从详情复制 DemandId" Padding="10,3" Click="OnDemandCopyIdMenu" />
                                            </DockPanel>
                                            <TextBlock Text="MES INPUT" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="{Binding MesInputGroup.Title}" FontWeight="SemiBold" Foreground="{StaticResource WatchTextBrush}" Margin="0,4,0,4" />
                                            <ItemsControl ItemsSource="{Binding MesInputGroup.Fields}" ItemTemplate="{StaticResource DemandDetailFieldTemplate}" />
                                            <TextBlock Text="LOCAL PROJECTION" Style="{StaticResource EyebrowText}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding LocalProjectionGroup.Title}" FontWeight="SemiBold" Foreground="{StaticResource WatchTextBrush}" Margin="0,4,0,4" />
                                            <ItemsControl ItemsSource="{Binding LocalProjectionGroup.Fields}" ItemTemplate="{StaticResource DemandDetailFieldTemplate}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Grid.Column="1" Background="{StaticResource WatchBorderBrush}" />
                                    <Grid Grid.Column="2" Margin="16,0,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="IngestAlert" Style="{StaticResource EyebrowText}" /><TextBlock Text="相关告警" FontSize="16" FontWeight="SemiBold" /></DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding RelatedAlertSummary}" Foreground="{StaticResource WatchSecondaryTextBrush}" Margin="0,5,0,8" />
                                        <DataGrid x:Name="DemandRelatedAlertsGrid" Grid.Row="2" ItemsSource="{Binding RelatedAlerts}" AutomationProperties.Name="当前 TransportDemand 相关 IngestAlert" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="190" />
                                                <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}" Width="80" />
                                                <DataGridTextColumn Header="RELATION" Binding="{Binding RelationshipBasis}" Width="125" />
                                                <DataGridTextColumn Header="说明" Binding="{Binding RelationshipLabel}" Width="95" />
                                                <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="220" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </DockPanel>

            <StatusBar x:Name="WatchStatusBar"
                       Grid.Row="2"
                       Height="28"
                       Padding="4,2">
                <StatusBarItem>
                    <TextBlock x:Name="StatusBarText"
                               AutomationProperties.Name="MesIngestWatch 状态栏"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
