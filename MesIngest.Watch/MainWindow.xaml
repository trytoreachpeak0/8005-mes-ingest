                                    <TextBox x:Name="DemandRangeFromFilter" AutomationProperties.Name="TransportDemand 时间起始筛选" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,17">
                                    <TextBlock x:Name="DemandRangeToLabel" Text="进入时间结束" Foreground="{StaticResource WatchMutedTextBrush}" FontSize="11" />
                                    <TextBox x:Name="DemandRangeToFilter" AutomationProperties.Name="TransportDemand 时间结束筛选" Margin="0,5,0,0" />
