<Window x:Class="MesIngest.Watch.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MesIngest.Watch"
        Title="MesIngest Watch"
        Height="720"
        Width="1180"
        MinHeight="480"
        MinWidth="900">
    <Window.Resources>
        <local:LocalDateTimeOffsetConverter x:Key="LocalTime" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F5F7" CornerRadius="6" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,18">
                    <TextBlock Text="MesIngestWatch" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="单 Host · 只读运维台" Margin="0,4,0,0" Foreground="#5F6B76" />
                </StackPanel>
                <ListBox x:Name="PrimaryNavigation"
                         SelectedIndex="0"
                         SelectionChanged="OnPrimaryNavigationChanged"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBoxItem Content="概览" Padding="10,8" />
                    <ListBoxItem Content="MES 任务 / TransportDemand" Padding="10,8" />
                    <ListBoxItem Content="IngestAlert" Padding="10,8" />
                    <ListBoxItem Content="设置" Padding="10,8" />
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="12,0,12,8" Padding="10,6" Background="#F7F8FA" CornerRadius="4">
                <TextBlock x:Name="CurrentHostContextText" TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid x:Name="OverviewPage" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="12,8,12,12">
                    <TextBlock Text="概览" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="OverviewHostText" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Row="1" Margin="12" Padding="16" BorderBrush="#D8DEE4" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="最近轮询健康" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverviewPollHealthText" Margin="0,8,0,0" Text="尚无成功轮询" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AlertsPage" Grid.Row="1" Visibility="Collapsed" Margin="12">
                <StackPanel>
                    <TextBlock Text="IngestAlert" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Text="告警浏览将在后续实现票中接入；当前会话切换会清除此视图状态。" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" Margin="0,22,0,0">
                    <TextBlock Text="Host 基址" />
                    <TextBox x:Name="HostBaseUrlInput" Margin="0,6,0,0" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="只读 API 凭据" />
                    <PasswordBox x:Name="HostCredentialInput" PasswordChar="●" Margin="0,6,0,0" Padding="8,5" />
                    <TextBlock Text="凭据始终掩码，不写入页面、错误或日志。" Foreground="#5F6B76" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock Text="请求超时（秒）" />
                    <TextBox x:Name="RequestTimeoutInput" ToolTip="1–300 秒" Width="160" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="ApplyHostButton" Content="应用" Padding="18,7" Click="OnApplyHostClick" />
                    <TextBlock x:Name="SettingsValidationText" Margin="12,7,0,0" Foreground="#C62828" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <DockPanel x:Name="DemandsPage" Grid.Row="1" Visibility="Collapsed">
        <StatusBar x:Name="WatchStatusBar"
                   DockPanel.Dock="Bottom"
                   Margin="0,8,0,0"
                   Padding="4,2">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Border x:Name="ErrorBanner"
                    Background="#C62828"
                    Padding="10,8"
                    Margin="0,0,0,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorBannerText"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           FontSize="14" />
            </Border>
            <Border x:Name="WarningBanner"
                    Background="#EF6C00"
                    Padding="10,8"
                    Margin="0,0,0,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="WarningBannerText"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           FontSize="14" />
            </Border>
            <WrapPanel Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="TASK_TYPE" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="FilterTaskType" Width="140" TextChanged="OnFilterChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="SUBLOT" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="FilterSublot" Width="120" TextChanged="OnFilterChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="status" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="FilterStatus" Width="110" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="VISIBLE" IsSelected="True" />
                        <ComboBoxItem Content="GONE" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="DemandId" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="FilterDemandId" Width="220" TextChanged="OnDemandIdTextChanged" />
                </StackPanel>
                <StackPanel x:Name="GoneWindowPanel"
                            Orientation="Horizontal"
                            Margin="0,0,12,4"
                            Visibility="Collapsed">
                    <TextBlock Text="GoneAt window" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="GoneWindowHours" Width="120" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="24h" Tag="24" IsSelected="True" />
                        <ComboBoxItem Content="48h" Tag="48" />
                        <ComboBoxItem Content="7d" Tag="168" />
                        <ComboBoxItem Content="30d" Tag="720" />
                    </ComboBox>
                </StackPanel>
                <Button x:Name="LoadMoreButton"
                        Content="Load more"
                        Margin="0,0,12,4"
                        Padding="10,2"
                        Click="OnLoadMoreClick"
                        IsEnabled="False" />
                <TextBlock x:Name="RowCountText" VerticalAlignment="Center" Margin="8,0,0,0" />
            </WrapPanel>
        </StackPanel>

        <Grid x:Name="PanesGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DemandsRow" Height="7*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition x:Name="AlertsRow" Height="3*" MinHeight="80" />
            </Grid.RowDefinitions>

            <GroupBox Header="TransportDemands" Grid.Row="0">
                <DataGrid x:Name="DemandsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          Sorting="OnDemandsSorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="180" CanUserSort="True" SortMemberPath="DemandId" />
                        <DataGridTextColumn Header="TASK_TYPE" Binding="{Binding TaskType}" Width="150" CanUserSort="True" SortMemberPath="TaskType" />
                        <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="110" CanUserSort="True" SortMemberPath="Sublot" />
                        <DataGridTextColumn Header="status" Binding="{Binding Status}" Width="80" CanUserSort="True" SortMemberPath="Status" />
                        <DataGridTextColumn Header="当前工序进入时间 (DATES)" Binding="{Binding Dates, Converter={StaticResource LocalTime}}" Width="220" CanUserSort="True" SortMemberPath="Dates" />
                        <DataGridTextColumn Header="last seen" Binding="{Binding MesLastSeenAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="MesLastSeenAt" />
                        <DataGridTextColumn Header="created" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="CreatedAt" />
                        <DataGridTextColumn Header="gone at" Binding="{Binding GoneAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" SortMemberPath="GoneAt" />
                        <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="90" CanUserSort="True" SortMemberPath="Area" />
                        <DataGridTextColumn Header="EQP" Binding="{Binding Eqp}" Width="80" CanUserSort="True" SortMemberPath="Eqp" />
                        <DataGridTextColumn Header="STEP" Binding="{Binding Step}" Width="80" CanUserSort="True" SortMemberPath="Step" />
                        <DataGridTextColumn Header="PACKAGE" Binding="{Binding Package}" Width="140" CanUserSort="True" SortMemberPath="Package" />
                        <DataGridTextColumn Header="locationRisk" Binding="{Binding LocationRisk}" Width="90" CanUserSort="True" SortMemberPath="LocationRisk" />
                        <DataGridTextColumn Header="disappear" Binding="{Binding DisappearCount}" Width="80" CanUserSort="True" SortMemberPath="DisappearCount" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter x:Name="PanesSplitter"
                          Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="#FFBDBDBD"
                          MouseDoubleClick="OnPanesSplitterDoubleClick" />

            <GroupBox Header="Alerts" Grid.Row="2" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="AlertsGrid"
                              Grid.Row="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          Sorting="OnAlertsSorting"
                          MouseDoubleClick="OnAlertsDoubleClick"
                          PreviewKeyDown="OnAlertsPreviewKeyDown"
                          PreviewMouseRightButtonDown="OnAlertsPreviewMouseRightButtonDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Code"
                                                SortMemberPath="Code"
                                                Width="160"
                                                CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Code}"
                                            Click="OnAlertViewDetailsClick"
                                            AutomationProperties.AutomationId="AlertDetailsButton"
                                            ToolTip="查看 Alert 详情"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Foreground="#FF1565C0"
                                            HorizontalContentAlignment="Left" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" CanUserSort="True" />
                        <DataGridTextColumn Header="AlertId" Binding="{Binding AlertId}" Width="180" CanUserSort="True" />
                        <DataGridTextColumn Header="last seen" Binding="{Binding LastSeenAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" />
                        <DataGridTextColumn Header="first seen" Binding="{Binding FirstSeenAt, Converter={StaticResource LocalTime}}" Width="200" CanUserSort="True" />
                        <DataGridTextColumn Header="TASK_TYPE" Binding="{Binding TaskType}" Width="160" CanUserSort="True" />
                        <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="120" CanUserSort="True" />
                        <DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="200" CanUserSort="True" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" CanUserSort="True" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="查看详情" Click="OnAlertViewDetailsMenu" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    </DataGrid>
                    <DockPanel Grid.Row="1" Margin="6,4,6,4">
                        <Button x:Name="LoadMoreAlertsButton"
                                DockPanel.Dock="Right"
                                Content="Load more alerts"
                                Padding="10,2"
                                Click="OnLoadMoreAlertsClick"
                                IsEnabled="False" />
                        <TextBlock x:Name="AlertCountText"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                    </DockPanel>
                </Grid>
            </GroupBox>
        </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
