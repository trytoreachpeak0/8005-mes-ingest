<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!--
            FontTypography resolves these official ramp resources when a
            standalone production window is composed without App.xaml.
        -->
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!--
        Production semantic resources for the selected Watch information design.
        Visual color is intentionally resolved through WPF UI's active theme so
        light, dark, inactive, and high-contrast modes keep their native meaning.
    -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>

    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusSurface">8</CornerRadius>

    <!--
        The approved Overview Variant A uses one calm accent-soft surface to
        identify the locally applied AREA scope. Keep the reviewed light-theme
        value behind a semantic DynamicResource so high-contrast/theme hosts
        can replace the brush without changing page structure.
    -->
    <SolidColorBrush x:Key="WatchAccentSoftLightBrush" Color="#E7F3FF" />
    <SolidColorBrush x:Key="WatchAccentSoftBrush" Color="#E7F3FF" />

    <!--
        All semantic text consumes WPF UI's FontTypography ramp. The selected
        prototype intentionally calibrates section headings to 18 epx,
        secondary text to 13 epx, and overview metrics to 30/25 epx because
        those exact values are absent from the ramp; keep those overrides here.
    -->
    <Style x:Key="PageTitleText"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontTypography" Value="Title" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitleText"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontTypography" Value="BodyStrong" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyStrong"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontTypography" Value="BodyStrong" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SecondaryText"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontTypography" Value="Body" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CaptionText"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontTypography" Value="Caption" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldLabel"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontTypography" Value="BodyStrong" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CodeText"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontTypography" Value="Caption" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SummaryValue"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontTypography" Value="Title" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="OverviewPrimaryMetric"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontTypography" Value="Title" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="OverviewRatioMetric"
           TargetType="ui:TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontTypography" Value="Title" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="InlineIntentButton" TargetType="ui:Button">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="FlatCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
        <Setter Property="MinHeight" Value="174" />
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="StatusPillSuccess" TargetType="Border" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="StatusPillCaution" TargetType="Border" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="StatusPillCritical" TargetType="Border" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="StatusPillAccent" TargetType="Border" BasedOn="{StaticResource StatusPill}">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="WatchDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource WatchDataGrid}" />
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <!-- DataGridTextColumn generates a TextBlock with the framework's 2 epx
             horizontal margin. Eight on the cell yields the selected 10 epx
             content axis while template columns retain an explicit gutter. -->
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DataGridTextCell" TargetType="TextBlock">
        <!-- DataGridCell owns the horizontal inset; an ElementStyle must not
             add a second 10 epx gutter. -->
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
</ResourceDictionary>
