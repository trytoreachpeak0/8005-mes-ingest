                                                 Background="Transparent"
                                                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 BorderThickness="0,1,0,1"
                                                 SelectionMode="Multiple"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="False"
                                                 Focusable="True"
                                                 KeyboardNavigation.IsTabStop="True"
                                                 SelectionChanged="OnErrorSearchCategorySelectionChanged"
                                                 AutomationProperties.Name="错误分类导航（可多选）"
                                                 AutomationProperties.HelpText="选择一个或多个分类后使用应用条件；每项数量来自当前保留的 Host 冻结快照。"
                                                 AutomationProperties.AutomationId="ErrorSearchCategoryList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="MinHeight" Value="54" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ErrorSearchCategorySurface"
                                                            Padding="10,7"
                                                            Background="Transparent"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <ui:TextBlock x:Name="ErrorSearchCategoryNameText"
                                                                              Text="{Binding Category}"
                                                                              Style="{StaticResource CodeText}"
                                                                              FontWeight="SemiBold"
                                                                              TextTrimming="CharacterEllipsis" />
                                                                <ui:TextBlock x:Name="ErrorSearchCategoryCodesText"
                                                                              Text="{Binding CodesSummary}"
                                                                              Style="{StaticResource CaptionText}"
                                                                              ToolTip="{Binding CodesSummary}"
                                                                              TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="8,0,0,0"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center">
                                                                <ui:TextBlock x:Name="ErrorSearchCategorySeriesCountText"
                                                                              Text="{Binding SeriesCountText}"
                                                                              Style="{StaticResource BodyStrong}"
                                                                              HorizontalAlignment="Right" />
                                                                <ui:TextBlock x:Name="ErrorSearchCategorySeriesCaptionText"
                                                                              Text="{Binding SeriesCountCaption}"
                                                                              Style="{StaticResource CaptionText}"
                                                                              HorizontalAlignment="Right" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                     Value="True">
                                                            <Setter TargetName="ErrorSearchCategorySurface"
                                                                    Property="Background"
                                                                    Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}" />
                                                            <Setter TargetName="ErrorSearchCategoryNameText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}" />
                                                            <Setter TargetName="ErrorSearchCategoryCodesText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}" />
                                                            <Setter TargetName="ErrorSearchCategorySeriesCountText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}" />
                                                            <Setter TargetName="ErrorSearchCategorySeriesCaptionText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <ui:TextBlock Grid.Row="3"
                                                      Text="活动状态精确分面" Style="{StaticResource SectionTitleText}"
                                                      Margin="{StaticResource DemandSeriesSubsectionHeadingMargin}" />
                                        <DataGrid x:Name="ErrorSearchActivityStateFacetGrid"
                                                  Grid.Row="4"
                                                  Height="{StaticResource Ticket22FacetGridHeight}"
                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                  Focusable="True"
                                                  KeyboardNavigation.IsTabStop="True"
                                                  AutomationProperties.Name="错误活动状态 Host 精确分面"
                                                  AutomationProperties.AutomationId="ErrorSearchActivityStateFacetGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*" />
                                                <DataGridTextColumn Header="Series" Binding="{Binding SeriesCount}" Width="{StaticResource DemandSeriesColumn65}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </ui:Card>

                                <ui:Card x:Name="ErrorSearchResultsCard"
                                         Grid.Column="2"
                                         Padding="0"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"
                                         AutomationProperties.Name="错误检索 Series 结果"
                                         AutomationProperties.AutomationId="ErrorSearchResultsCard">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="16,12,16,10">
                                            <ui:TextBlock Text="去重 DemandSeries" Style="{StaticResource SectionTitleText}" />
                                            <ui:TextBlock x:Name="ErrorSearchPageSummaryText"
                                                          Text="尚无错误历史快照"
                                                          Style="{StaticResource SecondaryText}"
                                                          Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                          AutomationProperties.Name="错误检索分页摘要：尚无错误历史快照" />
                                            <ui:TextBlock x:Name="ErrorSearchEmptyResultText"
                                                          Text=""
                                                          Style="{StaticResource SecondaryText}"
                                                          Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                          AutomationProperties.Name="错误检索空结果说明" />
                                        </StackPanel>
                                        <ui:Button x:Name="ErrorSearchClearFilterButton"
                                                   Content="清除条件"
                                                   Appearance="Transparent"
                                                   Margin="0,10,12,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Focusable="True"
                                                   KeyboardNavigation.IsTabStop="True"
                                                   Click="OnErrorSearchClearFiltersClick"
                                                   AutomationProperties.Name="清除错误检索条件"
                                                   AutomationProperties.AutomationId="ErrorSearchClearFilterButton" />
                                        <Border Grid.Row="1"
                                                Padding="12"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,1">
                                            <StackPanel>
                                                <Grid x:Name="ErrorSearchFilterGrid"
                                                      SizeChanged="OnErrorSearchFilterGridSizeChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition x:Name="ErrorSearchFilterGapRow" Height="0" />
                                                        <RowDefinition x:Name="ErrorSearchFilterSecondRow" Height="0" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="185" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="135" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="135" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <ui:TextBlock Text="错误码" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="ErrorSearchCodeFilter"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="False"
                                                                  Tag="全部错误码"
                                                                  Margin="0,5,0,0"
                                                                  Focusable="True"
                                                                  KeyboardNavigation.IsTabStop="True"
                                                                  AutomationProperties.Name="错误码筛选"
                                                                  AutomationProperties.AutomationId="ErrorSearchCodeFilter" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <ui:TextBlock Text="活动状态" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="ErrorSearchActivityStateFilter"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="False"
                                                                  Tag="全部状态"
                                                                  Margin="0,5,0,0"
                                                                  Focusable="True"
                                                                  KeyboardNavigation.IsTabStop="True"
                                                                  AutomationProperties.Name="错误活动状态筛选"
                                                                  AutomationProperties.AutomationId="ErrorSearchActivityStateFilter">
                                                            <ComboBoxItem Content="ACTIVE" />
                                                            <ComboBoxItem Content="ENDED" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <ui:TextBlock Text="时间范围" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="ErrorSearchWindowFilter"
                                                                  SelectedValuePath="Tag"
                                                                  SelectedIndex="1"
                                                                  Margin="0,5,0,0"
                                                                  Focusable="True"
                                                                  KeyboardNavigation.IsTabStop="True"
                                                                  AutomationProperties.Name="错误检索时间范围"
                                                                  AutomationProperties.AutomationId="ErrorSearchWindowFilter">
                                                            <ComboBoxItem Content="最近 24 小时" Tag="LAST_24_HOURS" />
                                                            <ComboBoxItem Content="最近 7 天" Tag="LAST_7_DAYS" />
                                                            <ComboBoxItem Content="最近 15 天" Tag="LAST_15_DAYS" />
                                                            <ComboBoxItem Content="全部历史" Tag="ALL_HISTORY" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel x:Name="ErrorSearchSeriesIdFilterField"
                                                                Grid.Column="6">
                                                        <ui:TextBlock Text="SeriesId（精确）" Style="{StaticResource FieldLabel}" />
                                                        <TextBox x:Name="ErrorSearchSeriesIdFilter"
                                                                 Margin="0,5,0,0"
                                                                 Focusable="True"
                                                                 KeyboardNavigation.IsTabStop="True"
                                                                 AutomationProperties.Name="错误检索 SeriesId 精确筛选"
                                                                 AutomationProperties.AutomationId="ErrorSearchSeriesIdFilter" />
                                                    </StackPanel>
                                                    <ui:Button x:Name="ErrorSearchApplyFilterButton"
                                                               Grid.Column="8"
                                                               Content="应用条件"
                                                               Appearance="Secondary"
                                                               Padding="14,6"
                                                               VerticalAlignment="Bottom"
                                                               Focusable="True"
                                                               KeyboardNavigation.IsTabStop="True"
                                                               Click="OnErrorSearchApplyFiltersClick"
                                                               AutomationProperties.Name="应用错误检索条件"
                                                               AutomationProperties.AutomationId="ErrorSearchApplyFilterButton" />
                                                </Grid>
                                                <Expander Header="更多条件"
                                                          Margin="0,8,0,0"
                                                          HorizontalAlignment="Stretch">
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <StackPanel Width="180" Margin="0,0,10,0">
                                                            <ui:TextBlock Text="DemandId（精确）" Style="{StaticResource FieldLabel}" />
                                                            <TextBox x:Name="ErrorSearchDemandIdFilter"
                                                                     Margin="0,5,0,0"
                                                                     Focusable="True"
                                                                     KeyboardNavigation.IsTabStop="True"
                                                                     AutomationProperties.Name="错误检索 DemandId 精确筛选"
                                                                     AutomationProperties.AutomationId="ErrorSearchDemandIdFilter" />
                                                        </StackPanel>
                                                        <StackPanel Width="170" Margin="0,0,10,0">
                                                            <ui:TextBlock Text="SUBLOT（包含）" Style="{StaticResource FieldLabel}" />
                                                            <TextBox x:Name="ErrorSearchSublotFilter"
                                                                     Margin="0,5,0,0"
                                                                     Focusable="True"
                                                                     KeyboardNavigation.IsTabStop="True"
                                                                     AutomationProperties.Name="错误检索 SUBLOT 包含筛选"
                                                                     AutomationProperties.AutomationId="ErrorSearchSublotFilter" />
                                                        </StackPanel>
                                                        <StackPanel Width="80" Margin="0,0,10,0">
                                                            <ui:TextBlock Text="每页" Style="{StaticResource FieldLabel}" />
                                                            <ComboBox x:Name="ErrorSearchPageSizeInput"
                                                                      SelectedValuePath="Tag"
                                                                      SelectedIndex="1"
                                                                      Margin="0,5,0,0"
                                                                      Focusable="True"
                                                                      KeyboardNavigation.IsTabStop="True"
                                                                      AutomationProperties.Name="错误检索每页数量"
                                                                      AutomationProperties.AutomationId="ErrorSearchPageSizeInput">
                                                                <ComboBoxItem Content="25"><ComboBoxItem.Tag><sys:Int32>25</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                                <ComboBoxItem Content="50"><ComboBoxItem.Tag><sys:Int32>50</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                                <ComboBoxItem Content="100"><ComboBoxItem.Tag><sys:Int32>100</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                                <ComboBoxItem Content="200"><ComboBoxItem.Tag><sys:Int32>200</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid x:Name="ErrorSearchSeriesGrid"
                                                  Grid.Row="2"
                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                  SelectionChanged="OnErrorSearchSelectionChanged"
                                                  Focusable="True"
                                                  KeyboardNavigation.IsTabStop="True"
                                                  AutomationProperties.Name="错误检索去重 Series 结果"
                                                  AutomationProperties.AutomationId="ErrorSearchSeriesGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="SeriesId" Binding="{Binding SeriesId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                <DataGridTextColumn Header="WorkType" Binding="{Binding WorkType}" Width="{StaticResource DemandSeriesColumn130}" />
                                                <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="{StaticResource DemandSeriesColumn130}" />
                                                <DataGridTemplateColumn Header="状态" Width="{StaticResource DemandSeriesColumn90}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="2,0"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left"
                                                                    AutomationProperties.Name="{Binding ActivityState}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ActivityState}" Value="ACTIVE">
                                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ActivityState}" Value="ENDED">
                                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <ui:TextBlock Text="{Binding ActivityState}"
                                                                              FontTypography="BodyStrong"
                                                                              Appearance="{x:Null}"
                                                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=(TextElement.Foreground)}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="命中期间" Binding="{Binding MatchedPeriodSummary}" Width="{StaticResource DemandSeriesColumn130}" />
                                                <DataGridTextColumn Header="Demand 世代" Binding="{Binding MatchedDemandGenerationSummary}" Width="{StaticResource DemandSeriesColumn170}" />
                                                <DataGridTextColumn Header="最新证据" Binding="{Binding LatestMatchedEvidenceAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                <DataGridTextColumn Header="MES AREA" Binding="{Binding MesArea}" Width="{StaticResource DemandSeriesColumn120}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Grid.Row="3"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="12,0">
                                        <WrapPanel VerticalAlignment="Center">
                                            <ui:Button x:Name="ErrorSearchPreviousPageButton"
                                                       Content="上一页"
                                                       Appearance="Secondary"
                                                       Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                       Focusable="True"
                                                       KeyboardNavigation.IsTabStop="True"
                                                       Click="OnErrorSearchPreviousPageClick"
                                                       AutomationProperties.Name="错误检索上一页"
                                                       AutomationProperties.AutomationId="ErrorSearchPreviousPageButton" />
                                            <ui:Button x:Name="ErrorSearchNextPageButton"
                                                       Content="下一页"
                                                       Appearance="Secondary"
                                                       Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                       Focusable="True"
                                                       KeyboardNavigation.IsTabStop="True"
                                                       Click="OnErrorSearchNextPageClick"
                                                       AutomationProperties.Name="错误检索下一页"
                                                       AutomationProperties.AutomationId="ErrorSearchNextPageButton" />
                                            <TextBox x:Name="ErrorSearchPageNumberInput"
                                                     Width="{StaticResource DemandSeriesPageNumberWidth}"
                                                     Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                     VerticalContentAlignment="Center"
                                                     Focusable="True"
                                                     KeyboardNavigation.IsTabStop="True"
                                                     AutomationProperties.Name="错误检索目标页码"
                                                     AutomationProperties.AutomationId="ErrorSearchPageNumberInput" />
                                            <ui:Button x:Name="ErrorSearchGoToPageButton"
                                                       Content="跳转"
                                                       Appearance="Secondary"
                                                       Margin="{StaticResource DemandSeriesCompactCommandLastMargin}"
                                                       Focusable="True"
                                                       KeyboardNavigation.IsTabStop="True"
                                                       Click="OnErrorSearchGoToPageClick"
                                                       AutomationProperties.Name="错误检索直接页码跳转"
                                                       AutomationProperties.AutomationId="ErrorSearchGoToPageButton" />
                                        </WrapPanel>
                                        </Border>
                                    </Grid>
                                </ui:Card>

                                <ui:Card x:Name="ErrorSearchDetailCard"
                                         Grid.Column="4"
                                         Padding="0"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"
                                         AutomationProperties.Name="错误检索命中证据详情"
                                         AutomationProperties.AutomationId="ErrorSearchDetailCard">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="16,12,16,10">
                                        <ui:TextBlock Text="命中证据详情" Style="{StaticResource SectionTitleText}" />
                                        <ui:TextBlock x:Name="ErrorSearchDetailContextText"
                                                      Text="请选择一个 DemandSeries 查看窗口边界、Demand 世代与证据。"
                                                      Style="{StaticResource SecondaryText}"
                                                      Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                      AutomationProperties.Name="错误检索详情上下文" />
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <ui:TextBlock Grid.Row="2" Text="真正命中的期间" Style="{StaticResource BodyStrong}"
                                                      Margin="16,10,16,8" />
                                        <DataGrid x:Name="ErrorSearchPeriodGrid"
                                                  Grid.Row="3"
                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                  SelectionChanged="OnErrorSearchPeriodSelectionChanged"
                                                  Focusable="True"
                                                  KeyboardNavigation.IsTabStop="True"
                                                  AutomationProperties.Name="错误检索真正命中期间"
                                                  AutomationProperties.AutomationId="ErrorSearchPeriodGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="错误码" Binding="{Binding Code}" Width="{StaticResource DemandSeriesColumn180}" />
                                                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="{StaticResource DemandSeriesColumn150}" />
                                                 <DataGridTextColumn Header="状态边界" Binding="{Binding BoundarySummary}" Width="{StaticResource DemandSeriesColumn260}" />
                                                 <DataGridTextColumn Header="开始" Binding="{Binding StartedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                 <DataGridTextColumn Header="结束" Binding="{Binding EndedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                 <DataGridTextColumn Header="结束原因" Binding="{Binding EndReason}" Width="{StaticResource DemandSeriesColumn150}" />
                                                 <DataGridTextColumn Header="主体种类" Binding="{Binding SubjectKind}" Width="{StaticResource DemandSeriesColumn120}" />
                                                 <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="{StaticResource DemandSeriesColumn130}" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <ui:TextBlock Grid.Row="4" Text="可解释证据" Style="{StaticResource BodyStrong}"
                                                      Margin="16,10,16,8" />
                                        <DataGrid x:Name="ErrorSearchEvidenceGrid"
                                                  Grid.Row="5"
                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                  SelectionChanged="OnErrorSearchEvidenceSelectionChanged"
                                                  Focusable="True"
                                                  KeyboardNavigation.IsTabStop="True"
                                                  AutomationProperties.Name="错误检索可解释证据"
                                                  AutomationProperties.AutomationId="ErrorSearchEvidenceGrid">
                                             <DataGrid.Columns>
                                                 <DataGridTextColumn Header="证据" Binding="{Binding EvidenceId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                 <DataGridTextColumn Header="证据类型" Binding="{Binding EvidenceKind}" Width="{StaticResource DemandSeriesColumn150}" />
                                                 <DataGridTextColumn Header="字段 / 主体" Binding="{Binding SubjectKind}" Width="{StaticResource DemandSeriesColumn120}" />
                                                 <DataGridTextColumn Header="观测值" Binding="{Binding DiagnosticSummary}" Width="{StaticResource DemandSeriesColumn230}" />
                                                <DataGridTextColumn Header="规则" Binding="{Binding ExpectedRule}" Width="{StaticResource DemandSeriesColumn230}" />
                                                <DataGridTextColumn Header="Demand / WorkType" Binding="{Binding SubjectReference}" Width="{StaticResource DemandSeriesColumn230}" />
                                                <DataGridTextColumn Header="时间" Binding="{Binding ObservedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                <DataGridTextColumn Header="PollTrace" Binding="{Binding PollTraceId}" Width="{StaticResource DemandSeriesColumn170}" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Expander Grid.Row="6"
                                                  Margin="12,4"
                                                  HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <ui:TextBlock Text="受限原始证据（显式按需）"
                                                                      Style="{StaticResource BodyStrong}" />
