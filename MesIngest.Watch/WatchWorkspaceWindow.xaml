                                                                 <DataGridTextColumn Header="主体类型" Binding="{Binding SubjectKind}" Width="{StaticResource DemandSeriesColumn140}" />
                                                                 <DataGridTextColumn Header="开始原因" Binding="{Binding StartReason}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="开始" Binding="{Binding StartedAt}" Width="{StaticResource DemandSeriesColumn170}" />
