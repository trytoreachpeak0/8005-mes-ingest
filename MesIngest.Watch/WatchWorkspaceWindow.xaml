                                         AutomationProperties.AutomationId="CurrentAttentionFacetCard">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="CurrentAttentionKindFilterColumn" Width="200" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition x:Name="CurrentAttentionSeverityFilterColumn" Width="210" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition x:Name="CurrentAttentionPageSizeFilterColumn" Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <ui:TextBlock Text="关注类型" Style="{StaticResource FieldLabel}" />
