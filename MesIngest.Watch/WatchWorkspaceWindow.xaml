                                                          SelectedIndex="0"
                                                          Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                          KeyboardNavigation.IsTabStop="True"
                                                           AutomationProperties.Name="生命周期筛选"
                                                           AutomationProperties.AutomationId="DemandSeriesLifecycleFilter">
                                                    <ComboBoxItem Content="全部生命周期" />
                                                    <ComboBoxItem Content="TRACKING" />
                                                    <ComboBoxItem Content="ARCHIVED" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="{StaticResource DemandSeriesFilterPresenceWidth}" Margin="{StaticResource DemandSeriesFilterFieldMargin}">
                                                <ui:TextBlock Text="当前出现" Style="{StaticResource FieldLabel}" />
                                                 <ComboBox x:Name="DemandSeriesPresenceFilter"
                                                          SelectedIndex="0"
                                                          Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                          KeyboardNavigation.IsTabStop="True"
                                                           AutomationProperties.Name="当前出现状态筛选"
                                                           AutomationProperties.AutomationId="DemandSeriesPresenceFilter">
                                                    <ComboBoxItem Content="全部出现状态" />
                                                    <ComboBoxItem Content="VISIBLE" />
                                                    <ComboBoxItem Content="GONE" />
                                                    <ComboBoxItem Content="LONG_GONE_BUT_VISIBLE" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="{StaticResource DemandSeriesFilterWideWidth}" Margin="{StaticResource DemandSeriesFilterFieldMargin}">
                                                <ui:TextBlock Text="WorkType" Style="{StaticResource FieldLabel}" />
                                                 <ComboBox x:Name="DemandSeriesWorkTypeFilter"
                                                           SelectedIndex="0"
                                                           IsEditable="True"
                                                           Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                          KeyboardNavigation.IsTabStop="True"
                                                           AutomationProperties.Name="WorkType 筛选"
                                                           AutomationProperties.AutomationId="DemandSeriesWorkTypeFilter">
                                                    <ComboBoxItem Content="全部 WorkType" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="{StaticResource DemandSeriesFilterWideWidth}" Margin="{StaticResource DemandSeriesFilterFieldMargin}">
                                                <ui:TextBlock Text="SUBLOT" Style="{StaticResource FieldLabel}" />
                                                 <TextBox x:Name="DemandSeriesSublotFilter"
                                                         Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                         KeyboardNavigation.IsTabStop="True"
                                                          AutomationProperties.Name="SUBLOT 筛选"
                                                          AutomationProperties.AutomationId="DemandSeriesSublotFilter" />
                                            </StackPanel>
                                            <StackPanel Width="{StaticResource DemandSeriesFilterWideWidth}" Margin="{StaticResource DemandSeriesFilterFieldMargin}">
                                                <ui:TextBlock Text="SeriesId" Style="{StaticResource FieldLabel}" />
                                                 <TextBox x:Name="DemandSeriesSeriesIdFilter"
                                                         Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                         KeyboardNavigation.IsTabStop="True"
                                                          AutomationProperties.Name="SeriesId 筛选"
                                                          AutomationProperties.AutomationId="DemandSeriesSeriesIdFilter" />
                                            </StackPanel>
                                            <StackPanel Width="{StaticResource DemandSeriesFilterWideWidth}" Margin="{StaticResource DemandSeriesFilterFieldMargin}">
                                                <ui:TextBlock Text="DemandId" Style="{StaticResource FieldLabel}" />
                                                 <TextBox x:Name="DemandSeriesDemandIdFilter"
                                                         Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                         KeyboardNavigation.IsTabStop="True"
                                                          AutomationProperties.Name="DemandId 筛选"
                                                          AutomationProperties.AutomationId="DemandSeriesDemandIdFilter" />
                                            </StackPanel>
                                            <StackPanel Width="{StaticResource DemandSeriesFilterPageSizeWidth}" Margin="{StaticResource DemandSeriesFilterFieldMargin}">
                                                <ui:TextBlock Text="每页" Style="{StaticResource FieldLabel}" />
                                                 <ComboBox x:Name="DemandSeriesPageSizeFilter"
                                                          SelectedIndex="2"
                                                          Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                          KeyboardNavigation.IsTabStop="True"
                                                           AutomationProperties.Name="每页数量"
                                                           AutomationProperties.AutomationId="DemandSeriesPageSizeFilter">
                                                    <ComboBoxItem Content="25" />
                                                    <ComboBoxItem Content="50" />
                                                    <ComboBoxItem Content="100" />
                                                    <ComboBoxItem Content="200" />
                                                </ComboBox>
                                            </StackPanel>
                                            <WrapPanel VerticalAlignment="Bottom" Margin="{StaticResource DemandSeriesGroupBottomMargin}">
                                                 <ui:Button x:Name="DemandSeriesApplyFiltersButton"
                                                            Content="应用条件"
                                                            Appearance="Secondary"
                                                            Margin="{StaticResource DemandSeriesCommandTrailingMargin}"
                                                            Click="OnDemandSeriesApplyFiltersClick"
                                                           KeyboardNavigation.IsTabStop="True"
                                                            AutomationProperties.Name="应用需求系列筛选"
                                                            AutomationProperties.AutomationId="DemandSeriesApplyFiltersButton" />
                                                 <ui:Button x:Name="DemandSeriesClearFiltersButton"
                                                            Content="清空条件"
                                                            Appearance="Secondary"
                                                            IsEnabled="False"
                                                            Click="OnDemandSeriesClearFiltersClick"
                                                           KeyboardNavigation.IsTabStop="True"
                                                            AutomationProperties.Name="清空需求系列筛选条件"
                                                            AutomationProperties.AutomationId="DemandSeriesClearFiltersButton" />
                                            </WrapPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DemandSeriesAllAreasConfirmPanel"
                                        Visibility="Collapsed"
                                        Margin="{StaticResource DemandSeriesSectionTopMargin}"
                                        AutomationProperties.Name="范围外对象切换确认">
                                    <StackPanel>
                                        <ui:InfoBar x:Name="DemandSeriesAllAreasConfirmInfo"
                                                    IsOpen="True"
                                                    IsClosable="False"
                                                    Severity="Warning"
                                                    Title="目标不在当前 AREA 范围"
                                                    Message="切换到“全部 AREA”会重新查询第一页和详情；不会改变 Host 业务投影或 Dispatch 范围。"
                                                    AutomationProperties.Name="范围外对象切换警告" />
                                         <ui:Button x:Name="DemandSeriesAllAreasConfirmButton"
                                                    Content="确认切换到全部 AREA"
                                                    Appearance="Secondary"
                                                    HorizontalAlignment="Left"
                                                    Margin="{StaticResource DemandSeriesActionTopMargin}"
                                                    Click="OnDemandSeriesAllAreasConfirmClick"
                                                   KeyboardNavigation.IsTabStop="True"
                                                    AutomationProperties.Name="确认切换到全部 AREA"
                                                    AutomationProperties.AutomationId="DemandSeriesAllAreasConfirmButton" />
                                    </StackPanel>
                                </Border>

                                <Grid x:Name="DemandSeriesMasterDetailGrid" Margin="{StaticResource DemandSeriesSectionTopMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="{StaticResource DemandSeriesSectionGap}" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="DemandSeriesMasterPanel"
                                            Grid.Row="0"
                                            Style="{StaticResource SurfaceCard}"
                                            AutomationProperties.Name="需求系列主列表">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="{StaticResource DemandSeriesMasterListHeight}" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <ui:TextBlock Text="当前范围内的 DemandSeries" Style="{StaticResource SectionTitleText}" />
                                                <ui:TextBlock x:Name="DemandSeriesOrderText"
                                                              Text="Host 固定排序：开始时间降序、SeriesId 升序；坏数据仍保留在运维列表中。"
                                                              Style="{StaticResource SecondaryText}"
                                                              Margin="{StaticResource DemandSeriesControlToGroupMargin}"
                                                              AutomationProperties.Name="需求系列固定排序" />
                                            </StackPanel>
                                            <Grid Grid.Row="1">
                                               <DataGrid x:Name="DemandSeriesGrid"
                                                      Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                         SelectionChanged="OnDemandSeriesSelectionChanged"
                                                      VerticalScrollBarVisibility="Auto"
                                                         AutomationProperties.Name="需求系列列表"
                                                         AutomationProperties.AutomationId="DemandSeriesGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="SeriesId" Binding="{Binding SeriesId}" Width="{StaticResource DemandSeriesColumn160}" />
                                                    <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="{StaticResource DemandSeriesColumn150}" />
                                                    <DataGridTextColumn Header="WorkType" Binding="{Binding WorkType}" Width="{StaticResource DemandSeriesColumn180}" />
                                                     <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                     <DataGridTemplateColumn Header="生命周期 / 当前出现" SortMemberPath="LifecycleAndPresence" Width="{StaticResource DemandSeriesColumn210}">
                                                         <DataGridTemplateColumn.CellTemplate>
                                                             <DataTemplate>
                                                                 <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding LifecycleAndPresence}">
                                                                     <ui:SymbolIcon Symbol="Pulse24" Margin="{StaticResource DemandSeriesCommandTrailingMargin}" />
                                                                     <TextBlock Text="{Binding LifecycleAndPresence}" VerticalAlignment="Center" />
                                                                 </StackPanel>
                                                             </DataTemplate>
                                                         </DataGridTemplateColumn.CellTemplate>
                                                     </DataGridTemplateColumn>
                                                     <DataGridTextColumn Header="当前 Demand" Binding="{Binding CurrentDemandId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                     <DataGridTextColumn Header="世代" Binding="{Binding CurrentGeneration}" Width="{StaticResource DemandSeriesColumn65}" />
                                                     <DataGridTextColumn Header="Demand 状态" Binding="{Binding CurrentDemandStatus}" Width="{StaticResource DemandSeriesColumn110}" />
                                                     <DataGridTextColumn Header="DemandLastSeenAt" Binding="{Binding DemandLastSeenAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                     <DataGridTextColumn Header="GoneConfirmedAt" Binding="{Binding GoneConfirmedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                     <DataGridTextColumn Header="ArchivedAt" Binding="{Binding ArchivedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                     <DataGridTextColumn Header="外部可读" Binding="{Binding ExternalReadabilityState}" Width="{StaticResource DemandSeriesColumn120}" />
                                                     <DataGridTextColumn Header="最后序列" Binding="{Binding LastSeriesSequence}" Width="{StaticResource DemandSeriesColumn90}" />
                                                     <DataGridTemplateColumn Header="相关关注" SortMemberPath="Attention" Width="{StaticResource DemandSeriesColumn260}">
                                                         <DataGridTemplateColumn.CellTemplate>
                                                             <DataTemplate>
                                                                 <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Attention}">
                                                                     <ui:SymbolIcon Symbol="Alert24" Margin="{StaticResource DemandSeriesCommandTrailingMargin}" />
                                                                     <TextBlock Text="{Binding Attention}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                 </StackPanel>
                                                             </DataTemplate>
                                                         </DataGridTemplateColumn.CellTemplate>
                                                     </DataGridTemplateColumn>
                                                     <DataGridTextColumn Header="PollTrace" Binding="{Binding LatestPollTraceId}" Width="{StaticResource DemandSeriesColumn160}" />
                                                     <DataGridTextColumn Header="ProjectionCommit" Binding="{Binding LatestProjectionCommitId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                 </DataGrid.Columns>
                                             </DataGrid>
                                                <ui:InfoBar x:Name="DemandSeriesEmptyState"
                                                            Visibility="Collapsed"
                                                            IsOpen="False"
                                                            IsClosable="False"
                                                            Severity="Informational"
                                                            Title="当前条件没有 DemandSeries"
                                                            Message="Host 已返回精确 0 个结果。可调整筛选；若这是跨 AREA 下钻，请使用上方显式范围确认。"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="需求系列空结果" />
                                            </Grid>
                                            <Border Grid.Row="2"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="{StaticResource DemandSeriesPagingDividerThickness}"
                                                    Padding="{StaticResource DemandSeriesPagingTopPadding}">
                                                <WrapPanel>
                                                    <ui:TextBlock x:Name="DemandSeriesPageSummaryText"
                                                                  Text="精确 0 个 Series · 第 1 / 1 页"
                                                                  Style="{StaticResource SecondaryText}"
                                                                  MinWidth="{StaticResource DemandSeriesPageSummaryMinWidth}"
                                                                  Margin="{StaticResource DemandSeriesPagingSummaryMargin}"
                                                                  AutomationProperties.Name="需求系列精确分页摘要" />
                                                     <ui:Button x:Name="DemandSeriesPreviousButton"
                                                               Content="上一页"
                                                               Appearance="Secondary"
                                                                IsEnabled="False"
                                                                Click="OnDemandSeriesPreviousClick"
                                                               Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                               KeyboardNavigation.IsTabStop="True"
                                                                AutomationProperties.Name="需求系列上一页"
                                                                AutomationProperties.AutomationId="DemandSeriesPreviousButton" />
                                                     <TextBox x:Name="DemandSeriesPageNumberInput"
                                                             Text="1"
                                                             Width="{StaticResource DemandSeriesPageNumberWidth}"
                                                             Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                             HorizontalContentAlignment="Center"
                                                             KeyboardNavigation.IsTabStop="True"
                                                             AutomationProperties.Name="需求系列页码"
                                                             AutomationProperties.AutomationId="DemandSeriesPageNumberInput" />
                                                     <ui:Button x:Name="DemandSeriesGoToPageButton"
                                                               Content="跳转"
                                                                Appearance="Secondary"
                                                                Click="OnDemandSeriesGoToPageClick"
                                                               Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                               KeyboardNavigation.IsTabStop="True"
                                                                AutomationProperties.Name="跳转到需求系列页码"
                                                                AutomationProperties.AutomationId="DemandSeriesGoToPageButton" />
                                                     <ui:Button x:Name="DemandSeriesNextButton"
                                                               Content="下一页"
                                                               Appearance="Secondary"
                                                                IsEnabled="False"
                                                                Click="OnDemandSeriesNextClick"
                                                               Margin="{StaticResource DemandSeriesCompactCommandLastMargin}"
                                                               KeyboardNavigation.IsTabStop="True"
                                                                AutomationProperties.Name="需求系列下一页"
                                                                AutomationProperties.AutomationId="DemandSeriesNextButton" />
                                                </WrapPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="DemandSeriesDetailPanel"
                                            Grid.Row="2"
                                            Style="{StaticResource SurfaceCard}"
                                            AutomationProperties.Name="需求系列详情与证据">
                                        <StackPanel>
                                            <ui:TextBlock x:Name="DemandSeriesDetailHeadingText"
                                                          Text="选择一个需求系列以查看详情"
                                                          Style="{StaticResource SectionTitleText}"
                                                          AutomationProperties.Name="选中需求系列详情" />
                                             <ui:TextBlock Text="详情与列表绑定同一 SnapshotReference；新轮次不会改写当前证据。"
                                                          Style="{StaticResource SecondaryText}"
                                                           Margin="{StaticResource DemandSeriesControlToGroupMargin}" />
                                            <ui:TextBlock x:Name="DemandSeriesDetailFactsText"
                                                          Text="选择后显示 Series 生命周期时间与创建证据。"
                                                          Style="{StaticResource SecondaryText}"
                                                          Margin="{StaticResource DemandSeriesGroupBottomMargin}"
                                                          AutomationProperties.Name="需求系列生命周期与来源证据" />
                                            <WrapPanel Margin="{StaticResource DemandSeriesGroupBottomMargin}">
                                                 <ui:Button x:Name="DemandSeriesCopyTimeButton"
                                                           Content="复制时间"
                                                           Appearance="Secondary"
                                                            IsEnabled="False"
                                                            Click="OnDemandSeriesCopyTimeClick"
                                                           Margin="{StaticResource DemandSeriesCommandTileMargin}"
                                                           KeyboardNavigation.IsTabStop="True"
                                                            AutomationProperties.Name="复制需求系列时间"
                                                            AutomationProperties.AutomationId="DemandSeriesCopyTimeButton" />
                                                 <ui:Button x:Name="DemandSeriesCopyEvidenceButton"
                                                           Content="复制证据"
                                                           Appearance="Secondary"
                                                            IsEnabled="False"
                                                            Click="OnDemandSeriesCopyEvidenceClick"
                                                           Margin="{StaticResource DemandSeriesCommandTileMargin}"
                                                           KeyboardNavigation.IsTabStop="True"
                                                            AutomationProperties.Name="复制需求系列证据"
                                                            AutomationProperties.AutomationId="DemandSeriesCopyEvidenceButton" />
                                            </WrapPanel>

                                             <TabControl x:Name="DemandSeriesEvidenceTabs"
                                                        MinHeight="{StaticResource DemandSeriesEvidenceMinHeight}"
                                                        Focusable="True"
                                                        KeyboardNavigation.IsTabStop="True"
                                                        AutomationProperties.Name="需求系列详情证据类别"
                                                        AutomationProperties.AutomationId="DemandSeriesEvidenceTabs">
                                                <TabItem Header="Demand 世代"
                                                         AutomationProperties.Name="Demand 世代与生命周期">
                                                       <DataGrid x:Name="DemandSeriesGenerationGrid"
                                                              Height="{StaticResource DemandSeriesGenerationHeight}"
                                                              Margin="{StaticResource DemandSeriesContentMargin}"
                                                              Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                                 SelectionChanged="OnDemandSeriesGenerationSelectionChanged"
                                                                 AutomationProperties.Name="Demand 世代关系"
                                                                 AutomationProperties.AutomationId="DemandSeriesGenerationGrid">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="代" Binding="{Binding Generation}" Width="{StaticResource DemandSeriesColumn55}" />
                                                            <DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                            <DataGridTextColumn Header="Predecessor" Binding="{Binding PredecessorDemandId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="{StaticResource DemandSeriesColumn90}" />
                                                            <DataGridTextColumn Header="创建" Binding="{Binding CreatedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                             <DataGridTextColumn Header="DemandLastSeenAt" Binding="{Binding DemandLastSeenAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                             <DataGridTextColumn Header="GoneConfirmedAt" Binding="{Binding GoneConfirmedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                             <DataGridTextColumn Header="外部可读" Binding="{Binding ExternalReadabilityState}" Width="{StaticResource DemandSeriesColumn120}" />
                                                             <DataGridTextColumn Header="资格阻断" Binding="{Binding ReadabilitySummary}" Width="{StaticResource DemandSeriesColumn240}" />
                                                             <DataGridTextColumn Header="可信 MES" Binding="{Binding LiveMesSummary}" Width="{StaticResource DemandSeriesColumn330}" />
                                                             <DataGridTextColumn Header="创建 PollTrace" Binding="{Binding CreatedPollTraceId}" Width="{StaticResource DemandSeriesColumn160}" />
                                                             <DataGridTextColumn Header="创建 ProjectionCommit" Binding="{Binding CreatedProjectionCommitId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                             <DataGridTextColumn Header="最近观测" Binding="{Binding LatestObservationAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                             <DataGridTextColumn Header="观测 PollTrace" Binding="{Binding LatestObservationPollTraceId}" Width="{StaticResource DemandSeriesColumn160}" />
                                                             <DataGridTextColumn Header="观测 ProjectionCommit" Binding="{Binding LatestObservationProjectionCommitId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                         </DataGrid.Columns>
                                                    </DataGrid>
                                                </TabItem>
                                                <TabItem Header="MES 事实与原始观测"
                                                         AutomationProperties.Name="实时 MES 事实与原始观测">
                                                    <Grid Margin="{StaticResource DemandSeriesContentMargin}">
                                                         <Grid.RowDefinitions>
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="{StaticResource DemandSeriesMesObservationHeight}" />
                                                             <RowDefinition Height="Auto" />
                                                         </Grid.RowDefinitions>
                                                         <ui:TextBlock Text="LiveMesFieldSet 只代表唯一可信观测；重复行按原始形态逐条保留。"
                                                                       Style="{StaticResource SecondaryText}"
                                                                       Margin="{StaticResource DemandSeriesRelatedBottomMargin}" />
                                                        <ui:TextBlock x:Name="DemandSeriesLiveMesFieldsText"
                                                                      Grid.Row="1"
                                                                      Text="选择 Demand 后显示唯一可信 LiveMesFieldSet。"
                                                                      Style="{StaticResource FieldLabel}"
                                                                      TextWrapping="Wrap"
                                                                      Margin="{StaticResource DemandSeriesRelatedBottomMargin}"
                                                                      AutomationProperties.Name="可信 LiveMesFieldSet" />
                                                        <ui:TextBlock x:Name="DemandSeriesObservationSummaryText"
                                                                      Grid.Row="2"
                                                                      Text="尚无 Demand 原始观测摘要。"
                                                                      Style="{StaticResource SecondaryText}"
                                                                      Margin="{StaticResource DemandSeriesMicroBottomMargin}"
                                                                      AutomationProperties.Name="MES 原始观测摘要" />
                                                        <ui:TextBlock x:Name="DemandSeriesReadabilityBlockersText"
                                                                      Grid.Row="3"
                                                                      Text="尚无当前 Demand 资格结论。"
                                                                      Style="{StaticResource SecondaryText}"
                                                                      Margin="{StaticResource DemandSeriesRelatedBottomMargin}"
                                                                      AutomationProperties.Name="当前 Demand 资格阻断" />
                                                         <DataGrid x:Name="DemandSeriesRawObservationGrid"
                                                                  Grid.Row="4"
                                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                                   AutomationProperties.Name="MES 原始观测"
                                                                   AutomationProperties.AutomationId="DemandSeriesRawObservationGrid">
                                                             <DataGrid.Columns>
                                                                 <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="{StaticResource DemandSeriesColumn45}" />
                                                                 <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment}" Width="{StaticResource DemandSeriesColumn110}" />
                                                                 <DataGridTextColumn Header="SeriesId" Binding="{Binding SeriesId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="WorkType" Binding="{Binding WorkType}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="{StaticResource DemandSeriesColumn160}" />
                                                                 <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="{StaticResource DemandSeriesColumn100}" />
                                                                <DataGridTextColumn Header="EQP" Binding="{Binding Eqp}" Width="{StaticResource DemandSeriesColumn120}" />
                                                                <DataGridTextColumn Header="STEP" Binding="{Binding Step}" Width="{StaticResource DemandSeriesColumn140}" />
                                                                 <DataGridTextColumn Header="DATES / MesSourceDate" Binding="{Binding MesSourceDate}" Width="{StaticResource DemandSeriesColumn190}" />
                                                                 <DataGridTextColumn Header="MesSourceDateRaw" Binding="{Binding MesSourceDateRaw}" Width="{StaticResource DemandSeriesColumn190}" />
                                                                <DataGridTextColumn Header="PACKAGE" Binding="{Binding Package}" Width="{StaticResource DemandSeriesColumn130}" />
                                                                <DataGridTextColumn Header="ObservedAt" Binding="{Binding ObservedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                                <DataGridTextColumn Header="PollTrace" Binding="{Binding PollTraceId}" Width="{StaticResource DemandSeriesColumn160}" />
                                                                <DataGridTextColumn Header="ProjectionCommit" Binding="{Binding ProjectionCommitId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <ui:TextBlock Grid.Row="5"
                                                                      Text="DATES 明确显示为 MES 源字段 MesSourceDate，不作为生命周期发生时间。"
                                                                      Style="{StaticResource SecondaryText}"
                                                                      Margin="{StaticResource DemandSeriesControlTopMargin}" />
