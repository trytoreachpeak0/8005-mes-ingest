                                                    <ComboBoxItem Content="25"><ComboBoxItem.Tag><sys:Int32>25</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="50"><ComboBoxItem.Tag><sys:Int32>50</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="100"><ComboBoxItem.Tag><sys:Int32>100</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="200"><ComboBoxItem.Tag><sys:Int32>200</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>
                                            <ui:Button x:Name="CurrentAttentionApplyFilterButton"
                                                       Grid.Column="6"
                                                       Content="应用条件"
                                                       Appearance="Secondary"
