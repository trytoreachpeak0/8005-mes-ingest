                                                         </DataGrid>
                                                         <ui:TextBlock Grid.Row="4" Text="选中期间的永久证据" Style="{StaticResource FieldLabel}" Margin="{StaticResource DemandSeriesSubsectionHeadingMargin}" />
                                                         <DataGrid x:Name="DemandSeriesErrorEvidenceGrid"
                                                                   Grid.Row="5"
                                                                   Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                                   AutomationProperties.Name="需求系列错误期间永久证据"
                                                                   AutomationProperties.AutomationId="DemandSeriesErrorEvidenceGrid">
                                                             <DataGrid.Columns>
                                                                 <DataGridTextColumn Header="EvidenceId" Binding="{Binding EvidenceId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="类型" Binding="{Binding EvidenceKind}" Width="{StaticResource DemandSeriesColumn160}" />
                                                                 <DataGridTextColumn Header="ObservedAt" Binding="{Binding ObservedAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                                 <DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="观测值" Binding="{Binding ObservedValue}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="期望规则" Binding="{Binding ExpectedRule}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="PollTrace" Binding="{Binding PollTraceId}" Width="{StaticResource DemandSeriesColumn160}" />
                                                                 <DataGridTextColumn Header="ProjectionCommit" Binding="{Binding ProjectionCommitId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                             </DataGrid.Columns>
                                                         </DataGrid>
                                                     </Grid>
                                                </TabItem>
                                                <TabItem Header="永久事件与轮次证据"
                                                         AutomationProperties.Name="永久事件与 PollTrace ProjectionCommit 证据">
                                                    <Grid Margin="{StaticResource DemandSeriesContentMargin}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="{StaticResource DemandSeriesEventHeight}" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                         <DataGrid x:Name="DemandSeriesEventGrid"
                                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                                   AutomationProperties.Name="需求系列永久事件与轮次证据"
                                                                   AutomationProperties.AutomationId="DemandSeriesEventGrid">
                                                            <DataGrid.Columns>
                                                                 <DataGridTextColumn Header="SEQ" Binding="{Binding SeriesSequence}" Width="{StaticResource DemandSeriesColumn65}" />
                                                                 <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="{StaticResource DemandSeriesColumn210}" />
                                                                 <DataGridTextColumn Header="发生时间" Binding="{Binding OccurredAt}" Width="{StaticResource DemandSeriesColumn170}" />
                                                                 <DataGridTextColumn Header="主体类型" Binding="{Binding SubjectKind}" Width="{StaticResource DemandSeriesColumn150}" />
                                                                 <DataGridTextColumn Header="主体 ID" Binding="{Binding SubjectId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="PollTrace" Binding="{Binding PollTraceId}" Width="{StaticResource DemandSeriesColumn160}" />
                                                                 <DataGridTextColumn Header="ProjectionCommit" Binding="{Binding ProjectionCommitId}" Width="{StaticResource DemandSeriesColumn180}" />
                                                                 <DataGridTextColumn Header="Payload" Binding="{Binding PayloadJson}" Width="{StaticResource DemandSeriesColumn300}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <ui:TextBlock Grid.Row="1"
                                                                      Text="事件按 SeriesSequence 固定排序；PollTrace 与 ProjectionCommit 可追到轮次证据。"
                                                                      Style="{StaticResource SecondaryText}"
                                                                      Margin="{StaticResource DemandSeriesControlTopMargin}" />
                                                    </Grid>
                                                </TabItem>
                                            </TabControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="ReadabilityAuditPage" Visibility="Collapsed" AutomationProperties.Name="资格审计页面">
                        <StackPanel><ui:TextBlock Text="资格审计" Style="{StaticResource PageTitleText}" /><ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="页面宿主已就绪" Message="审计列表尚未在此版本启用；来自概览的第一页筛选意图已完整保留。" Margin="{StaticResource DemandSeriesSectionTopMargin}" /></StackPanel>
                    </Grid>
                    <Grid x:Name="ErrorSearchPage" Visibility="Collapsed" AutomationProperties.Name="错误检索页面">
                        <StackPanel><ui:TextBlock Text="错误检索" Style="{StaticResource PageTitleText}" /><ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="页面宿主已就绪" Message="错误检索尚未在此版本启用；来自概览的第一页筛选意图已完整保留。" Margin="{StaticResource DemandSeriesSectionTopMargin}" /></StackPanel>
                    </Grid>
                    <Grid x:Name="AreaFilterPage" Visibility="Collapsed" AutomationProperties.Name="AREA 筛选页面">
                        <StackPanel><ui:TextBlock Text="AREA 筛选" Style="{StaticResource PageTitleText}" /><ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="本机上下文已与 Host 快照分离" Message="AREA 配置编辑尚未在此版本启用；概览始终单独显示本机选择与 Host 已提交范围。" Margin="{StaticResource DemandSeriesSectionTopMargin}" /></StackPanel>
                    </Grid>
                    <Grid x:Name="CurrentAttentionPage" Visibility="Collapsed" AutomationProperties.Name="接入告警页面">
                        <StackPanel><ui:TextBlock Text="接入告警" Style="{StaticResource PageTitleText}" /><ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="页面宿主已就绪" Message="接入关注列表尚未在此版本启用；来自概览的第一页筛选意图已完整保留。" Margin="{StaticResource DemandSeriesSectionTopMargin}" /></StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="设置页面">
                        <StackPanel Margin="{StaticResource DemandSeriesCommandTileMargin}">
                            <ui:TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
                            <ui:TextBlock Text="单一 Host、始终开启的分视图自动刷新，以及本机显示偏好" Style="{StaticResource SecondaryText}" Margin="{StaticResource DemandSeriesControlTopMargin}" />
                            <ui:InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" Margin="{StaticResource DemandSeriesSectionTopMargin}" AutomationProperties.Name="设置操作状态" />

                            <Grid x:Name="SettingsColumns" Margin="{StaticResource DemandSeriesSectionTopMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="SettingsVerticalGap" Height="0" />
                                    <RowDefinition x:Name="SettingsBottomRow" Height="0" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SettingsLeftColumn" Width="1*" />
                                    <ColumnDefinition x:Name="SettingsGapColumn" Width="16" />
                                    <ColumnDefinition x:Name="SettingsRightColumn" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource SurfaceCard}">
                                        <StackPanel>
                                            <ui:TextBlock Text="Host 连接" Style="{StaticResource SectionTitleText}" />
                                            <ui:TextBlock x:Name="SettingsHostStateText" Text="Host 未连接" Style="{StaticResource SecondaryText}" Margin="0,8,0,16" />
                                            <ui:TextBlock Text="服务地址" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="HostBaseUrlInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="Host 基址" />
                                            <ui:TextBlock Text="访问凭据" Style="{StaticResource FieldLabel}" />
                                            <PasswordBox x:Name="HostCredentialInput" PasswordChar="●" Padding="12,8" Margin="0,8,0,8" AutomationProperties.Name="只读 API 凭据" />
                                            <ui:TextBlock Text="留空继续使用当前外部配置凭据；输入值仅用于本次进程，保存后立即清空。" Style="{StaticResource SecondaryText}" />
                                            <ui:TextBlock Text="请求超时（秒）" Style="{StaticResource FieldLabel}" Margin="{StaticResource DemandSeriesActionTopMargin}" />
                                            <TextBox x:Name="RequestTimeoutInput" Width="120" HorizontalAlignment="Left" Margin="{StaticResource DemandSeriesControlTopMargin}" ToolTip="1–300 秒" AutomationProperties.Name="全局请求超时秒数" />
                                            <ui:Button x:Name="ApplyHostButton" Content="应用 Host 设置" Appearance="Secondary" HorizontalAlignment="Right" Margin="{StaticResource DemandSeriesSectionTopMargin}" Click="OnApplyHostClick" AutomationProperties.Name="应用 Host 设置" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SurfaceCard}" Margin="{StaticResource DemandSeriesSectionTopMargin}">
                                        <StackPanel>
                                            <ui:TextBlock Text="本机显示" Style="{StaticResource SectionTitleText}" />
                                            <CheckBox x:Name="RememberWindowSizeCheckBox" Content="记住窗口尺寸" Margin="{StaticResource DemandSeriesActionTopMargin}" AutomationProperties.Name="记住窗口尺寸" />
                                            <CheckBox x:Name="KeepNavigationPaneOpenCheckBox" Content="默认展开导航窗格" Margin="{StaticResource DemandSeriesControlTopMargin}" AutomationProperties.Name="默认展开导航窗格" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="RefreshSettingsCard" Grid.Column="2" Style="{StaticResource SurfaceCard}">
                                    <StackPanel>
                                        <ui:TextBlock Text="自动刷新间隔" Style="{StaticResource SectionTitleText}" />
                                        <ui:TextBlock Text="五个 Host 数据视图始终自动刷新；当前可见视图按所选间隔单飞调度。" Style="{StaticResource SecondaryText}" Margin="0,8,0,16" />
                                        <ui:TextBlock Text="概览" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="OverviewIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="概览自动刷新间隔" />
                                        <ui:TextBlock Text="需求系列" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="DemandSeriesIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="需求系列自动刷新间隔" />
                                        <ui:TextBlock Text="资格审计" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ReadabilityAuditIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="资格审计自动刷新间隔" />
                                        <ui:TextBlock Text="错误检索" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ErrorSearchIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="错误检索自动刷新间隔" />
                                        <ui:TextBlock Text="接入告警" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CurrentAttentionIntervalInput" Margin="{StaticResource DemandSeriesControlTopMargin}" AutomationProperties.Name="接入告警自动刷新间隔" />
                                        <ui:Button x:Name="SaveRefreshIntervalsButton" Content="保存刷新与显示设置" Appearance="Secondary" HorizontalAlignment="Right" Margin="{StaticResource DemandSeriesSectionTopMargin}" Click="OnSaveLocalPreferencesClick" AutomationProperties.Name="保存刷新与显示设置" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
