                                            <ui:Button x:Name="CurrentAttentionNextPageButton"
                                                       Content="下一页"
                                                       Appearance="Secondary"
                                                       Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                       Focusable="True"
                                                       KeyboardNavigation.IsTabStop="True"
                                                       Click="OnCurrentAttentionNextPageClick"
                                                       AutomationProperties.Name="接入告警下一页"
