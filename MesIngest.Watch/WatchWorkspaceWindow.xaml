                                               Appearance="Transparent"
                                               Padding="0"
                                               MinWidth="32"
                                               MinHeight="32"
                                               Margin="0,0,8,0"
                                               Click="OnFaultStatusClick">
                                        <Border x:Name="CurrentAttentionFaultStatusPill" Style="{StaticResource StatusPillCritical}">
                                            <ui:TextBlock x:Name="CurrentAttentionFaultStatusText" Text="错误 · 1 个故障" FontTypography="BodyStrong" />
                                        </Border>
                                    </ui:Button>
                                    <Border x:Name="CurrentAttentionHeaderStatusPill"
                                            Style="{StaticResource StatusPill}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="接入告警状态：尚无快照">
                                        <ui:TextBlock x:Name="CurrentAttentionHeaderStatusText"
                                                      Text="尚无快照"
                                                      FontTypography="BodyStrong" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="CurrentAttentionContractFactsPanel"
                                        Grid.Row="2">
                                <Border Padding="10,6"
                                        CornerRadius="4"
