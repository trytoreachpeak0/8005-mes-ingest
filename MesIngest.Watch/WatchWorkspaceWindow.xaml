                                                        <DataGridTextColumn Header="严重度" Binding="{Binding Value}" Width="*" />
                                                        <DataGridTextColumn Header="数量" Binding="{Binding ItemCount}" Width="{StaticResource DemandSeriesColumn65}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Expander>
                                    </Grid>
