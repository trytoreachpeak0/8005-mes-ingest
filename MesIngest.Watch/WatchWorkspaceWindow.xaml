<ui:FluentWindow x:Class="MesIngest.Watch.WatchWorkspaceWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:wpf="clr-namespace:System.Windows;assembly=WindowsBase"
                 xmlns:wpfControls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
                 xmlns:local="clr-namespace:MesIngest.Watch"
                 Title="MesIngest Watch"
                 Width="{x:Static local:WatchWindowLayoutTokens.MainDefaultWidth}"
                 Height="{x:Static local:WatchWindowLayoutTokens.MainDefaultHeight}"
                 MinWidth="{x:Static local:WatchWindowLayoutTokens.MinimumWidth}"
                 MinHeight="{x:Static local:WatchWindowLayoutTokens.MinimumHeight}"
                 ResizeMode="CanResize"
                 WindowStyle="SingleBorderWindow"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Segoe UI Variable, Microsoft YaHei UI"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 SizeChanged="OnWindowSizeChanged">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WatchFluentDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <!-- DemandSeries production dimensions are semantic resources so the 19–22
             integration train can calibrate them once without hunting literals. -->
        <sys:Double x:Key="DemandSeriesFilterWideWidth">148</sys:Double>
        <sys:Double x:Key="DemandSeriesFilterPresenceWidth">132</sys:Double>
        <sys:Double x:Key="DemandSeriesFilterPageSizeWidth">76</sys:Double>
        <sys:Double x:Key="DemandSeriesPageNumberWidth">112</sys:Double>
        <sys:Double x:Key="DemandSeriesPageSummaryMinWidth">230</sys:Double>
        <sys:Double x:Key="DemandSeriesMasterPanelMinHeight">260</sys:Double>
        <wpf:GridLength x:Key="DemandSeriesAutoHeight">Auto</wpf:GridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumnSizeToCells">SizeToCells</wpfControls:DataGridLength>
        <sys:Double x:Key="DemandSeriesSeriesIdColumnMinWidth">120</sys:Double>
        <sys:Double x:Key="DemandSeriesWorkTypeColumnMinWidth">165</sys:Double>
        <sys:Double x:Key="DemandSeriesSublotColumnMinWidth">125</sys:Double>
        <sys:Double x:Key="DemandSeriesLifecycleColumnMinWidth">180</sys:Double>
        <sys:Double x:Key="DemandSeriesAreaColumnMinWidth">100</sys:Double>
        <sys:Double x:Key="DemandSeriesDemandColumnMinWidth">160</sys:Double>
        <sys:Double x:Key="DemandSeriesCompactColumnMinWidth">72</sys:Double>
        <sys:Double x:Key="DemandSeriesTimeColumnMinWidth">160</sys:Double>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn45">45</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn65">65</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn90">90</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn100">100</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn120">120</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn130">130</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn150">150</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn160">160</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn170">170</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn180">180</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn190">190</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn230">230</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn240">240</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn260">260</wpfControls:DataGridLength>
        <wpf:Thickness x:Key="DemandSeriesPageBodyMargin">0,0,8,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesSectionTopMargin">0,16,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesControlTopMargin">0,8,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesControlToGroupMargin">0,8,0,12</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesFilterFieldMargin">0,0,8,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesGroupBottomMargin">0,0,0,12</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesRelatedBottomMargin">0,0,0,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCommandTrailingMargin">0,0,8,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCommandTileMargin">0,0,8,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesActionTopMargin">0,12,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesSubsectionHeadingMargin">0,12,0,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCompactCommandMargin">0,4,8,4</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCompactCommandLastMargin">0,4,0,4</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesPagingSummaryMargin">0,8,16,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesPagingDividerThickness">0,1,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesInfoContentMargin">0,8,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesInfoSummaryMargin">0,4,12,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesMasterHeaderMargin">16,12</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesHeadingSubtitleMargin">0,4,0,0</wpf:Thickness>
        <!-- ReadabilityAudit and AREA page geometry stays tokenized so the shared
             integration train can calibrate the two master-detail workspaces. -->
        <sys:Double x:Key="ReadabilityStateFilterWidth">165</sys:Double>
        <sys:Double x:Key="ReadabilityWorkTypeFilterWidth">165</sys:Double>
        <sys:Double x:Key="ReadabilityBlockerFilterWidth">155</sys:Double>
        <sys:Double x:Key="ReadabilityTextFilterWidth">180</sys:Double>
        <sys:Double x:Key="ReadabilityPageSizeWidth">80</sys:Double>
        <sys:Double x:Key="ReadabilityFacetGridHeight">112</sys:Double>
        <sys:Double x:Key="ReadabilityAuditGridMinHeight">270</sys:Double>
        <sys:Double x:Key="ReadabilityQualificationGridMinHeight">190</sys:Double>
        <sys:Double x:Key="ReadabilityEvidenceGridMinHeight">210</sys:Double>
        <sys:Double x:Key="AreaProfileListMinHeight">300</sys:Double>
        <sys:Double x:Key="AreaProfileEditorMinHeight">260</sys:Double>
        <sys:Double x:Key="AreaProfileValidationGridMinHeight">120</sys:Double>
        <sys:Double x:Key="AreaProfileOperationTargetMinWidth">100</sys:Double>
        <sys:Double x:Key="ReadabilityMasterDetailStackBreakpoint">1080</sys:Double>
        <sys:Double x:Key="AreaProfileMasterDetailStackBreakpoint">900</sys:Double>
        <wpf:GridLength x:Key="WatchCollapsedGridLength">0</wpf:GridLength>
        <wpf:GridLength x:Key="WatchMasterDetailGapWidth">16</wpf:GridLength>
        <wpf:GridLength x:Key="ReadabilityMasterColumnWidth">430</wpf:GridLength>
        <wpf:GridLength x:Key="ReadabilityFacetGapWidth">12</wpf:GridLength>
        <wpf:GridLength x:Key="AreaProfileMasterColumnWidth">318</wpf:GridLength>
        <wpf:GridLength x:Key="AreaProfileOperationPanelGapHeight">8</wpf:GridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn45">45</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn80">80</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn90">90</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn100">100</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn120">120</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn130">130</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn160">160</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn170">170</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn180">180</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn220">220</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn240">240</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="AreaProfileDiagnosticLineColumnWidth">60</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="AreaProfileDiagnosticCodeColumnWidth">180</wpfControls:DataGridLength>
        <wpf:Thickness x:Key="WatchPageCardPadding">16</wpf:Thickness>
        <wpf:Thickness x:Key="AreaProfileListMargin">0,12,0,12</wpf:Thickness>
        <!-- The editor's text inset. It sits on the content presenter rather
             than on the TextBox padding so the scroll bars can lie flush with
             the editor frame. The top inset matches the line-number gutter; the
             right and bottom ones are wide enough for a bar to lie in without
             covering text. -->
        <wpf:Thickness x:Key="AreaProfileEditorTextInset">12,10,16,16</wpf:Thickness>
        <wpf:Thickness x:Key="AreaProfileInlineCommandMargin">8,0,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="AreaProfileOperationPanelMargin">16,12,16,0</wpf:Thickness>
        <wpf:Thickness x:Key="AreaProfileOperationPanelPadding">12,8</wpf:Thickness>
        <wpf:CornerRadius x:Key="AreaProfileOperationPanelCornerRadius">4</wpf:CornerRadius>
        <!-- Ticket 22 keeps the two production workspaces on the shared 8/12/16/24
             rhythm. Named geometry is intentionally adjusted by the window's
             responsive reflow instead of introducing page-only visual paths. -->
        <sys:Double x:Key="Ticket22FacetGridHeight">112</sys:Double>
        <sys:Double x:Key="Ticket22ResultsGridMinHeight">320</sys:Double>
        <sys:Double x:Key="Ticket22DetailGridHeight">176</sys:Double>
        <sys:Double x:Key="Ticket22RawGridHeight">176</sys:Double>
        <sys:Double x:Key="ErrorSearchInlineFilterMinimumWidth">677</sys:Double>
        <wpf:GridLength x:Key="Ticket22CardGap">12</wpf:GridLength>
        <wpf:GridLength x:Key="ErrorSearchCategoryColumnWidth">244</wpf:GridLength>
        <wpf:GridLength x:Key="ErrorSearchDetailColumnWidth">370</wpf:GridLength>
        <wpf:GridLength x:Key="CurrentAttentionMasterColumnWidth">520</wpf:GridLength>
        <sys:Double x:Key="Ticket22ThreeCardStackBreakpoint">1072</sys:Double>
        <Style x:Key="NotificationFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-2"
                                BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DemandSeriesReadOnlyGrid"
               TargetType="DataGrid"
               BasedOn="{StaticResource WatchDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        </Style>
        <Style x:Key="DemandSeriesUntrimmedTextCell"
               TargetType="TextBlock"
               BasedOn="{StaticResource DataGridTextCell}">
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Title="MesIngest Watch"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     Loaded="OnWindowTitleBarLoaded">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Pulse24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="WorkspaceNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="LeftMinimal"
                           CompactPaneLength="48"
                           OpenPaneLength="224"
                           IsPaneOpen="False"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           HeaderVisibility="Collapsed"
                           Loaded="OnWorkspaceNavigationLoaded"
                           AutomationProperties.Name="主导航">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="OverviewNavigationItem"
                                       Content="概览"
                                       IsActive="True"
                                       Click="OnOverviewNavigationClick"
                                       AutomationProperties.Name="概览导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="DemandSeriesNavigationItem"
                                       Content="需求系列"
                                       Click="OnDemandSeriesNavigationClick"
                                       AutomationProperties.Name="需求系列导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Timeline24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="ReadabilityAuditNavigationItem"
                                       Content="资格审计"
                                       Click="OnReadabilityAuditNavigationClick"
                                       AutomationProperties.Name="资格审计导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DocumentBulletList24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="ErrorSearchNavigationItem"
                                       Content="错误检索"
                                       Click="OnErrorSearchNavigationClick"
                                       AutomationProperties.Name="错误检索导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Search24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="AreaFilterNavigationItem"
                                       Content="AREA 筛选"
                                       Click="OnAreaFilterNavigationClick"
                                       AutomationProperties.Name="AREA 筛选导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Filter24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="CurrentAttentionNavigationItem"
                                       Content="接入告警"
                                       Click="OnCurrentAttentionNavigationClick"
                                       AutomationProperties.Name="接入告警导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Alert24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="HostNavigationItem"
                                       Content="Host 未连接"
                                       ToolTip="Host 尚未连接"
                                       Click="OnSettingsNavigationClick"
                                       AutomationProperties.Name="Host 状态与连接设置">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon x:Name="HostNavigationIcon" Symbol="CloudOff24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                       Content="设置"
                                       Click="OnSettingsNavigationClick"
                                       AutomationProperties.Name="设置导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="WorkspaceContent" Margin="24,16,24,16">
                    <ScrollViewer x:Name="OverviewPage"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="概览页面">
                        <Grid x:Name="OverviewLayoutGrid"
                              MinHeight="{Binding ActualHeight, ElementName=OverviewPage}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock Text="概览" Style="{StaticResource PageTitleText}" />
                                    <ui:TextBlock x:Name="OverviewContextText"
                                                  Text="等待 Host 连接"
                                                  Style="{StaticResource SecondaryText}"
                                                  Margin="0,3,0,0"
                                                  AutomationProperties.Name="概览快照与客户端读取时间" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="OverviewFaultStatusButton"
                                               Visibility="Collapsed"
                                               Appearance="Transparent"
                                               Padding="0"
                                               MinWidth="32"
                                               MinHeight="32"
                                               Margin="0,0,8,0"
                                               Click="OnFaultStatusClick">
                                        <Border x:Name="OverviewFaultStatusPill" Style="{StaticResource StatusPillCritical}">
                                            <ui:TextBlock x:Name="OverviewFaultStatusText" Text="错误 · 1 个故障" FontTypography="BodyStrong" />
                                        </Border>
                                    </ui:Button>
                                    <Border x:Name="OverviewHostStatusPill"
                                            Style="{StaticResource StatusPill}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="概览 Host 状态">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon x:Name="OverviewHostStatusIcon" Symbol="CloudOff24" />
                                            <ui:TextBlock x:Name="OverviewHostStatusText"
                                                          Text="Host 未连接"
                                                          FontTypography="BodyStrong"
                                                          Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <ui:InfoBar x:Name="OverviewInfoBar"
                                        Grid.Row="2"
                                        IsOpen="False"
                                        IsClosable="False"
                                        Severity="Informational"
                                        AutomationProperties.Name="概览读取状态" />

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="OverviewSummaryRow" Height="174" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="OverviewSummaryViewport">
                                    <UniformGrid x:Name="OverviewSummaryCards" Columns="5" Margin="-5,-6">
                                    <UniformGrid.Resources>
                                        <Style x:Key="OverviewSubsummaryIntentButton"
                                               TargetType="ui:Button"
                                               BasedOn="{StaticResource InlineIntentButton}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="24" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </UniformGrid.Resources>
                                    <Border x:Name="SeriesSummaryCard" Style="{StaticResource SummaryCard}" Margin="5,6" MinHeight="174">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Timeline24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><ui:TextBlock Text="需求系列" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel>
                                                <ui:Button x:Name="SeriesSummaryAction" Grid.Column="1" Content="查看 →" Style="{StaticResource InlineIntentButton}" Click="OnOverviewIntentClick" AutomationProperties.Name="查看全部需求系列第一页" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="SeriesSummaryValue" Text="—" Style="{StaticResource OverviewPrimaryMetric}" /><ui:TextBlock x:Name="SeriesSummaryDetail" Text="等待 Host 概览" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ReadabilitySummaryCard" Style="{StaticResource SummaryCard}" Margin="5,6" MinHeight="174">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><ui:TextBlock Text="资格审计" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel><ui:Button x:Name="ReadabilitySummaryAction" Grid.Column="1" Content="查看 →" Style="{StaticResource InlineIntentButton}" Click="OnOverviewIntentClick" AutomationProperties.Name="查看全部资格审计第一页" /></Grid>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="ReadabilitySummaryValue" Text="—" Style="{StaticResource OverviewRatioMetric}" /><ui:TextBlock x:Name="ReadabilitySummaryDetail" Text="等待 Host 概览" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel>
                                            <WrapPanel Grid.Row="2"><ui:Button x:Name="ReadableSummaryAction" Content="可读" Style="{StaticResource OverviewSubsummaryIntentButton}" Margin="0,0,12,0" Click="OnOverviewIntentClick" AutomationProperties.Name="查看可读资格审计第一页" /><ui:Button x:Name="NotReadableSummaryAction" Content="不可读" Style="{StaticResource OverviewSubsummaryIntentButton}" Click="OnOverviewIntentClick" AutomationProperties.Name="查看不可读资格审计第一页" /></WrapPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ErrorsSummaryCard" Style="{StaticResource SummaryCard}" Margin="5,6" MinHeight="174">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><ui:TextBlock Text="错误检索" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel><ui:Button x:Name="ErrorsSummaryAction" Grid.Column="1" Content="查看 →" Style="{StaticResource InlineIntentButton}" Click="OnOverviewIntentClick" AutomationProperties.Name="查看全部错误检索第一页" /></Grid>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="ErrorsSummaryValue" Text="—" Style="{StaticResource OverviewPrimaryMetric}" /><ui:TextBlock x:Name="ErrorsSummaryDetail" Text="等待 Host 概览" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel>
                                            <WrapPanel Grid.Row="2"><ui:Button x:Name="ActiveErrorsSummaryAction" Content="活动" Style="{StaticResource OverviewSubsummaryIntentButton}" Margin="0,0,12,0" Click="OnOverviewIntentClick" AutomationProperties.Name="查看活动错误第一页" /><ui:Button x:Name="PriorErrorsSummaryAction" Content="近 7 天" Style="{StaticResource OverviewSubsummaryIntentButton}" Click="OnOverviewIntentClick" AutomationProperties.Name="查看近七天错误第一页" /></WrapPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="AreaSummaryCard" Style="{StaticResource SummaryCard}" Margin="5,6" MinHeight="174">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Filter24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><ui:TextBlock Text="AREA 筛选" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel><ui:Button Grid.Column="1" Content="管理 →" Style="{StaticResource InlineIntentButton}" Click="OnAreaFilterNavigationClick" AutomationProperties.Name="管理 AREA 筛选" /></Grid>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="LocalAreaHeadingText" Text="全部 AREA" Style="{StaticResource OverviewRatioMetric}" TextTrimming="CharacterEllipsis" /><ui:TextBlock x:Name="LocalAreaDetailText" Text="本机默认" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel>
                                            <ui:TextBlock x:Name="HostAreaScopeText" Grid.Row="2" Text="Host 已提交范围：尚无快照" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="AttentionSummaryCard" Style="{StaticResource SummaryCard}" Margin="5,6" MinHeight="174">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
