                                                                          Style="{StaticResource CaptionText}"
                                                                          Margin="0,5,0,0" />
                                                            <ui:TextBlock x:Name="AreaProfileRowAttentionText"
                                                                          Grid.Row="2"
                                                                          Text="{Binding AttentionText}"
                                                                          Style="{StaticResource CaptionText}"
