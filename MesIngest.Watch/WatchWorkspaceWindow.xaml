<ui:FluentWindow x:Class="MesIngest.Watch.WatchWorkspaceWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:wpf="clr-namespace:System.Windows;assembly=WindowsBase"
                 xmlns:wpfControls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
                 Title="MesIngest Watch"
                 Width="1440"
                 Height="900"
                 MinWidth="720"
                 MinHeight="600"
                 ResizeMode="CanResize"
                 WindowStyle="SingleBorderWindow"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Segoe UI Variable, Microsoft YaHei UI"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 SizeChanged="OnWindowSizeChanged">
    <ui:FluentWindow.Resources>
        <Style x:Key="PageTitleText" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Title" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SectionTitleText" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="164" />
        </Style>
        <Style x:Key="SurfaceCard" TargetType="Border" BasedOn="{StaticResource SummaryCard}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="SummaryValue" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- DemandSeries production dimensions are semantic resources so the 19–22
             integration train can calibrate them once without hunting literals. -->
        <sys:Double x:Key="DemandSeriesFilterWideWidth">196</sys:Double>
        <sys:Double x:Key="DemandSeriesFilterPresenceWidth">164</sys:Double>
        <sys:Double x:Key="DemandSeriesFilterPageSizeWidth">132</sys:Double>
        <sys:Double x:Key="DemandSeriesPageNumberWidth">72</sys:Double>
        <sys:Double x:Key="DemandSeriesPageSummaryMinWidth">230</sys:Double>
        <sys:Double x:Key="DemandSeriesEvidenceMinHeight">330</sys:Double>
        <sys:Double x:Key="DemandSeriesGenerationHeight">250</sys:Double>
        <wpf:GridLength x:Key="DemandSeriesMasterListHeight">260</wpf:GridLength>
        <wpf:GridLength x:Key="DemandSeriesSectionGap">16</wpf:GridLength>
        <wpf:GridLength x:Key="DemandSeriesMesObservationHeight">220</wpf:GridLength>
        <wpf:GridLength x:Key="DemandSeriesEvidenceShortHeight">110</wpf:GridLength>
        <wpf:GridLength x:Key="DemandSeriesEvidenceMediumHeight">120</wpf:GridLength>
        <wpf:GridLength x:Key="DemandSeriesEventHeight">240</wpf:GridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn45">45</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn55">55</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn65">65</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn90">90</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn100">100</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn110">110</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn120">120</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn130">130</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn140">140</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn150">150</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn160">160</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn170">170</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn180">180</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn190">190</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn210">210</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn230">230</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn240">240</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn260">260</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn300">300</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="DemandSeriesColumn330">330</wpfControls:DataGridLength>
        <wpf:Thickness x:Key="DemandSeriesPageBodyMargin">0,0,8,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesSectionTopMargin">0,16,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesControlTopMargin">0,8,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesControlToGroupMargin">0,8,0,12</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesFilterFieldMargin">0,0,12,12</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesGroupBottomMargin">0,0,0,12</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesRelatedBottomMargin">0,0,0,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesMicroBottomMargin">0,0,0,4</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCommandTrailingMargin">0,0,8,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCommandTileMargin">0,0,8,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesActionTopMargin">0,12,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesSubsectionHeadingMargin">0,12,0,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCompactCommandMargin">0,4,8,4</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesCompactCommandLastMargin">0,4,0,4</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesPagingSummaryMargin">0,8,16,8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesContentMargin">8</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesPagingTopPadding">0,12,0,0</wpf:Thickness>
        <wpf:Thickness x:Key="DemandSeriesPagingDividerThickness">0,1,0,0</wpf:Thickness>
        <!-- ReadabilityAudit and AREA page geometry stays tokenized so the shared
             integration train can calibrate the two master-detail workspaces. -->
        <sys:Double x:Key="ReadabilityStateFilterWidth">170</sys:Double>
        <sys:Double x:Key="ReadabilityWorkTypeFilterWidth">190</sys:Double>
        <sys:Double x:Key="ReadabilityBlockerFilterWidth">250</sys:Double>
        <sys:Double x:Key="ReadabilityTextFilterWidth">210</sys:Double>
        <sys:Double x:Key="ReadabilityPageSizeWidth">120</sys:Double>
        <sys:Double x:Key="ReadabilityFacetGridHeight">112</sys:Double>
        <sys:Double x:Key="ReadabilityAuditGridMinHeight">270</sys:Double>
        <sys:Double x:Key="ReadabilityQualificationGridMinHeight">190</sys:Double>
        <sys:Double x:Key="ReadabilityEvidenceGridMinHeight">210</sys:Double>
        <sys:Double x:Key="AreaProfileListMinHeight">300</sys:Double>
        <sys:Double x:Key="AreaProfileEditorMinHeight">260</sys:Double>
        <sys:Double x:Key="AreaProfileValidationGridMinHeight">120</sys:Double>
        <sys:Double x:Key="ReadabilityMasterDetailStackBreakpoint">1080</sys:Double>
        <sys:Double x:Key="AreaProfileMasterDetailStackBreakpoint">900</sys:Double>
        <wpf:GridLength x:Key="WatchCollapsedGridLength">0</wpf:GridLength>
        <wpf:GridLength x:Key="WatchMasterDetailGapWidth">16</wpf:GridLength>
        <wpf:GridLength x:Key="ReadabilityMasterColumnWidth">460</wpf:GridLength>
        <wpf:GridLength x:Key="ReadabilityFacetGapWidth">12</wpf:GridLength>
        <wpf:GridLength x:Key="AreaProfileMasterColumnWidth">318</wpf:GridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn45">45</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn80">80</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn90">90</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn100">100</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn120">120</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn130">130</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn160">160</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn170">170</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn180">180</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn220">220</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="ReadabilityColumn240">240</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="AreaProfileDiagnosticLineColumnWidth">60</wpfControls:DataGridLength>
        <wpfControls:DataGridLength x:Key="AreaProfileDiagnosticCodeColumnWidth">180</wpfControls:DataGridLength>
        <wpf:Thickness x:Key="WatchPageCardPadding">16</wpf:Thickness>
        <wpf:Thickness x:Key="AreaProfileListMargin">0,12,0,12</wpf:Thickness>
        <!-- Ticket 22 keeps the two production workspaces on the shared 8/12/16/24
             rhythm. Named geometry is intentionally adjusted by the window's
             responsive reflow instead of introducing page-only visual paths. -->
        <sys:Double x:Key="Ticket22FacetGridHeight">112</sys:Double>
        <sys:Double x:Key="Ticket22ResultsGridMinHeight">320</sys:Double>
        <sys:Double x:Key="Ticket22DetailGridHeight">176</sys:Double>
        <sys:Double x:Key="Ticket22RawGridHeight">176</sys:Double>
        <wpf:GridLength x:Key="Ticket22CardGap">16</wpf:GridLength>
        <wpf:GridLength x:Key="ErrorSearchCategoryColumnWidth">286</wpf:GridLength>
        <wpf:GridLength x:Key="ErrorSearchDetailColumnWidth">480</wpf:GridLength>
        <wpf:GridLength x:Key="CurrentAttentionFacetColumnWidth">286</wpf:GridLength>
        <wpf:GridLength x:Key="CurrentAttentionEvidenceColumnWidth">390</wpf:GridLength>
        <sys:Double x:Key="Ticket22ThreeCardStackBreakpoint">900</sys:Double>
        <Style x:Key="DemandSeriesReadOnlyGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Title="MesIngest Watch"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     Loaded="OnWindowTitleBarLoaded">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Pulse24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="WorkspaceNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="LeftMinimal"
                           CompactPaneLength="48"
                           OpenPaneLength="232"
                           IsPaneOpen="False"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           HeaderVisibility="Collapsed"
                           AutomationProperties.Name="主导航">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="OverviewNavigationItem"
                                       Content="概览"
                                       IsActive="True"
                                       Click="OnOverviewNavigationClick"
                                       AutomationProperties.Name="概览导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="DemandSeriesNavigationItem"
                                       Content="需求系列"
                                       Click="OnDemandSeriesNavigationClick"
                                       AutomationProperties.Name="需求系列导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Timeline24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="ReadabilityAuditNavigationItem"
                                       Content="资格审计"
                                       Click="OnReadabilityAuditNavigationClick"
                                       AutomationProperties.Name="资格审计导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DocumentBulletList24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="ErrorSearchNavigationItem"
                                       Content="错误检索"
                                       Click="OnErrorSearchNavigationClick"
                                       AutomationProperties.Name="错误检索导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Search24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="AreaFilterNavigationItem"
                                       Content="AREA 筛选"
                                       Click="OnAreaFilterNavigationClick"
                                       AutomationProperties.Name="AREA 筛选导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Filter24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="CurrentAttentionNavigationItem"
                                       Content="接入告警"
                                       Click="OnCurrentAttentionNavigationClick"
                                       AutomationProperties.Name="接入告警导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Alert24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="HostNavigationItem"
                                       Content="Host 未连接"
                                       ToolTip="Host 尚未连接"
                                       Click="OnSettingsNavigationClick"
                                       AutomationProperties.Name="Host 状态与连接设置">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon x:Name="HostNavigationIcon" Symbol="CloudOff24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                       Content="设置"
                                       Click="OnSettingsNavigationClick"
                                       AutomationProperties.Name="设置导航">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="WorkspaceContent" Margin="24,16,24,16">
                    <ScrollViewer x:Name="OverviewPage"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="概览页面">
                        <StackPanel Margin="0,0,8,8">
                            <StackPanel>
                                <ui:TextBlock Text="概览" Style="{StaticResource PageTitleText}" />
                                <ui:TextBlock x:Name="OverviewContextText"
                                           Text="等待 Host 连接"
                                           Style="{StaticResource SecondaryText}"
                                           Margin="0,8,0,0"
                                           AutomationProperties.Name="概览快照与客户端读取时间" />
                            </StackPanel>

                            <ui:InfoBar x:Name="OverviewInfoBar"
                                        IsOpen="False"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Margin="0,16,0,0"
                                        AutomationProperties.Name="概览读取状态" />

                            <UniformGrid x:Name="OverviewSummaryCards"
                                         Columns="5"
                                         Margin="0,16,-12,0">
                                <Border Style="{StaticResource SummaryCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Timeline24" /><ui:TextBlock Text="需求系列" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="SeriesSummaryValue" Text="—" Style="{StaticResource SummaryValue}" /><ui:TextBlock x:Name="SeriesSummaryDetail" Text="等待 Host 概览" Style="{StaticResource SecondaryText}" /></StackPanel>
                                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                            <ui:Button x:Name="SeriesSummaryAction" Content="全部" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看全部需求系列第一页" />
                                            <ui:Button x:Name="SeriesTrackingAction" Content="Tracking" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看 Tracking 需求系列第一页" />
                                            <ui:Button x:Name="SeriesArchivedAction" Content="Archived" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看 Archived 需求系列第一页" />
                                            <ui:Button x:Name="SeriesGoneAction" Content="GONE" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看 GONE 需求系列第一页" />
                                            <ui:Button x:Name="SeriesLongGoneVisibleAction" Content="归档后可见" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看归档后仍可见需求系列第一页" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentBulletList24" /><ui:TextBlock Text="资格审计" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="ReadabilitySummaryValue" Text="—" Style="{StaticResource SummaryValue}" /><ui:TextBlock x:Name="ReadabilitySummaryDetail" Text="等待 Host 概览" Style="{StaticResource SecondaryText}" /></StackPanel>
                                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                            <ui:Button x:Name="ReadabilitySummaryAction" Content="全部" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看全部资格审计第一页" />
                                            <ui:Button x:Name="ReadableSummaryAction" Content="可读" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看可读资格审计第一页" />
                                            <ui:Button x:Name="NotReadableSummaryAction" Content="不可读" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看不可读资格审计第一页" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" /><ui:TextBlock Text="错误检索" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="ErrorsSummaryValue" Text="—" Style="{StaticResource SummaryValue}" /><ui:TextBlock x:Name="ErrorsSummaryDetail" Text="等待 Host 概览" Style="{StaticResource SecondaryText}" /></StackPanel>
                                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                            <ui:Button x:Name="ErrorsSummaryAction" Content="全部" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看全部错误检索第一页" />
                                            <ui:Button x:Name="ActiveErrorsSummaryAction" Content="活动" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看活动错误第一页" />
                                            <ui:Button x:Name="PriorErrorsSummaryAction" Content="近 7 天" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看近七天错误第一页" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Alert24" /><ui:TextBlock Text="接入告警" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="AttentionSummaryValue" Text="—" Style="{StaticResource SummaryValue}" /><ui:TextBlock x:Name="AttentionSummaryDetail" Text="等待 Host 概览" Style="{StaticResource SecondaryText}" /></StackPanel>
                                        <WrapPanel x:Name="AttentionSummaryActions" Grid.Row="2" Margin="0,8,0,0">
                                            <ui:Button x:Name="AttentionSummaryAction" Content="全部" Appearance="Secondary" Margin="0,0,8,8" Click="OnOverviewIntentClick" AutomationProperties.Name="查看全部接入告警第一页" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Filter24" /><ui:TextBlock Text="AREA 筛选" FontTypography="BodyStrong" Margin="8,0,0,0" /></StackPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center"><ui:TextBlock x:Name="LocalAreaHeadingText" Text="全部 AREA" FontTypography="Body" TextTrimming="CharacterEllipsis" /><ui:TextBlock x:Name="LocalAreaDetailText" Text="本机默认" Style="{StaticResource SecondaryText}" /><ui:TextBlock x:Name="HostAreaScopeText" Text="Host 已提交范围：尚无快照" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" /></StackPanel>
                                        <ui:Button Grid.Row="2" Content="管理本机 AREA" Appearance="Secondary" HorizontalAlignment="Left" Click="OnAreaFilterNavigationClick" AutomationProperties.Name="管理 AREA 筛选" />
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Grid x:Name="OverviewBodyGrid" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="OverviewBodyVerticalGap" Height="0" />
                                    <RowDefinition x:Name="OverviewFactsRow" Height="0" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ActivityColumn" Width="1.55*" />
                                    <ColumnDefinition x:Name="OverviewBodyGap" Width="12" />
                                    <ColumnDefinition x:Name="FactsColumn" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SurfaceCard}">
                                    <StackPanel>
                                        <ui:TextBlock x:Name="RecentActivityHeadingText" Text="近期重点动态" Style="{StaticResource SectionTitleText}" />
                                        <ui:TextBlock Text="Host 快照前 24 小时内、最多 5 条真实转换；无动态不代表健康。" Style="{StaticResource SecondaryText}" Margin="0,8,0,12" />
                                        <StackPanel x:Name="RecentActivityItems" AutomationProperties.Name="近期重点动态列表" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OverviewFactsCard" Grid.Column="2" Style="{StaticResource SurfaceCard}">
                                    <StackPanel>
                                        <ui:TextBlock Text="快照事实" Style="{StaticResource SectionTitleText}" />
                                        <ui:TextBlock x:Name="SnapshotFactsText" Text="尚无 Host 业务快照" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" AutomationProperties.Name="Host 快照事实" />
