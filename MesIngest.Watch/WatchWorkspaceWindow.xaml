                                            <ui:Button x:Name="CurrentAttentionGoToPageButton"
                                                       Content="跳转"
                                                       Appearance="Secondary"
                                                       Margin="{StaticResource DemandSeriesCompactCommandLastMargin}"
                                                       Focusable="True"
                                                       KeyboardNavigation.IsTabStop="True"
                                                       Click="OnCurrentAttentionGoToPageClick"
                                                       AutomationProperties.Name="接入告警直接页码跳转"
                                                       AutomationProperties.AutomationId="CurrentAttentionGoToPageButton" />
                                        </WrapPanel>
                                        </Border>
                                    </Grid>
                                </ui:Card>

                                <ui:Card x:Name="CurrentAttentionEvidenceCard"
