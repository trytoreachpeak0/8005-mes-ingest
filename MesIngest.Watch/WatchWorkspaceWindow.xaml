                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Grid Grid.Row="2" Margin="18,12,18,16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <ui:TextBlock Text="结构化证据与关联对象" Style="{StaticResource SectionTitleText}" />
                                            <ui:TextBlock Grid.Row="1"
                                                          Text="字段、PollTrace、WorkType 与对象标识均来自当前 Host snapshot。"
                                                          Style="{StaticResource SecondaryText}"
                                                          Margin="0,3,0,10" />
                                            <DataGrid x:Name="CurrentAttentionEvidenceGrid"
                                                      Grid.Row="2"
                                                      Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                      Focusable="True"
                                                      KeyboardNavigation.IsTabStop="True"
                                                      AutomationProperties.Name="接入告警结构化证据字段"
                                                      AutomationProperties.AutomationId="CurrentAttentionEvidenceGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="{StaticResource DemandSeriesColumn150}" />
                                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="设置页面">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><ui:TextBlock Text="设置" Style="{StaticResource PageTitleText}" /><ui:TextBlock Text="Host 连接、自动刷新与本机显示偏好" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel>
                                <ui:Button x:Name="RestoreDefaultSettingsButton"
                                           Grid.Column="1"
                                           Content="恢复默认设置"
                                           Appearance="Secondary"
                                           VerticalAlignment="Center"
                                           Click="OnRestoreDefaultSettingsClick"
                                           AutomationProperties.Name="恢复 Watch 默认设置" />
                            </Grid>
                            <Grid x:Name="SettingsColumns" Grid.Row="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SettingsVerticalGap" Height="0" /><RowDefinition x:Name="SettingsBottomRow" Height="0" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsLeftColumn" Width="1*" /><ColumnDefinition x:Name="SettingsGapColumn" Width="16" /><ColumnDefinition x:Name="SettingsRightColumn" Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource SurfaceCard}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid Margin="18,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SettingsHostStatusIconSurface"
                                                        Width="36"
                                                        Height="36"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <ui:SymbolIcon x:Name="SettingsHostStatusIcon" Symbol="CloudDismiss24" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <ui:TextBlock Text="Host 连接" Style="{StaticResource SectionTitleText}" />
                                                    <ui:TextBlock x:Name="SettingsHostStateText"
                                                                  Text="Host 未连接"
                                                                  Style="{StaticResource SecondaryText}"
                                                                  Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Border x:Name="SettingsHostStatusPill"
                                                        Grid.Column="2"
                                                        Style="{StaticResource StatusPillCritical}"
                                                        VerticalAlignment="Center">
                                                    <ui:TextBlock x:Name="SettingsHostStatusText"
                                                                  Text="Host 未连接"
                                                                  FontTypography="BodyStrong" />
                                                </Border>
                                            </Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                            <Grid Grid.Row="2" Margin="18,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <ui:TextBlock Text="服务地址" Style="{StaticResource FieldLabel}" /><TextBox x:Name="HostBaseUrlInput" Grid.Column="1" AutomationProperties.Name="Host 基址" />
                                                <ui:TextBlock Grid.Row="2" Text="访问凭据" Style="{StaticResource FieldLabel}" /><StackPanel Grid.Row="2" Grid.Column="1"><PasswordBox x:Name="HostCredentialInput" PasswordChar="●" Padding="12,8" AutomationProperties.Name="只读 API 凭据" /><ui:TextBlock Text="留空继续使用当前外部配置凭据；输入值仅用于本次进程，保存后立即清空。" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" /></StackPanel>
                                                <ui:TextBlock Grid.Row="4" Text="请求超时" Style="{StaticResource FieldLabel}" /><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="RequestTimeoutInput" Width="100" ToolTip="1–300 秒" AutomationProperties.Name="全局请求超时秒数" /><ui:TextBlock Text="秒 · 合法范围 1–300" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SurfaceCard}" Padding="0" Margin="0,12,0,0">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="18,14"><ui:TextBlock Text="连接变更" Style="{StaticResource SectionTitleText}" /><ui:TextBlock Text="应用后取消旧 Host 的全部请求，清空旧业务窗口并返回概览。" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" /><StackPanel Grid.Row="2" Margin="18,12"><ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="凭据仅保存在本机" Message="界面不会显示、复制或记录完整令牌。" /><ui:Button x:Name="ApplyHostButton" Content="应用 Host 设置" Appearance="Secondary" HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnApplyHostClick" AutomationProperties.Name="应用 Host 设置" /></StackPanel></Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="RefreshSettingsCard" Grid.Column="2">
                                    <Border Style="{StaticResource SurfaceCard}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Margin="18,16">
                                                <ui:TextBlock Text="自动刷新间隔" Style="{StaticResource SectionTitleText}" />
                                                <ui:TextBlock Text="所有数据视图始终自动刷新；这里只配置各视图的刷新时间。" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                            <StackPanel x:Name="PrimaryRefreshIntervalRows" Grid.Row="2" Margin="18,10,18,16">
                                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="概览" Style="{StaticResource FieldLabel}" /><ui:TextBlock Text="Host、投影、当前关注与跨页摘要" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="OverviewIntervalInput" Grid.Column="1" AutomationProperties.Name="概览自动刷新间隔" /></Grid>
                                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,7" />
                                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="需求系列" Style="{StaticResource FieldLabel}" /><ui:TextBlock Text="完整生命周期与当前出现范围" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="DemandSeriesIntervalInput" Grid.Column="1" AutomationProperties.Name="需求系列自动刷新间隔" /></Grid>
                                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,7" />
                                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="资格审计" Style="{StaticResource FieldLabel}" /><ui:TextBlock Text="外部可读资格与全部阻断原因" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="ReadabilityAuditIntervalInput" Grid.Column="1" AutomationProperties.Name="资格审计自动刷新间隔" /></Grid>
                                                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,7" />
                                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="错误检索" Style="{StaticResource FieldLabel}" /><ui:TextBlock Text="活动与已结束的历史错误" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="ErrorSearchIntervalInput" Grid.Column="1" AutomationProperties.Name="错误检索自动刷新间隔" /></Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SurfaceCard}" Padding="0" Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Margin="18,16">
                                                <ui:TextBlock Text="显示与布局" Style="{StaticResource SectionTitleText}" />
                                                <ui:TextBlock Text="本机偏好，不影响 Host 或业务数据。" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                            <Grid x:Name="PrimaryDisplayPreferences" Grid.Row="2" Margin="18,16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <StackPanel><ui:TextBlock Text="记住窗口布局" Style="{StaticResource FieldLabel}" /><ui:TextBlock Text="重启后恢复主窗口和详情窗口布局" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel>
                                                <ui:ToggleSwitch x:Name="RememberWindowLayoutCheckBox" Grid.Column="1" OnContent="开" OffContent="关" AutomationProperties.Name="记住窗口布局" />
                                                <ui:Button x:Name="RestoreDefaultLayoutButton"
                                                           Grid.Row="2"
                                                           Content="恢复默认布局"
                                                           Appearance="Secondary"
                                                           HorizontalAlignment="Left"
                                                           Click="OnRestoreDefaultLayoutClick"
                                                           AutomationProperties.Name="恢复默认窗口与导航布局" />
                                                <Expander x:Name="AdvancedLocalPreferencesExpander"
                                                          Grid.Row="2"
                                                          Grid.Column="1"
                                                          Header="更多本机设置"
                                                          IsExpanded="False"
                                                          HorizontalAlignment="Right"
                                                          AutomationProperties.Name="更多本机刷新与导航设置"
                                                          AutomationProperties.AutomationId="AdvancedLocalPreferencesExpander">
                                                    <StackPanel MinWidth="420" Margin="0,12,0,0">
                                                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="接入告警" Style="{StaticResource FieldLabel}" /><ui:TextBlock Text="Host 当前仍需关注的接入项" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="CurrentAttentionIntervalInput" Grid.Column="1" AutomationProperties.Name="接入告警自动刷新间隔" /></Grid>
                                                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,7" />
                                                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="默认展开导航窗格" Style="{StaticResource FieldLabel}" /><ui:TextBlock Text="关闭时使用获选的 48 epx 紧凑 rail" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ui:ToggleSwitch x:Name="KeepNavigationPaneOpenCheckBox" Grid.Column="1" OnContent="开" OffContent="关" AutomationProperties.Name="默认展开导航窗格" /></Grid>
                                                    </StackPanel>
                                                </Expander>
                                                <ui:Button x:Name="SaveRefreshIntervalsButton"
                                                           Grid.Row="4"
                                                           Grid.ColumnSpan="2"
                                                           Content="保存刷新与显示设置"
                                                           Appearance="Secondary"
                                                           HorizontalAlignment="Right"
                                                           Click="OnSaveLocalPreferencesClick"
                                                           AutomationProperties.Name="保存刷新与显示设置" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Grid x:Name="NotificationOverlay"
              Grid.Row="1"
              Width="380"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,44,24,0"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              MouseEnter="OnNotificationHostMouseEnter"
              MouseLeave="OnNotificationHostMouseLeave"
              GotKeyboardFocus="OnNotificationHostGotKeyboardFocus"
              LostKeyboardFocus="OnNotificationHostLostKeyboardFocus"
              AutomationProperties.Name="窗口通知"
              AutomationProperties.AutomationId="NotificationOverlay"
              KeyboardNavigation.TabNavigation="Continue">
            <TextBlock x:Name="NotificationLiveRegion"
                       Width="1"
                       Height="1"
                       Opacity="0"
                       Focusable="False"
                       KeyboardNavigation.IsTabStop="False"
                       IsHitTestVisible="False"
                       AutomationProperties.Name="窗口通知播报"
                       AutomationProperties.AutomationId="NotificationLiveRegion"
                       AutomationProperties.LiveSetting="Polite" />
            <ItemsControl x:Name="NotificationItemsControl"
                          AutomationProperties.Name="窗口通知卡片"
                          AutomationProperties.AutomationId="NotificationItemsControl"
                          KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="NotificationCard"
                                Margin="0,0,0,8"
                                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 Focusable="False"
                                 AutomationProperties.Name="{Binding AutomationName}"
                                 AutomationProperties.AutomationId="NotificationCard"
                                 AutomationProperties.HelpText="{Binding AutomationHelpText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NotificationSeverityRail"
                                        CornerRadius="8,0,0,8"
                                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <ui:SymbolIcon x:Name="NotificationSeverityIcon"
                                               Grid.Column="1"
                                               Symbol="Info24"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                VerticalAlignment="Top"
                                                Margin="0,16,0,0"
                                                Focusable="False"
                                                AutomationProperties.Name="{Binding SeverityAutomationName}" />
                                <StackPanel Grid.Column="2" Margin="0,13,8,13">
                                    <DockPanel LastChildFill="True">
                                        <ui:TextBlock x:Name="NotificationSeverityText"
                                                      Text="{Binding SeverityText}"
                                                      Style="{StaticResource CaptionText}"
                                                      FontWeight="SemiBold"
                                                      DockPanel.Dock="Left" />
                                         <ui:TextBlock x:Name="NotificationTimerText"
                                                       Text="{Binding TimerText}"
                                                       Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ui:TextBlock x:Name="NotificationTitleText"
                                                  Text="{Binding Title}"
                                                  Style="{StaticResource BodyStrong}"
                                                  Margin="0,3,0,0" />
                                    <ui:TextBlock x:Name="NotificationMessageText"
                                                   Text="{Binding Message}"
                                                   Style="{StaticResource SecondaryText}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <ui:Button x:Name="NotificationActionButton"
                                                   Content="{Binding ActionLabel}"
                                                   Command="{Binding ActionCommand}"
                                                   Visibility="{Binding ActionVisibility}"
                                                    Appearance="Transparent"
                                                    Padding="0,4"
                                                    MinWidth="32"
                                                    MinHeight="32"
                                                    ToolTip="{Binding ActionLabel}"
                                                    Focusable="True"
                                                    FocusVisualStyle="{StaticResource NotificationFocusVisual}"
                                                    KeyboardNavigation.IsTabStop="True"
                                                    AutomationProperties.AutomationId="NotificationActionButton"
                                                    AutomationProperties.Name="{Binding ActionLabel}" />
                                        <ui:TextBlock x:Name="NotificationOccurrenceText"
                                                      Text="{Binding OccurrenceText}"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       AutomationProperties.Name="{Binding OccurrenceText}" />
                                    </StackPanel>
                                </StackPanel>
                                <ui:Button x:Name="NotificationDismissButton"
                                           Grid.Column="3"
                                           Command="{Binding DismissCommand}"
                                           Appearance="Transparent"
                                           Width="32"
                                           Height="32"
                                           Margin="0,8,4,0"
                                           VerticalAlignment="Top"
                                            ToolTip="关闭通知"
                                            Focusable="True"
                                            FocusVisualStyle="{StaticResource NotificationFocusVisual}"
                                            KeyboardNavigation.IsTabStop="True"
                                            AutomationProperties.AutomationId="NotificationDismissButton"
                                            AutomationProperties.Name="关闭通知">
                                    <ui:SymbolIcon Symbol="Dismiss24" />
                                </ui:Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Success">
                                <Setter TargetName="NotificationSeverityRail" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter TargetName="NotificationSeverityIcon" Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter TargetName="NotificationSeverityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter TargetName="NotificationSeverityRail" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Setter TargetName="NotificationSeverityIcon" Property="Symbol" Value="Warning24" />
                                <Setter TargetName="NotificationSeverityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter TargetName="NotificationSeverityRail" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Setter TargetName="NotificationSeverityIcon" Property="Symbol" Value="ErrorCircle24" />
                                <Setter TargetName="NotificationSeverityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <ui:ContentDialogHost x:Name="WorkspaceDialogHost"
                              Grid.Row="1"
                              Panel.ZIndex="40"
                              IsDisableSiblingsEnabled="True" />
    </Grid>
</ui:FluentWindow>
