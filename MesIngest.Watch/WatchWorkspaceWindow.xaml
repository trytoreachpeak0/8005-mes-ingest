                                                         KeyboardNavigation.IsTabStop="True"
                                                         AutomationProperties.Name="需求系列页码"
                                                         AutomationProperties.AutomationId="DemandSeriesPageNumberInput" />
                                                <ui:Button x:Name="DemandSeriesGoToPageButton"
                                                           Content="跳转"
                                                           Appearance="Secondary"
                                                           Click="OnDemandSeriesGoToPageClick"
                                                           Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                           HorizontalContentAlignment="Center"
                                                           VerticalContentAlignment="Center"
                                                           KeyboardNavigation.IsTabStop="True"
                                                           AutomationProperties.Name="跳转到需求系列页码"
                                                           AutomationProperties.AutomationId="DemandSeriesGoToPageButton" />
                                                <ui:Button x:Name="DemandSeriesNextButton"
                                                           Content="下一页"
                                                           Appearance="Secondary"
                                                           IsEnabled="False"
                                                           Click="OnDemandSeriesNextClick"
                                                           Margin="{StaticResource DemandSeriesCompactCommandLastMargin}"
                                                           HorizontalContentAlignment="Center"
                                                           VerticalContentAlignment="Center"
                                                           KeyboardNavigation.IsTabStop="True"
                                                           AutomationProperties.Name="需求系列下一页"
                                                           AutomationProperties.AutomationId="DemandSeriesNextButton" />
                                            </WrapPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer x:Name="ReadabilityAuditPage"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="资格审计页面"
                                  AutomationProperties.AutomationId="ReadabilityAuditPage">
                        <Grid x:Name="ReadabilityAuditLayoutGrid"
                              MinHeight="{Binding ActualHeight, ElementName=ReadabilityAuditPage}"
                              Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock Text="资格审计" Style="{StaticResource PageTitleText}" />
                                    <ui:TextBlock x:Name="ReadabilityCompactFactsText"
                                                  Text="SnapshotReference 尚无快照 · Watch 尚无成功读取 · Host 固定排序 · 阻断原因精确分面：尚无快照"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.Name="资格审计持久快照事实" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button x:Name="ReadabilityFaultStatusButton"
                                               Visibility="Collapsed"
                                               Appearance="Transparent"
                                               Padding="0"
                                               MinWidth="32"
                                               MinHeight="32"
                                               Margin="0,0,8,0"
                                               Click="OnFaultStatusClick">
                                        <Border x:Name="ReadabilityFaultStatusPill" Style="{StaticResource StatusPillCritical}">
                                            <ui:TextBlock x:Name="ReadabilityFaultStatusText" Text="错误 · 1 个故障" FontTypography="BodyStrong" />
                                        </Border>
                                    </ui:Button>
                                    <Border x:Name="ReadabilityCatalogRevisionPill"
                                            Style="{StaticResource StatusPillSuccess}">
                                        <ui:TextBlock x:Name="ReadabilityCatalogRevisionText"
                                                      Text="Catalog Revision —"
                                                      FontTypography="BodyStrong" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <ui:TextBlock x:Name="ReadabilityHeaderFactsText"
                                                      Text="全部 AREA · 尚无更新时间"
                                                      Style="{StaticResource CaptionText}"
                                                      TextWrapping="NoWrap"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                      TextAlignment="Right"
                                                      AutomationProperties.Name="资格审计 AREA 与更新时间" />
                                        <ui:TextBlock x:Name="ReadabilityRefreshPolicyText"
                                                      Text="自动刷新"
                                                      Style="{StaticResource CaptionText}"
                                                      Margin="0,3,0,0"
                                                      TextAlignment="Right"
                                                      AutomationProperties.Name="资格审计自动刷新策略" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <ui:Card x:Name="ReadabilityFilterCard"
                                     Grid.Row="2"
                                     Padding="12"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Stretch"
                                     Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer x:Name="ReadabilityFilterScroller"
                                                  Grid.Row="0"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                    <Grid x:Name="ReadabilityFilterPanel"
                                          MinWidth="1170"
                                          AutomationProperties.Name="资格审计筛选">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="290" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock x:Name="ReadabilityStateFilterLabel"
                                                          Text="资格"
                                                          Style="{StaticResource CaptionText}" />
                                            <StackPanel x:Name="ReadabilityStateSegment"
                                                        Orientation="Horizontal"
                                                        Margin="0,5,0,0"
                                                        AutomationProperties.Name="资格三段筛选"
                                                        AutomationProperties.AutomationId="ReadabilityStateSegment">
                                                <ui:Button x:Name="ReadabilityStateAllButton"
                                                           Content="全部"
                                                           Tag=""
                                                           Padding="12,6"
                                                           Appearance="Primary"
                                                           Click="OnReadabilityStateSegmentClick"
                                                           AutomationProperties.Name="资格：全部"
                                                           AutomationProperties.AutomationId="ReadabilityStateAllButton" />
                                                <ui:Button x:Name="ReadabilityStateReadableButton"
                                                           Content="外部可见"
                                                           Tag="READABLE"
                                                           Padding="12,6"
                                                           Margin="4,0,0,0"
                                                           Appearance="Transparent"
                                                           Click="OnReadabilityStateSegmentClick"
                                                           AutomationProperties.Name="资格：外部可见"
                                                           AutomationProperties.AutomationId="ReadabilityStateReadableButton" />
                                                <ui:Button x:Name="ReadabilityStateNotReadableButton"
                                                           Content="外部不可见"
                                                           Tag="NOT_READABLE"
                                                           Padding="12,6"
                                                           Margin="4,0,0,0"
                                                           Appearance="Transparent"
                                                           Click="OnReadabilityStateSegmentClick"
                                                           AutomationProperties.Name="资格：外部不可见"
                                                           AutomationProperties.AutomationId="ReadabilityStateNotReadableButton" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ui:TextBlock Text="WORKTYPE" Style="{StaticResource CaptionText}" />
                                            <ComboBox x:Name="ReadabilityWorkTypeFilter"
                                                      IsEditable="True"
                                                      SelectionChanged="OnReadabilityFilterDraftChanged"
                                                      KeyUp="OnReadabilityFilterDraftChanged"
                                                      KeyboardNavigation.IsTabStop="True"
                                                      Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                      AutomationProperties.Name="资格审计 WorkType 筛选"
                                                      AutomationProperties.AutomationId="ReadabilityWorkTypeFilter" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <ui:TextBlock Text="不可见原因" Style="{StaticResource CaptionText}" />
                                            <ComboBox x:Name="ReadabilityBlockerFilter"
                                                      IsEditable="True"
                                                      SelectionChanged="OnReadabilityFilterDraftChanged"
                                                      KeyUp="OnReadabilityFilterDraftChanged"
                                                      KeyboardNavigation.IsTabStop="True"
                                                      Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                      AutomationProperties.Name="资格阻断原因筛选"
                                                      AutomationProperties.AutomationId="ReadabilityBlockerFilter" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <ui:TextBlock Text="DemandId / SUBLOT" Style="{StaticResource CaptionText}" />
                                            <Grid Margin="{StaticResource DemandSeriesControlTopMargin}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ReadabilityDemandIdFilter"
                                                         TextChanged="OnReadabilityFilterDraftChanged"
                                                         KeyboardNavigation.IsTabStop="True"
                                                         AutomationProperties.Name="资格审计 DemandId 精确筛选"
                                                         AutomationProperties.AutomationId="ReadabilityDemandIdFilter" />
                                                <TextBox x:Name="ReadabilitySublotFilter"
                                                         Grid.Column="2"
                                                         TextChanged="OnReadabilityFilterDraftChanged"
                                                         KeyboardNavigation.IsTabStop="True"
                                                         AutomationProperties.Name="资格审计 SUBLOT 包含筛选"
                                                         AutomationProperties.AutomationId="ReadabilitySublotFilter" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="8">
                                            <ui:TextBlock Text="AREA 筛选" Style="{StaticResource CaptionText}" />
                                            <ComboBox x:Name="ReadabilityAreaProfileSelector"
                                                      Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                      KeyboardNavigation.IsTabStop="True"
                                                      AutomationProperties.Name="资格审计 AREA 配置选择器"
                                                      AutomationProperties.AutomationId="ReadabilityAreaProfileSelector">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="IsEnabled" Value="{Binding IsValid}" />
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <ui:TextBlock Text="{Binding DisplayText}" FontTypography="Body" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <ui:Button x:Name="ReadabilityApplyFilterButton"
                                                   Grid.Column="10"
                                                   Content="应用条件"
                                                   Appearance="Secondary"
                                                   VerticalAlignment="Bottom"
                                                   KeyboardNavigation.IsTabStop="True"
                                                   Click="OnReadabilityApplyFiltersClick"
                                                   AutomationProperties.Name="应用资格审计条件"
                                                   AutomationProperties.AutomationId="ReadabilityApplyFilterButton" />
                                    </Grid>
                                    </ScrollViewer>
                                    <ui:TextBlock x:Name="ReadabilityBlockerFacetSummaryText"
                                                  Grid.Row="2"
                                                  Text="阻断原因精确分面：尚无快照"
                                                  Style="{StaticResource CaptionText}"
                                                  Visibility="Collapsed"
                                                  AutomationProperties.Name="资格审计紧凑阻断分面" />
                                </Grid>
                            </ui:Card>

                            <ui:Card Padding="{StaticResource WatchPageCardPadding}"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Stretch"
                                     Visibility="Collapsed">
                                <StackPanel>
                                    <ui:TextBlock x:Name="ReadabilitySnapshotFactsText"
                                                  Text="尚无 Host 审计快照"
                                                  Style="{StaticResource SecondaryText}"
                                                  AutomationProperties.Name="资格审计 Host 快照事实" />
                                    <ui:TextBlock x:Name="ReadabilityClientAttemptText"
                                                  Text="尚无客户端读取尝试"
                                                  Style="{StaticResource SecondaryText}"
                                                  Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                  AutomationProperties.Name="资格审计客户端读取事实" />
                                    <ui:TextBlock x:Name="ReadabilityAreaScopeText"
                                                  Text="当前 AREA：全部 AREA · 尚无 Host 提交范围"
                                                  Style="{StaticResource SecondaryText}"
                                                  Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                  AutomationProperties.Name="资格审计 AREA 范围" />
                                    <ui:TextBlock x:Name="ReadabilityOrderSummaryText"
                                                  Text="Host 固定排序：NOT_READABLE、主要阻断、最后看见时间、DemandId"
                                                  Style="{StaticResource SecondaryText}"
                                                  Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                  AutomationProperties.Name="资格审计稳定排序" />
                                </StackPanel>
                            </ui:Card>

                            <Grid x:Name="ReadabilityStatusAndBodyGrid"
                                  Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="ReadabilityGlobalStatusRegion"
                                            Grid.Row="0"
                                            Margin="0,0,0,12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen, ElementName=ReadabilityAuditInfoBar}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:InfoBar x:Name="ReadabilityAuditInfoBar"
                                                IsOpen="False"
                                                IsClosable="True"
                                                Severity="Informational"
                                                AutomationProperties.Name="资格审计状态" />
                                </StackPanel>

                            <Grid x:Name="ReadabilityBodyGrid"
                                  Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition x:Name="ReadabilityBodyVerticalGap"
                                                   Height="{StaticResource WatchCollapsedGridLength}" />
                                    <RowDefinition x:Name="ReadabilityBodyBottomRow"
                                                   Height="{StaticResource WatchCollapsedGridLength}" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ReadabilityMasterColumn"
                                                      Width="{StaticResource ReadabilityMasterColumnWidth}" />
                                    <ColumnDefinition x:Name="ReadabilityBodyGapColumn"
                                                      Width="{StaticResource WatchMasterDetailGapWidth}" />
                                    <ColumnDefinition x:Name="ReadabilityDetailColumn" Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:Card x:Name="ReadabilityMasterCard"
                                         Padding="0"
                                         VerticalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"
                                         AutomationProperties.Name="资格审计主列表与精确分面"
                                         AutomationProperties.AutomationId="ReadabilityMasterCard">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <ui:TextBlock Text="Host 精确分面"
                                                      Style="{StaticResource SectionTitleText}"
                                                      Visibility="Collapsed" />
                                        <Grid Margin="0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{StaticResource ReadabilityFacetGapWidth}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <DataGrid x:Name="ReadabilityStateFacetGrid"
                                                      Height="{StaticResource ReadabilityFacetGridHeight}"
                                                      KeyboardNavigation.IsTabStop="True"
                                                      ItemsSource="{Binding}"
                                                      Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                      AutomationProperties.Name="资格状态 Host 精确分面"
                                                      AutomationProperties.AutomationId="ReadabilityStateFacetGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="资格" Binding="{Binding State}" Width="*" />
                                                    <DataGridTextColumn Header="Demand"
                                                                        Binding="{Binding DemandCount}"
                                                                        Width="{StaticResource ReadabilityColumn90}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <DataGrid x:Name="ReadabilityBlockerFacetGrid"
                                                      Grid.Column="2"
                                                      Height="{StaticResource ReadabilityFacetGridHeight}"
                                                      KeyboardNavigation.IsTabStop="True"
                                                      ItemsSource="{Binding}"
                                                      Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                      AutomationProperties.Name="阻断原因 Host 精确去重分面"
                                                      AutomationProperties.AutomationId="ReadabilityBlockerFacetGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="阻断" Binding="{Binding Code}" Width="*" />
                                                    <DataGridTextColumn Header="Demand"
                                                                        Binding="{Binding DemandCount}"
                                                                        Width="{StaticResource ReadabilityColumn90}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                        <ui:TextBlock Text="原因分面可重叠；NOT_READABLE 总数按 Demand 世代去重，不能相加原因数量。"
                                                      Style="{StaticResource SecondaryText}"
                                                      Visibility="Collapsed" />

                                        <Grid Margin="16,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <ui:TextBlock x:Name="ReadabilityMasterHeadingText"
                                                              Text="当前范围内的 TransportDemand"
                                                              Style="{StaticResource SectionTitleText}" />
                                                <ui:TextBlock x:Name="ReadabilityPageSummaryText"
                                                              Text="尚无资格审计快照"
                                                              Style="{StaticResource CaptionText}"
                                                              Margin="0,3,0,0"
                                                              AutomationProperties.Name="资格审计精确总数与页码"
                                                              AutomationProperties.AutomationId="ReadabilityPageSummaryText" />
                                            </StackPanel>
                                            <Border x:Name="ReadabilityNotReadableCountPill"
                                                    Grid.Column="1"
                                                    Style="{StaticResource StatusPillCaution}"
                                                    VerticalAlignment="Center">
                                                <ui:TextBlock x:Name="ReadabilityNotReadableCountText"
                                                              Text="— 不可见"
                                                              FontTypography="BodyStrong" />
                                            </Border>
                                        </Grid>
                                        <DataGrid x:Name="ReadabilityAuditGrid"
                                                  Grid.Row="1"
                                                  RowHeight="72"
                                                  HeadersVisibility="None"
                                                  KeyboardNavigation.IsTabStop="True"
                                                  SelectionChanged="OnReadabilitySelectionChanged"
                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                  AutomationProperties.Name="资格审计 Demand 世代列表"
                                                  AutomationProperties.AutomationId="ReadabilityAuditGrid">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="4,7">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ui:TextBlock Text="{Binding DemandId}"
                                                                                  Style="{StaticResource CodeText}"
                                                                                  FontWeight="SemiBold" />
                                                                    <ui:TextBlock Grid.Column="1"
                                                                                  Text="{Binding ExternalReadabilityState}"
                                                                                  Style="{StaticResource BodyStrong}" />
                                                                </Grid>
                                                                <ui:TextBlock Grid.Row="1"
                                                                              Text="{Binding WorkType}"
                                                                              Style="{StaticResource CodeText}"
                                                                              Margin="0,4,0,0" />
                                                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="220" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ui:TextBlock Text="{Binding Sublot}" Style="{StaticResource CaptionText}" />
                                                                    <ui:TextBlock Grid.Column="1"
                                                                                  Text="{Binding LeadReadabilityBlocker}"
                                                                                  Style="{StaticResource CodeText}"
                                                                                  TextTrimming="CharacterEllipsis"
                                                                                  HorizontalAlignment="Right" />
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <ui:InfoBar x:Name="ReadabilityEmptyInfoBar"
                                                    Grid.Row="1"
                                                    IsOpen="False"
                                                    IsClosable="False"
                                                    Severity="Informational"
                                                    Title="当前条件零命中"
                                                    Message="Host 已成功返回精确 0 个 Demand 世代；这不代表接入系统整体健康。"
                                                    Margin="12"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.Name="资格审计成功零结果" />
                                        <Border Grid.Row="2"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="{StaticResource DemandSeriesPagingDividerThickness}"
                                                Padding="12,0">
                                            <WrapPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="0,4,8,4">
                                                    <ui:TextBlock Text="每页"
                                                                  Style="{StaticResource CaptionText}"
                                                                  VerticalAlignment="Center" />
                                                    <ComboBox x:Name="ReadabilityPageSizeInput"
                                                              SelectedIndex="0"
                                                              Width="62"
                                                              Margin="4,0,0,0"
                                                              SelectionChanged="OnReadabilityFilterDraftChanged"
                                                              KeyboardNavigation.IsTabStop="True"
                                                              AutomationProperties.Name="资格审计每页数量"
                                                              AutomationProperties.AutomationId="ReadabilityPageSizeInput">
                                                        <ComboBoxItem Content="100" Tag="100" />
                                                        <ComboBoxItem Content="200" Tag="200" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <ui:Button x:Name="ReadabilityClearFilterButton"
                                                           Content="清除条件"
                                                           Appearance="Transparent"
                                                           IsEnabled="False"
                                                           Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                           KeyboardNavigation.IsTabStop="True"
                                                           Click="OnReadabilityClearFiltersClick"
                                                           AutomationProperties.Name="清除资格审计条件"
                                                           AutomationProperties.AutomationId="ReadabilityClearFilterButton" />
                                                <ui:Button x:Name="ReadabilityPreviousPageButton"
                                                           Content="上一页"
                                                           Appearance="Secondary"
                                                           Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                           KeyboardNavigation.IsTabStop="True"
                                                           Click="OnReadabilityPreviousPageClick"
                                                           AutomationProperties.Name="资格审计上一页"
                                                           AutomationProperties.AutomationId="ReadabilityPreviousPageButton" />
                                                <ui:Button x:Name="ReadabilityNextPageButton"
                                                           Content="下一页"
                                                           Appearance="Secondary"
                                                           Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                           KeyboardNavigation.IsTabStop="True"
                                                           Click="OnReadabilityNextPageClick"
                                                           AutomationProperties.Name="资格审计下一页"
                                                           AutomationProperties.AutomationId="ReadabilityNextPageButton" />
                                                <TextBox x:Name="ReadabilityPageNumberInput"
                                                         Width="{StaticResource DemandSeriesPageNumberWidth}"
                                                         Margin="{StaticResource DemandSeriesCompactCommandMargin}"
                                                         KeyboardNavigation.IsTabStop="True"
                                                         AutomationProperties.Name="资格审计目标页码"
                                                         AutomationProperties.AutomationId="ReadabilityPageNumberInput" />
                                                <ui:Button x:Name="ReadabilityGoToPageButton"
                                                           Content="跳转"
                                                           Appearance="Secondary"
                                                           Margin="{StaticResource DemandSeriesCompactCommandLastMargin}"
                                                           KeyboardNavigation.IsTabStop="True"
                                                           Click="OnReadabilityGoToPageClick"
                                                           AutomationProperties.Name="资格审计直接页码跳转"
                                                           AutomationProperties.AutomationId="ReadabilityGoToPageButton" />
                                            </WrapPanel>
                                        </Border>
                                    </Grid>
                                </ui:Card>

                                <Grid x:Name="ReadabilityDetailRegion" Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="ReadabilityDetailNotices"
                                                Grid.Row="0">
                                        <ui:InfoBar x:Name="ReadabilityDetailInfoBar"
                                                    IsOpen="True"
                                                    IsClosable="False"
                                                    Severity="Informational"
                                                    Title="尚未选择 Demand"
                                                    Message="从左侧列表选择 Demand 后读取同一审计快照的资格检查与全部证据。"
                                                    AutomationProperties.Name="资格审计详情结论" />
                                    </StackPanel>
                                    <Grid x:Name="ReadabilityDetailCardsGrid" Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0.95*" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="1.05*" />
