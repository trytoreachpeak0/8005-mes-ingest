                                                                      Margin="0,3,12,0"
                                                                      TextWrapping="Wrap"
                                                                      AutomationProperties.Name="原始证据字段与边界" />
                                                    </StackPanel>
                                                    <ui:Button x:Name="ErrorSearchLoadRawEvidenceButton"
                                                               Grid.Column="1"
                                                               Content="加载原始证据"
                                                               Appearance="Secondary"
                                                               VerticalAlignment="Center"
                                                               Focusable="True"
                                                               KeyboardNavigation.IsTabStop="True"
                                                               Click="OnErrorSearchLoadRawEvidenceClick"
                                                               AutomationProperties.Name="按需加载受限原始证据"
                                                               AutomationProperties.AutomationId="ErrorSearchLoadRawEvidenceButton" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="4,8,4,8">
                                        <ui:TextBlock Text="仅请求白名单字段；默认不加载，失败不会替换错误历史或详情快照。"
                                                      Style="{StaticResource SecondaryText}"
                                                      Margin="{StaticResource DemandSeriesRelatedBottomMargin}" />
                                        <ui:InfoBar x:Name="ErrorSearchRawEvidenceInfoBar"
                                                    IsOpen="False"
                                                    IsClosable="False"
                                                    Severity="Informational"
                                                    Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                    AutomationProperties.Name="受限原始证据读取状态" />
                                        <DataGrid x:Name="ErrorSearchRawEvidenceGrid"
                                                  Height="{StaticResource Ticket22RawGridHeight}"
