                                                           AutomationProperties.Name="另存未命名 AREA 草稿"
                                                           AutomationProperties.AutomationId="AreaProfileSaveDraftAsButton" />
                                                <ui:Button x:Name="AreaProfileApplyButton"
                                                           Content="应用此配置"
                                                           Appearance="Secondary"
                                                           IsEnabled="False"
                                                           Margin="{StaticResource AreaProfileInlineCommandMargin}"
                                                           KeyboardNavigation.IsTabStop="True"
                                                           Click="OnAreaProfileApplyClick"
                                                           AutomationProperties.Name="应用选中 AREA 配置"
                                                           AutomationProperties.AutomationId="AreaProfileApplyButton" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ui:Card>

                                <ui:Card x:Name="AreaProfileEditorCard"
                                         Grid.Column="2"
