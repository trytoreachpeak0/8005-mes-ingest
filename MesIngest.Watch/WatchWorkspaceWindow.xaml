                                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Severity}" Value="ERROR">
                                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <ui:TextBlock Text="{Binding Severity}"
                                                                              FontTypography="Caption"
                                                                              FontWeight="SemiBold"
                                                                              Appearance="{x:Null}"
                                                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=(TextElement.Foreground)}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="发生时间"
                                                                    Binding="{Binding OccurredAt}"
                                                                    Width="{StaticResource DemandSeriesColumn170}"
                                                                    ElementStyle="{StaticResource DataGridTextCell}" />
                                                <DataGridTextColumn Header="稳定标识"
                                                                    Binding="{Binding StableIdentity}"
                                                                    Width="{StaticResource DemandSeriesColumn240}"
                                                                    ElementStyle="{StaticResource DataGridTextCell}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Grid.Row="2"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
