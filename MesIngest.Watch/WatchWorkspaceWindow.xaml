                                         AutomationProperties.AutomationId="CurrentAttentionEvidenceCard">
                                    <StackPanel>
                                        <ui:TextBlock Text="结构化证据" Style="{StaticResource SectionTitleText}" />
                                        <ui:TextBlock x:Name="CurrentAttentionSelectedContextText"
                                                      Text="选择一项查看其稳定标识与 Host 结构化证据。"
                                                      Style="{StaticResource SecondaryText}"
                                                      Margin="{StaticResource DemandSeriesControlTopMargin}"
                                                      AutomationProperties.Name="接入告警选中项上下文" />
                                        <DataGrid x:Name="CurrentAttentionEvidenceGrid"
                                                  Height="{StaticResource Ticket22ResultsGridMinHeight}"
                                                  Margin="{StaticResource DemandSeriesSubsectionHeadingMargin}"
                                                  Style="{StaticResource DemandSeriesReadOnlyGrid}"
                                                  Focusable="True"
                                                  KeyboardNavigation.IsTabStop="True"
                                                  AutomationProperties.Name="接入告警结构化证据字段"
                                                  AutomationProperties.AutomationId="CurrentAttentionEvidenceGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="{StaticResource DemandSeriesColumn150}" />
                                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <ui:Button x:Name="CurrentAttentionOpenErrorSearchButton"
                                                   Content="在错误检索中打开"
                                                   Appearance="Secondary"
                                                   HorizontalAlignment="Left"
                                                   Margin="{StaticResource DemandSeriesSubsectionHeadingMargin}"
                                                   Focusable="True"
                                                   KeyboardNavigation.IsTabStop="True"
                                                   Click="OnCurrentAttentionOpenErrorSearchClick"
                                                   AutomationProperties.Name="从当前 Series 错误下钻错误检索"
                                                   AutomationProperties.AutomationId="CurrentAttentionOpenErrorSearchButton" />
                                        <ui:TextBlock Text="仅活动 Series 错误提供该下钻；目标始终是 ACTIVE、明确分类与错误码、SeriesId 的新第一页。"
                                                      Style="{StaticResource SecondaryText}"
                                                      Margin="{StaticResource DemandSeriesControlTopMargin}" />
                                        <ui:TextBlock Text="只读页面：不创建 incident，也不提供人工确认、人工恢复或关闭操作。"
                                                      Style="{StaticResource SecondaryText}"
                                                      Margin="{StaticResource DemandSeriesControlTopMargin}" />
                                    </StackPanel>
                                </ui:Card>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="设置页面">
                        <StackPanel Margin="{StaticResource DemandSeriesCommandTileMargin}">
                            <ui:TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
                            <ui:TextBlock Text="单一 Host、始终开启的分视图自动刷新，以及本机显示偏好" Style="{StaticResource SecondaryText}" Margin="{StaticResource DemandSeriesControlTopMargin}" />
                            <ui:InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" Margin="{StaticResource DemandSeriesSectionTopMargin}" AutomationProperties.Name="设置操作状态" />

                            <Grid x:Name="SettingsColumns" Margin="{StaticResource DemandSeriesSectionTopMargin}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="SettingsVerticalGap" Height="0" />
                                    <RowDefinition x:Name="SettingsBottomRow" Height="0" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SettingsLeftColumn" Width="1*" />
                                    <ColumnDefinition x:Name="SettingsGapColumn" Width="16" />
                                    <ColumnDefinition x:Name="SettingsRightColumn" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource SurfaceCard}">
                                        <StackPanel>
                                            <ui:TextBlock Text="Host 连接" Style="{StaticResource SectionTitleText}" />
                                            <ui:TextBlock x:Name="SettingsHostStateText" Text="Host 未连接" Style="{StaticResource SecondaryText}" Margin="0,8,0,16" />
                                            <ui:TextBlock Text="服务地址" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="HostBaseUrlInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="Host 基址" />
                                            <ui:TextBlock Text="访问凭据" Style="{StaticResource FieldLabel}" />
                                            <PasswordBox x:Name="HostCredentialInput" PasswordChar="●" Padding="12,8" Margin="0,8,0,8" AutomationProperties.Name="只读 API 凭据" />
                                            <ui:TextBlock Text="留空继续使用当前外部配置凭据；输入值仅用于本次进程，保存后立即清空。" Style="{StaticResource SecondaryText}" />
                                            <ui:TextBlock Text="请求超时（秒）" Style="{StaticResource FieldLabel}" Margin="{StaticResource DemandSeriesActionTopMargin}" />
                                            <TextBox x:Name="RequestTimeoutInput" Width="120" HorizontalAlignment="Left" Margin="{StaticResource DemandSeriesControlTopMargin}" ToolTip="1–300 秒" AutomationProperties.Name="全局请求超时秒数" />
                                            <ui:Button x:Name="ApplyHostButton" Content="应用 Host 设置" Appearance="Secondary" HorizontalAlignment="Right" Margin="{StaticResource DemandSeriesSectionTopMargin}" Click="OnApplyHostClick" AutomationProperties.Name="应用 Host 设置" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SurfaceCard}" Margin="{StaticResource DemandSeriesSectionTopMargin}">
                                        <StackPanel>
                                            <ui:TextBlock Text="本机显示" Style="{StaticResource SectionTitleText}" />
                                            <CheckBox x:Name="RememberWindowSizeCheckBox" Content="记住窗口尺寸" Margin="{StaticResource DemandSeriesActionTopMargin}" AutomationProperties.Name="记住窗口尺寸" />
                                            <CheckBox x:Name="KeepNavigationPaneOpenCheckBox" Content="默认展开导航窗格" Margin="{StaticResource DemandSeriesControlTopMargin}" AutomationProperties.Name="默认展开导航窗格" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="RefreshSettingsCard" Grid.Column="2" Style="{StaticResource SurfaceCard}">
                                    <StackPanel>
                                        <ui:TextBlock Text="自动刷新间隔" Style="{StaticResource SectionTitleText}" />
                                        <ui:TextBlock Text="五个 Host 数据视图始终自动刷新；当前可见视图按所选间隔单飞调度。" Style="{StaticResource SecondaryText}" Margin="0,8,0,16" />
                                        <ui:TextBlock Text="概览" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="OverviewIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="概览自动刷新间隔" />
                                        <ui:TextBlock Text="需求系列" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="DemandSeriesIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="需求系列自动刷新间隔" />
                                        <ui:TextBlock Text="资格审计" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ReadabilityAuditIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="资格审计自动刷新间隔" />
                                        <ui:TextBlock Text="错误检索" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ErrorSearchIntervalInput" Margin="{StaticResource DemandSeriesControlToGroupMargin}" AutomationProperties.Name="错误检索自动刷新间隔" />
                                        <ui:TextBlock Text="接入告警" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CurrentAttentionIntervalInput" Margin="{StaticResource DemandSeriesControlTopMargin}" AutomationProperties.Name="接入告警自动刷新间隔" />
                                        <ui:Button x:Name="SaveRefreshIntervalsButton" Content="保存刷新与显示设置" Appearance="Secondary" HorizontalAlignment="Right" Margin="{StaticResource DemandSeriesSectionTopMargin}" Click="OnSaveLocalPreferencesClick" AutomationProperties.Name="保存刷新与显示设置" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
