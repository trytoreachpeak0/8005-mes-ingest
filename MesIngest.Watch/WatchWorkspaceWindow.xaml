                                    <StackPanel>
                                        <ui:TextBlock x:Name="CurrentAttentionHistoryScopeText"
                                                      Text="只读呈现全 Host 当前仍需关注的接入项；已结束的 Series 错误只在错误检索中保留。"
                                                      Style="{StaticResource CaptionText}"
                                                      TextWrapping="NoWrap"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                      AutomationProperties.Name="接入告警历史范围：只读呈现全 Host 当前仍需关注的接入项；已结束的 Series 错误只在错误检索中保留。" />
                                        <ui:TextBlock x:Name="CurrentAttentionSnapshotText"
