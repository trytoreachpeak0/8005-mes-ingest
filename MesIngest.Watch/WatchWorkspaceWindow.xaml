                                                            <Setter TargetName="AreaProfileRowAttentionText"
                                                                    Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAllAreas}" Value="True">
                                                            <Setter TargetName="AreaProfileRowValidStatus"
                                                                    Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                        <!-- The badge slot carries "currently applied" and nothing else,
                                                             so a profile that is applied and broken keeps saying both. -->
                                                        <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                            <Setter TargetName="AreaProfileRowValidStatus"
                                                                    Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Setter TargetName="AreaProfileRowStatusPill"
                                                                    Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter TargetName="AreaProfileRowValidStatus"
                                                                    Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Setter TargetName="AreaProfileRowAttentionText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter TargetName="AreaProfileRowSurface"
                                                                    Property="Background"
                                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            <Setter TargetName="AreaProfileRowNameText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorInverseBrush}" />
                                                            <Setter TargetName="AreaProfileRowMetadataText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorInverseBrush}" />
                                                            <Setter TargetName="AreaProfileRowValidStatus"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorInverseBrush}" />
                                                            <Setter TargetName="AreaProfileRowAttentionText"
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorInverseBrush}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
