                                                Padding="12,0">
                                        <WrapPanel VerticalAlignment="Center">
                                            <ui:Button x:Name="CurrentAttentionPreviousPageButton"
                                                       Content="上一页"
                                                       Appearance="Secondary"
                                                       Margin="{StaticResource DemandSeriesCompactCommandMargin}"
