                                                      Margin="{StaticResource DemandSeriesControlToGroupMargin}" />
                                        <WrapPanel x:Name="DemandSeriesFilterPanel"
                                                   AutomationProperties.Name="需求系列筛选">
                                            <StackPanel Width="{StaticResource DemandSeriesFilterWideWidth}" Margin="{StaticResource DemandSeriesFilterFieldMargin}">
                                                <ui:TextBlock Text="生命周期" Style="{StaticResource FieldLabel}" />
