                                                      Text="全 Host 当前关注；本机 AREA 配置不参与筛选、计数或分页。"
                                                      Style="{StaticResource CaptionText}"
                                                      Margin="0,2,0,0"
                                                      TextWrapping="NoWrap"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
