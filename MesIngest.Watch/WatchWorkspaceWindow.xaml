                                                <DataGridTextColumn Header="对象"
                                                                    Binding="{Binding SubjectSummary}"
                                                                    Width="{StaticResource DemandSeriesColumn190}"
                                                                    ElementStyle="{StaticResource DataGridTextCell}" />
                                                <DataGridTextColumn Header="类型"
                                                                    Binding="{Binding KindLabel}"
                                                                    Width="{StaticResource DemandSeriesColumn190}"
                                                                    ElementStyle="{StaticResource DataGridTextCell}" />
