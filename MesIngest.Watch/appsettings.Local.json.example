{
  "Watch": {
    "BaseUrl": "http://127.0.0.1:5088",
    "RefreshSeconds": 2,
    "RequestTimeoutSeconds": 30,
    "ConnectionLogRetentionDays": 30,
    "ConnectionLogMaxSizeMb": 100,
    "SharedSecret": ""
  },
  "_comments": {
    "RequestTimeoutSeconds": "Per-request HttpClient timeout; legal range 1-300. Env: MesIngestWatch__RequestTimeoutSeconds.",
    "ConnectionLogRetentionDays": "Local WatchConnectionEvent JSONL retention days (default 30).",
    "ConnectionLogMaxSizeMb": "Local log directory size cap in MiB (default 100). Whichever of days/size hits first wins.",
    "SharedSecret": "Must match Host MesIngest:SharedSecret when BaseUrl is not localhost."
  }
}
