<ui:FluentWindow x:Class="MesIngest.Watch.WatchDemandSeriesInspectorWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DemandSeries Inspector"
                 Width="1200"
                 Height="800"
                 MinWidth="720"
                 MinHeight="600"
                 ResizeMode="CanResize"
                 WindowStyle="SingleBorderWindow"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="True"
                 Topmost="False"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Segoe UI Variable, Microsoft YaHei UI"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 AutomationProperties.Name="DemandSeries Inspector"
                 AutomationProperties.AutomationId="DemandSeriesInspectorWindow">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WatchFluentDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="InspectorReadOnlyGrid"
                   TargetType="DataGrid"
                   BasedOn="{StaticResource WatchDataGrid}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="CanUserSortColumns" Value="False" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="InspectorTitleBar"
                     Grid.Row="0"
                     Title="DemandSeries Inspector"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     AutomationProperties.Name="DemandSeries Inspector 标题栏">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Timeline24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1"
                Margin="24,16,24,12"
                Padding="16,12"
                Style="{StaticResource SurfaceCard}"
                AutomationProperties.Name="Series 与冻结快照上下文"
                AutomationProperties.AutomationId="DemandSeriesInspectorContext">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:TextBlock x:Name="InspectorSeriesContextText"
                                  Style="{StaticResource BodyStrong}"
                                  Text="尚未选择 DemandSeries" />
                    <ui:TextBlock x:Name="InspectorSnapshotContextText"
                                  Margin="0,8,0,0"
                                  Style="{StaticResource SecondaryText}"
                                  Text="尚无冻结快照" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <ui:TextBlock x:Name="InspectorLifecycleText" Text="—" />
                    </Border>
                    <Border Margin="8,0,0,0" Style="{StaticResource StatusPill}">
                        <ui:TextBlock x:Name="InspectorPresenceText" Text="—" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="DemandSeriesInspectorTabs"
                    Grid.Row="2"
                    Margin="24,0,24,24"
                    Focusable="True"
                    KeyboardNavigation.IsTabStop="True"
                    AutomationProperties.Name="DemandSeries Inspector 调查任务"
                    AutomationProperties.AutomationId="DemandSeriesInspectorTabs">
            <TabItem Header="世代分析"
                     AutomationProperties.Name="世代分析"
                     AutomationProperties.AutomationId="DemandSeriesInspectorGenerationTab">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SurfaceCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock Text="Demand 世代"
                                          Margin="16,12"
                                          Style="{StaticResource SectionTitleText}" />
                            <ListBox x:Name="DemandSeriesInspectorGenerationList"
                                     Grid.Row="1"
                                     BorderThickness="0"
                                     SelectionChanged="OnGenerationSelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="Demand 世代导航"
                                     AutomationProperties.AutomationId="DemandSeriesInspectorGenerationList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="8" Style="{StaticResource StatusPill}">
                                                <TextBlock Text="{Binding Generation, StringFormat=第 {0} 代}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <ui:TextBlock Text="{Binding DemandId}"
                                                              FontTypography="Body" />
                                                    <TextBlock Style="{StaticResource SecondaryText}">
                                                        <Run Text="{Binding Status}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding CurrentMarker}" />
                                                    </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource SurfaceCard}">
                                <StackPanel>
                                    <ui:TextBlock x:Name="DemandSeriesInspectorGenerationIdentityText"
                                                  Style="{StaticResource BodyStrong}"
                                                  AutomationProperties.Name="选中 Demand 世代身份"
                                                  AutomationProperties.AutomationId="DemandSeriesInspectorGenerationIdentity" />
                                    <ui:TextBlock x:Name="DemandSeriesInspectorFormationReasonText"
                                                  Margin="0,8,0,0"
                                                  Style="{StaticResource SectionTitleText}"
                                                  AutomationProperties.Name="Demand 形成原因"
                                                  AutomationProperties.AutomationId="DemandSeriesInspectorFormationReason" />
                                    <ui:TextBlock x:Name="DemandSeriesInspectorFormationReasonCodeText"
                                                  Margin="0,8,0,0"
                                                  Style="{StaticResource CodeText}"
                                                  AutomationProperties.Name="Demand 形成原因原始码" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                                <StackPanel>
                                    <ui:TextBlock Text="形成事实" Style="{StaticResource SectionTitleText}" />
                                    <ItemsControl x:Name="DemandSeriesInspectorFormationFacts"
                                                  Margin="0,8,0,0"
                                                  AutomationProperties.Name="Demand 形成事实"
                                                  AutomationProperties.AutomationId="DemandSeriesInspectorFormationFacts">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBlock Text="{Binding Label}"
                                                                  Style="{StaticResource FieldLabel}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Value}" />
                                                        <TextBlock Style="{StaticResource SecondaryText}">
                                                            <Run Text="{Binding OccurredAt}" />
                                                            <Run Text=" · PollTrace " />
                                                            <Run Text="{Binding PollTraceId}" />
                                                            <Run Text=" · Commit " />
                                                            <Run Text="{Binding ProjectionCommitId}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="220" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:TextBlock Text="MES 边界观察" Style="{StaticResource SectionTitleText}" />
                                    <ui:TextBlock x:Name="DemandSeriesInspectorBeforeEvidenceText"
                                                  Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  Style="{StaticResource SecondaryText}"
                                                  AutomationProperties.Name="前代 MES 观察状态"
                                                  AutomationProperties.AutomationId="DemandSeriesInspectorBeforeEvidence" />
                                    <ui:TextBlock x:Name="DemandSeriesInspectorAfterEvidenceText"
                                                  Grid.Row="2"
                                                  Margin="0,8,0,8"
                                                  Style="{StaticResource BodyStrong}"
                                                  AutomationProperties.Name="首次观察 MES 证据" />
                                    <DataGrid x:Name="DemandSeriesInspectorAfterObservationGrid"
                                              Grid.Row="3"
                                              Style="{StaticResource InspectorReadOnlyGrid}"
                                              AutomationProperties.Name="首次观察 MES 原始行"
                                              AutomationProperties.AutomationId="DemandSeriesInspectorAfterObservationGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="45" />
                                            <DataGridTextColumn Header="TASK_TYPE" Binding="{Binding WorkType}" Width="130" />
                                            <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="120" />
                                            <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="90" />
                                            <DataGridTextColumn Header="EQP" Binding="{Binding Eqp}" Width="110" />
                                            <DataGridTextColumn Header="STEP" Binding="{Binding Step}" Width="120" />
                                            <DataGridTextColumn Header="DATES / MesSourceDate" Binding="{Binding MesSourceDate}" Width="180" />
                                            <DataGridTextColumn Header="PACKAGE" Binding="{Binding Package}" Width="120" />
                                            <DataGridTextColumn Header="PollTrace" Binding="{Binding PollTraceId}" Width="150" />
                                            <DataGridTextColumn Header="ProjectionCommit" Binding="{Binding ProjectionCommitId}" Width="170" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ui:TextBlock x:Name="DemandSeriesInspectorMesExplanationText"
                                                  Grid.Row="4"
                                                  Margin="0,8,0,0"
                                                  Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="事件"
                     AutomationProperties.Name="事件"
                     AutomationProperties.AutomationId="DemandSeriesInspectorEventsTab">
                <Border Margin="0,16,0,0" Style="{StaticResource SurfaceCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock x:Name="DemandSeriesInspectorEventContextText"
                                      Margin="0,0,0,8"
                                      Style="{StaticResource SecondaryText}"
                                      AutomationProperties.Name="事件 DemandId 过滤上下文"
                                      AutomationProperties.AutomationId="DemandSeriesInspectorEventContext" />
                        <DataGrid x:Name="DemandSeriesInspectorEventGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource InspectorReadOnlyGrid}"
                                  AutomationProperties.Name="DemandSeries 永久事件"
                                  AutomationProperties.AutomationId="DemandSeriesInspectorEventGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SEQ" Binding="{Binding SeriesSequence}" Width="65" />
                            <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="210" />
                            <DataGridTextColumn Header="发生时间" Binding="{Binding OccurredAt}" Width="170" />
                            <DataGridTextColumn Header="主体类型" Binding="{Binding SubjectKind}" Width="140" />
                            <DataGridTextColumn Header="主体 ID" Binding="{Binding SubjectId}" Width="180" />
                            <DataGridTextColumn Header="PollTrace" Binding="{Binding PollTraceId}" Width="160" />
                            <DataGridTextColumn Header="ProjectionCommit" Binding="{Binding ProjectionCommitId}" Width="180" />
                            <DataGridTextColumn Header="Payload" Binding="{Binding PayloadJson}" Width="300" />
                        </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
