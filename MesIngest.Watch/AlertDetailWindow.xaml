<Window x:Class="MesIngest.Watch.AlertDetailWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MesIngest.Watch"
        Title="Alert detail"
        Height="600"
        Width="900"
        MinHeight="480"
        MinWidth="720"
        Background="{DynamicResource WatchBackgroundBrush}"
        AutomationProperties.Name="IngestAlert 详情窗口"
        KeyboardNavigation.TabNavigation="Continue"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:WatchThemeDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <WrapPanel x:Name="AlertDetailActionPanel" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CopySummaryButton" AutomationProperties.Name="复制 IngestAlert 摘要" Content="Copy summary" Margin="0,0,8,6" Padding="10,4" Click="OnCopySummary" />
            <Button x:Name="CopyDetailsButton" AutomationProperties.Name="复制 IngestAlert Details JSON" Content="Copy Details JSON" Margin="0,0,8,6" Padding="10,4" Click="OnCopyDetails" />
            <StackPanel x:Name="GenericDemandActionsPanel" Orientation="Horizontal">
                <Button x:Name="CopyDemandIdButton" AutomationProperties.Name="复制关联 TransportDemand DemandId" Content="Copy DemandId" Margin="0,0,8,6" Padding="10,4" Click="OnCopyDemandId" />
                <Button x:Name="LocateDemandButton" AutomationProperties.Name="精确查看关联 TransportDemand" Content="查看 TransportDemand" Margin="0,0,0,6" Padding="10,4" Click="OnLocateDemand" />
            </StackPanel>
        </WrapPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="SnapshotStatusText" AutomationProperties.Name="IngestAlert 快照状态" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AlertId" FontWeight="SemiBold" />
                    <TextBlock x:Name="AlertIdText" AutomationProperties.Name="IngestAlert AlertId" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="Consolas" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Code" FontWeight="SemiBold" />
                    <TextBlock x:Name="CodeText" AutomationProperties.Name="IngestAlert Code" Grid.Row="1" Grid.Column="1" Margin="0,0,8,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Severity" FontWeight="SemiBold" />
                    <TextBlock x:Name="SeverityText" AutomationProperties.Name="IngestAlert Severity" Grid.Row="1" Grid.Column="3" Margin="0,0,0,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Source" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceText" AutomationProperties.Name="IngestAlert Source" Grid.Row="2" Grid.Column="1" Margin="0,0,8,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Lifecycle" FontWeight="SemiBold" />
                    <TextBlock x:Name="LifecycleText" AutomationProperties.Name="IngestAlert Lifecycle" Grid.Row="2" Grid.Column="3" Margin="0,0,0,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="First seen" FontWeight="SemiBold" />
                    <TextBlock x:Name="FirstSeenText" AutomationProperties.Name="IngestAlert FirstSeenAt" Grid.Row="3" Grid.Column="1" Margin="0,0,8,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Last seen" FontWeight="SemiBold" />
                    <TextBlock x:Name="LastSeenText" AutomationProperties.Name="IngestAlert LastSeenAt" Grid.Row="3" Grid.Column="3" Margin="0,0,0,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Resolved at" FontWeight="SemiBold" />
                    <TextBlock x:Name="ResolvedAtText" AutomationProperties.Name="IngestAlert ResolvedAt" Grid.Row="4" Grid.Column="1" Margin="0,0,8,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Created at" FontWeight="SemiBold" />
                    <TextBlock x:Name="CreatedAtText" AutomationProperties.Name="IngestAlert CreatedAt" Grid.Row="4" Grid.Column="3" Margin="0,0,0,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Count" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountText" AutomationProperties.Name="IngestAlert OccurrenceCount" Grid.Row="5" Grid.Column="1" Margin="0,0,8,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="TASK_TYPE" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskTypeText" AutomationProperties.Name="IngestAlert TASK_TYPE" Grid.Row="6" Grid.Column="1" Margin="0,0,8,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="SUBLOT" FontWeight="SemiBold" />
                    <TextBlock x:Name="SublotText" AutomationProperties.Name="IngestAlert SUBLOT" Grid.Row="6" Grid.Column="3" Margin="0,0,0,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="DemandId" FontWeight="SemiBold" />
                    <TextBlock x:Name="DemandIdText" AutomationProperties.Name="IngestAlert DemandId" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="Consolas" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Message" FontWeight="SemiBold" />
                    <TextBlock x:Name="MessageText" AutomationProperties.Name="IngestAlert Message" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4" TextWrapping="Wrap" />
                </Grid>

                <Border x:Name="ReappearDemandActionsPanel"
                        BorderBrush="{StaticResource WatchBorderBrush}"
                        Background="{StaticResource WatchSurfaceBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="REAPPEAR_AFTER_GONE 关联 TransportDemand" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="PreviousDemandActionsPanel" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="PreviousDemandRoleText" Text="先前 GONE" Width="180" VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviousDemandIdText" AutomationProperties.Name="先前 GONE DemandId" Width="220" VerticalAlignment="Center" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Button x:Name="CopyPreviousDemandIdButton" AutomationProperties.Name="复制先前 GONE DemandId" Content="复制先前 DemandId" Margin="8,0,6,0" Padding="8,3" Click="OnCopyPreviousDemandId" />
                            <Button x:Name="LocatePreviousDemandButton" AutomationProperties.Name="精确查看先前 GONE TransportDemand" Content="精确查看先前 GONE" Padding="8,3" Click="OnLocatePreviousDemand" />
                        </WrapPanel>
                        <WrapPanel x:Name="NewDemandActionsPanel" Orientation="Horizontal">
                            <TextBlock x:Name="NewDemandRoleText" Text="当前再现" Width="180" VerticalAlignment="Center" />
                            <TextBlock x:Name="NewDemandIdText" AutomationProperties.Name="当前再现 DemandId" Width="220" VerticalAlignment="Center" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Button x:Name="CopyNewDemandIdButton" AutomationProperties.Name="复制当前再现 DemandId" Content="复制当前 DemandId" Margin="8,0,6,0" Padding="8,3" Click="OnCopyNewDemandId" />
                            <Button x:Name="LocateNewDemandButton" AutomationProperties.Name="精确查看当前再现 TransportDemand" Content="精确查看当前再现" Padding="8,3" Click="OnLocateNewDemand" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="BusinessKeyDemandActionsPanel"
                        BorderBrush="{StaticResource WatchBorderBrush}"
                        Background="{StaticResource WatchSurfaceBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="此告警没有 DemandId；可按 TASK_TYPE + SUBLOT 查看当前 VISIBLE 任务，但结果不代表唯一历史实例。"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button x:Name="SearchBusinessKeyButton"
                                AutomationProperties.Name="按 TASK_TYPE 和 SUBLOT 查当前 VISIBLE TransportDemand"
                                Content="按业务键查任务"
                                HorizontalAlignment="Left"
                                Padding="10,4"
                                Click="OnSearchBusinessKey" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Related TransportDemand snapshots" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="RelatedDemandStatusText"
                           AutomationProperties.Name="关联 TransportDemand 加载状态"
                           Foreground="{StaticResource WatchSecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <DataGrid x:Name="RelatedDemandGrid"
                          AutomationProperties.Name="关联 TransportDemand 快照"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          MaxHeight="420"
                          Visibility="Collapsed"
                          Margin="0,0,0,12">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Field}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WatchChangedBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="ToolTip" Value="Previous and current values differ" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" AutomationProperties.Name="关联 TransportDemand 字段列" Binding="{Binding Field}" Width="160" />
                        <DataGridTextColumn Header="Previous (GONE)" AutomationProperties.Name="先前 GONE 值列" Binding="{Binding PreviousValue}" Width="*" />
                        <DataGridTextColumn Header="Current (VISIBLE)" AutomationProperties.Name="当前 VISIBLE 值列" Binding="{Binding CurrentValue}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="LegacyDetailsText" AutomationProperties.Name="IngestAlert 旧版详情" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8" />
                <DataGrid x:Name="FieldDriftGrid"
                          AutomationProperties.Name="IngestAlert 字段漂移详情"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          MaxHeight="220"
                          Visibility="Collapsed"
                          Margin="0,0,0,8">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Field}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" AutomationProperties.Name="字段漂移 Field 列" Binding="{Binding Field}" Width="120" />
                        <DataGridTextColumn Header="Frozen" AutomationProperties.Name="字段漂移 Frozen 列" Binding="{Binding Frozen}" Width="*" />
                        <DataGridTextColumn Header="Observed" AutomationProperties.Name="字段漂移 Observed 列" Binding="{Binding Observed}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="KeyValueGrid"
                          AutomationProperties.Name="IngestAlert 键值详情"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          MaxHeight="220"
                          Visibility="Collapsed"
                          Margin="0,0,0,8">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Key}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" AutomationProperties.Name="详情 Key 列" Binding="{Binding Key}" Width="180" />
                        <DataGridTextColumn Header="Value" AutomationProperties.Name="详情 Value 列" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyDetailsText" AutomationProperties.Name="IngestAlert 无结构化详情" Text="(no structured details)" Visibility="Collapsed" Margin="0,0,0,8" />
                <TextBlock x:Name="LocateHintText" AutomationProperties.Name="关联 TransportDemand 定位提示" Foreground="{StaticResource WatchErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
