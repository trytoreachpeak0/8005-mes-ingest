{
  "MesIngest": {
    "SnapshotSource": "Oracle",
    "QueriesDirectory": "queries",
    "OracleUser": "",
    "OraclePassword": "",
    "OracleDataSource": "",
    "OracleMode": "Thin",
    "OracleInstantClientDir": "",
    "OracleThickOdbcDriver": "",
    "OracleConnectTimeoutSeconds": 30,
    "OracleMinPoolSize": 0,
    "OracleMaxPoolSize": 4,
    "RunOneShotOnStartup": false,
    "ContinuousPollEnabled": true,
    "PostPollDelaySeconds": 60,
    "QueryTimeoutSeconds": 30,
    "HistoryCleanupCheckIntervalSeconds": 3600,
