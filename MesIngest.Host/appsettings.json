    "HistoryCleanupMaximumSeriesPerBatch": 25,
    "HistoryCleanupTimeBudgetSeconds": 15,
    "ZeroDropEnterThreshold": 10,
    "ZeroDropClearStreak": 2,
    "Urls": "http://127.0.0.1:5088",
    "SharedSecret": "",
    "NewSqlServerConnectionString": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
