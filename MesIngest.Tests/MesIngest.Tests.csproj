<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xunit.v3 added Assert.Equal<T>(ReadOnlySpan<T>, T[]) and similar span
         overloads. `Assert.Equal(["a"], somethingReturningString?[])` binds to
         them, and `string?` trips their `where T : IEquatable<T>` constraint —
         42 call sites, 284 warnings, none of them a real defect: the comparison
         itself is correct and `string` does implement IEquatable<string>.
         Avoiding the overload would mean rewriting every one of those asserts to
         keep actual off `T[]`. Suppressed here only, and only these two codes. -->
    <NoWarn>$(NoWarn);CS8631;CS8620</NoWarn>

    <!-- Two xunit.v3 analyzer rules the migration inherited, both style advice
         rather than defects, and both too large to fold into a toolchain change:
         xUnit1051 (201 sites) wants TestContext.Current.CancellationToken passed
         to every call that accepts one, which changes what these tests cancel;
         xUnit2031 (39 sites) wants Assert.Single(xs, predicate) instead of
         Assert.Single(xs.Where(predicate)). Left as tracked debt, not waived
         forever. xUnit3003 was fixed instead — it was two attributes and it
         costs source location on failure. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit2031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MesIngest.Core\MesIngest.Core.csproj" />
    <ProjectReference Include="..\MesIngest.Host\MesIngest.Host.csproj" />
    <ProjectReference Include="..\MesIngest.LocalAdministration\MesIngest.LocalAdministration.csproj" />
    <ProjectReference Include="..\MesIngest.ReferenceConsumer\MesIngest.ReferenceConsumer.csproj" />
    <ProjectReference Include="..\MesIngest.Watch\MesIngest.Watch.csproj" />
  </ItemGroup>

</Project>
