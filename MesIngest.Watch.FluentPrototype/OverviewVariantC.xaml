<UserControl x:Class="MesIngest.Watch.FluentPrototype.OverviewVariantC" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources><Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}"><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="210" /></Grid.RowDefinitions>
        <ui:Card Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="16,14,16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBlock Text="分页运行总表" Style="{StaticResource Subtitle}" /><TextBlock Grid.Column="1" Text="主要规模" Style="{StaticResource Caption}" /><TextBlock Grid.Column="2" Text="需要关注" Style="{StaticResource Caption}" /><TextBlock Grid.Column="3" Text="当前范围 / 状态" Style="{StaticResource Caption}" /><TextBlock Grid.Column="4" Text="最近成功" Style="{StaticResource Caption}" /><TextBlock Grid.Column="5" Text="" /></Grid>
            <Border Grid.Row="1" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Timeline24" Foreground="{StaticResource WatchAccentBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="需求系列" Style="{StaticResource BodyStrong}" /><TextBlock Text="完整生命周期和事件流" Style="{StaticResource Caption}" /></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="2,347 Series" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="2 GONE · 1 归档后可见" Foreground="{StaticResource WatchWarningBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="东区 · 6 个结果" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="12:42:14" Style="{StaticResource CodeText}" VerticalAlignment="Center" /><ui:Button Grid.Column="5" Appearance="Secondary" Content="打开" /></Grid></Border>
            <Border Grid.Row="2" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="{StaticResource WatchAccentBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="资格审计" Style="{StaticResource BodyStrong}" /><TextBlock Text="外部可读性与阻断原因" Style="{StaticResource Caption}" /></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="2,347 Demand" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="505 不可见或阻断" Foreground="{StaticResource WatchCriticalBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="东区 · 7 个结果" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="12:42:14" Style="{StaticResource CodeText}" VerticalAlignment="Center" /><ui:Button Grid.Column="5" Appearance="Secondary" Content="打开" /></Grid></Border>
            <Border Grid.Row="3" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource WatchAccentBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="错误检索" Style="{StaticResource BodyStrong}" /><TextBlock Text="历史错误分类与命中证据" Style="{StaticResource Caption}" /></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="76 Series / 24h" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="19 个活动错误" Foreground="{StaticResource WatchCriticalBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="全部 AREA" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="12:42:16" Style="{StaticResource CodeText}" VerticalAlignment="Center" /><ui:Button Grid.Column="5" Appearance="Secondary" Content="打开" /></Grid></Border>
            <Border Grid.Row="4" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Filter24" Foreground="{StaticResource WatchAccentBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="AREA 筛选" Style="{StaticResource BodyStrong}" /><TextBlock Text="本地显示范围配置" Style="{StaticResource Caption}" /></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="5 个配置" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="无校验错误" Foreground="{StaticResource WatchSuccessBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="东区 · 12 AREA" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="12:42:16" Style="{StaticResource CodeText}" VerticalAlignment="Center" /><ui:Button Grid.Column="5" Appearance="Secondary" Content="管理" /></Grid></Border>
            <Border Grid.Row="5" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Alert24" Foreground="{StaticResource WatchCriticalBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="接入告警" Style="{StaticResource BodyStrong}" /><TextBlock Text="MES 接入异常与恢复历史" Style="{StaticResource Caption}" /></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="3 个活动" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="2 ERROR · 1 WARNING" Foreground="{StaticResource WatchCriticalBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="全局" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="12:41:52" Style="{StaticResource CodeText}" VerticalAlignment="Center" /><ui:Button Grid.Column="5" Appearance="Secondary" Content="打开" /></Grid></Border>
        </Grid></ui:Card>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ui:Card Padding="16"><StackPanel><TextBlock Text="Host" Style="{StaticResource Caption}" /><TextBlock Text="已连接 · 契约兼容" Style="{StaticResource Subtitle}" Margin="0,7,0,0" /><TextBlock Text="轮询成功 3.0 秒 · MES 快照 100 行" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel></ui:Card><ui:Card Grid.Column="2" Padding="16"><StackPanel><TextBlock Text="当前范围" Style="{StaticResource Caption}" /><TextBlock Text="东区 · 12 个 AREA" Style="{StaticResource Subtitle}" Margin="0,7,0,0" /><TextBlock Text="成功应用 · 需求系列与资格审计共享" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel></ui:Card><ui:Card Grid.Column="4" Padding="16"><StackPanel><TextBlock Text="全局关注" Style="{StaticResource Caption}" /><TextBlock Text="19 错误 · 3 告警" Style="{StaticResource Subtitle}" Foreground="{StaticResource WatchCriticalBrush}" Margin="0,7,0,0" /><TextBlock Text="最新事件 12:41:52" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel></ui:Card></Grid>
    </Grid>
</UserControl>
