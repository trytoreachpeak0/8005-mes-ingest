<UserControl x:Class="MesIngest.Watch.FluentPrototype.OverviewVariantB" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources><Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}"><Setter Property="VerticalAlignment" Value="Stretch" /></Style></UserControl.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
        <ui:Card Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Margin="16,14,16,12"><TextBlock Text="待关注" Style="{StaticResource Subtitle}" /><TextBlock Text="跨分页汇总的活动异常和状态变化" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Row="1">
            <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchCriticalSoftBrush}"><ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource WatchCriticalBrush}" /></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="19 个活动错误" Style="{StaticResource BodyStrong}" /><TextBlock Text="错误检索 · 近 24 小时共命中 76 个需求系列" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /><TextBlock Text="最常见：数据格式 7 · 一致性冲突 5 · 源数据漂移 4" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel><ui:Button Grid.Column="2" Appearance="Secondary" Content="打开错误检索" VerticalAlignment="Center" /></Grid></Border>
            <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchWarningSoftBrush}"><ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="{StaticResource WatchWarningBrush}" /></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="505 个 Demand 当前不可读" Style="{StaticResource BodyStrong}" /><TextBlock Text="资格审计 · 可读率 78.5%" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /><TextBlock Text="阻断 214 · GONE 226 · 已归档 65" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel><ui:Button Grid.Column="2" Appearance="Secondary" Content="打开资格审计" VerticalAlignment="Center" /></Grid></Border>
            <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchWarningSoftBrush}"><ui:SymbolIcon Symbol="Timeline24" Foreground="{StaticResource WatchWarningBrush}" /></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="3 个需求系列状态需要复核" Style="{StaticResource BodyStrong}" /><TextBlock Text="需求系列 · 2 GONE · 1 归档后可见" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /><TextBlock Text="最新：DS-000577 于 12:42:11 再次可见" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel><ui:Button Grid.Column="2" Appearance="Secondary" Content="打开需求系列" VerticalAlignment="Center" /></Grid></Border>
            <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchCriticalSoftBrush}"><ui:SymbolIcon Symbol="Alert24" Foreground="{StaticResource WatchCriticalBrush}" /></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="3 条活动接入告警" Style="{StaticResource BodyStrong}" /><TextBlock Text="接入告警 · 2 ERROR · 1 WARNING" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /><TextBlock Text="最近：FIELD_DRIFT · WIRE_TO_GATE · 12:41:52" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel><ui:Button Grid.Column="2" Appearance="Secondary" Content="打开接入告警" VerticalAlignment="Center" /></Grid></Border>
        </StackPanel></Grid></ui:Card>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="1*" /><RowDefinition Height="12" /><RowDefinition Height="1*" /></Grid.RowDefinitions>
            <ui:Card Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="数据页摘要" Style="{StaticResource Subtitle}" /><TextBlock Text="最近成功窗口" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="12:42:16" Style="{StaticResource Caption}" /></Grid><Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="需求系列" Style="{StaticResource Caption}" /><TextBlock Text="2,347" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="东区范围 6" Style="{StaticResource Caption}" Margin="0,3,0,0" /><TextBlock Text="资格审计" Style="{StaticResource Caption}" Margin="0,18,0,0" /><TextBlock Text="1,842 可读" FontSize="22" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="错误检索" Style="{StaticResource Caption}" /><TextBlock Text="76 命中" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="19 活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource Caption}" Margin="0,3,0,0" /><TextBlock Text="接入告警" Style="{StaticResource Caption}" Margin="0,18,0,0" /><TextBlock Text="3 活动" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WatchCriticalBrush}" /></StackPanel></Grid></Grid></ui:Card>
            <ui:Card Grid.Row="2" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="当前显示范围" Style="{StaticResource Subtitle}" /><Border Padding="14" CornerRadius="8" Background="{StaticResource WatchAccentSoftBrush}" Margin="0,14,0,0"><StackPanel><TextBlock Text="东区 · 12 个 AREA" Style="{StaticResource BodyStrong}" /><TextBlock Text="已应用 · 配置有效" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel></Border><TextBlock Text="需求系列：6 / 2,347" Style="{StaticResource BodySecondary}" Margin="0,14,0,0" /><TextBlock Text="资格审计：7 个 Demand" Style="{StaticResource BodySecondary}" Margin="0,7,0,0" /><ui:Button Appearance="Secondary" Content="管理 AREA 筛选" HorizontalAlignment="Left" Margin="0,16,0,0" /></StackPanel></ui:Card>
        </Grid>
    </Grid>
</UserControl>
