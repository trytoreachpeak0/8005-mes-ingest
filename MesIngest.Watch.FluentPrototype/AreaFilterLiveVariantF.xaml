<UserControl x:Class="MesIngest.Watch.FluentPrototype.AreaFilterLiveVariantF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- PROTOTYPE F: one full-width list. The selected profile expands its editor inline, accordion style. -->
    <ui:Card Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid Margin="16,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="筛选配置" Style="{StaticResource Subtitle}" />
                    <TextBlock Text="3 个文件 · 1 个需要修复 · 每行一个 AREA，如 A1-1" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBox Grid.Column="1" Margin="20,0" MaxWidth="320" HorizontalAlignment="Left" VerticalAlignment="Center" Text="搜索配置" Foreground="{StaticResource WatchTextTertiaryBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary" Content="＋ 新建" Padding="10,5" />
                    <ui:Button Appearance="Secondary" Content="📁 打开配置文件夹" Padding="10,5" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="▸" Style="{StaticResource BodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="全部 AREA（不筛选）" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="不限制显示范围" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="3" Appearance="Secondary" Content="应用" Padding="14,5" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource WatchAccentSoftBrush}" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="▾" Style="{StaticResource BodyStrong}" Foreground="{StaticResource WatchAccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="老厂前线焊线键合" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="当前应用" Foreground="White" Style="{StaticResource Caption}" /></Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ValidSummary" Text="7 个 AREA · 格式有效" Style="{StaticResource Caption}" Foreground="{StaticResource WatchSuccessBrush}" />
                                <TextBlock x:Name="InvalidSummary" Text="⚠ 第 8 行格式无效 · 显示范围仍为上一次有效的 7 个 AREA" Style="{StaticResource Caption}" Foreground="{StaticResource WatchCriticalBrush}" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="SyncText" Grid.Column="3" Text="已同步 · 15:07:57" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Grid.Column="4" Appearance="Secondary" Content="⋯" Padding="11,5" ToolTip="另存为 / 重命名 / 删除">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="另存为…" />
                                        <MenuItem Header="重命名…" />
                                        <Separator />
                                        <MenuItem Header="删除…" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource WatchSubtleBrush}" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,0,0,1" Padding="38,12,16,14">
                        <Border MinHeight="300" BorderBrush="{StaticResource WatchStrokeStrongBrush}" BorderThickness="1" CornerRadius="4" Background="{StaticResource WatchSurfaceStrongBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource WatchSubtleBrush}">
                                    <TextBlock x:Name="LineNumbers" Text="1&#x0a;2&#x0a;3&#x0a;4&#x0a;5&#x0a;6&#x0a;7&#x0a;8" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource WatchTextTertiaryBrush}" TextAlignment="Right" LineHeight="24" Padding="0,10,9,10" />
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource WatchStrokeBrush}" />
                                <TextBox x:Name="EditorText" Grid.Column="2" Text="N1-1&#x0a;N1-2&#x0a;N1-3&#x0a;N1-4&#x0a;N1-5&#x0a;N1-6&#x0a;N1-7" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" TextBlock.LineHeight="24" Padding="12,10" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Border>

                    <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="▸" Style="{StaticResource BodySecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="老厂前线装片" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="1 个 AREA · 格式有效" Style="{StaticResource Caption}" Foreground="{StaticResource WatchSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="已同步 · 15:03:58" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Grid.Column="4" Appearance="Primary" Content="应用此配置" Padding="14,5" />
                        </Grid>
                    </Border>

                    <Border Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="▸" Style="{StaticResource BodySecondary}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="临时范围" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="无效" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource Caption}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="第 3 行格式无效 · 不能应用" Style="{StaticResource Caption}" Foreground="{StaticResource WatchCriticalBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="已同步 · 昨天 18:22" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Grid.Column="4" Appearance="Secondary" Content="应用此配置" Padding="14,5" IsEnabled="False" />
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ui:Card>
</UserControl>
