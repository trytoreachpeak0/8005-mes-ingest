<UserControl x:Class="MesIngest.Watch.FluentPrototype.DemandSeriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DemandSeries" Style="{StaticResource PageTitle}" />
                <TextBlock Text="全部运输需求业务键的完整生命周期 · 最近成功 12:42:16 · 自动刷新 10 秒" Style="{StaticResource BodySecondary}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}"><TextBlock Text="Tracking 4" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></Border>
                <Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchSubtleBrush}" Margin="8,0,0,0"><TextBlock Text="Archived 2" Style="{StaticResource BodyStrong}" /></Border>
            </StackPanel>
        </Grid>

        <ui:Card Grid.Row="2" Padding="12" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="155" /><ColumnDefinition Width="12" /><ColumnDefinition Width="170" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="生命周期" Style="{StaticResource Caption}" Margin="0,0,0,5" /><StackPanel Orientation="Horizontal"><ui:Button Appearance="Primary" Content="全部" Padding="14,6" /><ui:Button Appearance="Transparent" Content="Tracking" Padding="14,6" Margin="4,0,0,0" /><ui:Button Appearance="Transparent" Content="Archived" Padding="14,6" Margin="4,0,0,0" /></StackPanel></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="WORKTYPE" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="全部工序类型" /><ComboBoxItem Content="STAGING_TO_WIRE" /><ComboBoxItem Content="WIRE_TO_GATE" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="出现状态" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="全部" /><ComboBoxItem Content="VISIBLE" /><ComboBoxItem Content="GONE" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="SUBLOT" Style="{StaticResource Caption}" Margin="0,0,0,5" /><TextBox ToolTip="SUBLOT" /></StackPanel>
                <StackPanel Grid.Column="8"><TextBlock Text="SeriesId / DemandId" Style="{StaticResource Caption}" Margin="0,0,0,5" /><TextBox ToolTip="SeriesId 或 DemandId" /></StackPanel>
                <StackPanel Grid.Column="10"><TextBlock Text="AREA 筛选" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="1"><ComboBoxItem Content="全部 AREA" /><ComboBoxItem Content="东区 · 12" /><ComboBoxItem Content="西区 · 9" /><ComboBoxItem Content="焊线区域 · 24" /></ComboBox></StackPanel>
                <ui:Button Grid.Column="12" Appearance="Secondary" Content="应用条件" Padding="14,6" VerticalAlignment="Bottom" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="0.9*" /><RowDefinition Height="16" /><RowDefinition Height="1.1*" /></Grid.RowDefinitions>
            <ui:Card Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="东区范围内的 DemandSeries" Style="{StaticResource Subtitle}" /><TextBlock Text="按当前 Demand 的可信 AREA 命中；GONE / Archived 使用最后可信 AREA" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="本页 6 / 共 6" Style="{StaticResource Caption}" VerticalAlignment="Center" /></Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DemandSeries}" SelectedIndex="2" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SeriesId" Binding="{Binding SeriesId}" Width="105" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="WORKTYPE" Binding="{Binding WorkType}" Width="170" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="128" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="生命周期" Binding="{Binding Lifecycle}" Width="90" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="出现状态" Binding="{Binding Presence}" Width="130" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="当前 AREA" Binding="{Binding CurrentArea}" Width="92" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="当前 Demand" Binding="{Binding CurrentDemandId}" Width="112" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="世代" Binding="{Binding DemandCount}" Width="60" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="事件" Binding="{Binding EventCount}" Width="60" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="开始" Binding="{Binding StartedAt}" Width="100" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeenAt}" Width="95" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="GONE SINCE" Binding="{Binding GoneSince}" Width="100" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="ARCHIVED" Binding="{Binding ArchivedAt}" Width="100" ElementStyle="{StaticResource DataGridTextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="第 1 / 1 页 · 共 6 条 · 范围：东区" Style="{StaticResource Caption}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Appearance="Secondary" Content="上一页" IsEnabled="False" Padding="9,4" /><ui:Button Appearance="Primary" Content="1" Padding="9,4" Margin="4,0" /><ui:Button Appearance="Secondary" Content="下一页" IsEnabled="False" Padding="9,4" /></StackPanel></Grid></Border>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="16,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><StackPanel><TextBlock Text="DS-000844 · STAGING_TO_WIRE + B240811-07" Style="{StaticResource Subtitle}" /><TextBlock Text="Tracking · 当前 D-002044 · 2 个 Demand 世代 · 9 个事件" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="当前 VISIBLE" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></Border></StackPanel><ui:Button Grid.Column="1" Appearance="Secondary" Content="打开完整详情" VerticalAlignment="Center" /></Grid>
                    <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                        <Grid Margin="16,12,16,14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="生命周期" Style="{StaticResource BodyStrong}" />
                            <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><Ellipse Width="10" Height="10" Fill="{StaticResource WatchAccentBrush}" HorizontalAlignment="Left" /><TextBlock Text="首次发现" Style="{StaticResource Caption}" Margin="0,5,0,0" /><TextBlock Text="09:12" Style="{StaticResource CodeText}" /></StackPanel>
                                <StackPanel Grid.Column="1"><Ellipse Width="10" Height="10" Fill="{StaticResource WatchWarningBrush}" HorizontalAlignment="Left" /><TextBlock Text="第 1 代 GONE" Style="{StaticResource Caption}" Margin="0,5,0,0" /><TextBlock Text="10:10" Style="{StaticResource CodeText}" /></StackPanel>
                                <StackPanel Grid.Column="2"><Ellipse Width="10" Height="10" Fill="{StaticResource WatchAccentBrush}" HorizontalAlignment="Left" /><TextBlock Text="第 2 代" Style="{StaticResource Caption}" Margin="0,5,0,0" /><TextBlock Text="10:18" Style="{StaticResource CodeText}" /></StackPanel>
                                <StackPanel Grid.Column="3"><Ellipse Width="10" Height="10" Fill="{StaticResource WatchSuccessBrush}" HorizontalAlignment="Left" /><TextBlock Text="当前可读" Style="{StaticResource Caption}" Margin="0,5,0,0" /><TextBlock Text="10:24" Style="{StaticResource CodeText}" /></StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="3" Text="Demand 世代" Style="{StaticResource BodyStrong}" />
                            <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedSeriesDemands}" Margin="0,27,0,0" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns><DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="105" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="代" Binding="{Binding Generation}" Width="42" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="创建" Binding="{Binding CreatedAt}" Width="118" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="外部可读" Binding="{Binding CurrentReadable}" Width="80" ElementStyle="{StaticResource DataGridTextCell}" /></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Border Grid.Column="1" Background="{StaticResource WatchStrokeBrush}" />
                        <Grid Grid.Column="2" Margin="16,12,16,14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DemandSeriesEvent" Style="{StaticResource BodyStrong}" /><TextBlock Text="严格按 SeriesSequence 排序的不可变事实" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="Sequence 1–9" Style="{StaticResource Caption}" VerticalAlignment="Center" /></Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSeriesEvents}" Margin="0,9,0,0" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns><DataGridTextColumn Header="SEQ" Binding="{Binding Sequence}" Width="48" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="EVENT KIND" Binding="{Binding EventKind}" Width="245" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="OBSERVED" Binding="{Binding ObservedAt}" Width="110" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" Width="100" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="280" ElementStyle="{StaticResource DataGridTextCell}" /></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
