<UserControl x:Class="MesIngest.Watch.FluentPrototype.NotificationToastVariantC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="通知方案 C：紧凑命令条">
    <ItemsControl ItemsSource="{Binding Toasts}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,0,0,8" Background="{StaticResource WatchSurfaceStrongBrush}" BorderBrush="{StaticResource WatchStrokeStrongBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="{Binding Title}" AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="14,11,8,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <Border x:Name="SeverityPill" Background="{StaticResource WatchAccentSoftBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Top"><TextBlock x:Name="SeverityText" Text="{Binding SeverityText}" Style="{StaticResource Caption}" Foreground="{StaticResource WatchAccentBrush}" FontWeight="SemiBold" /></Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource BodySecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Command="{Binding DismissCommand}" Appearance="Transparent" Width="32" Height="32" Padding="0" ToolTip="关闭通知" AutomationProperties.Name="关闭通知"><ui:SymbolIcon Symbol="Dismiss20" /></ui:Button>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource WatchSubtleBrush}" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="14,7">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding OccurrenceText}" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding TimerText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" /><ui:Button Grid.Column="2" Content="{Binding ActionLabel}" Appearance="Transparent" Padding="8,2" MinHeight="32" /></Grid>
                        </Border>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Success"><Setter TargetName="SeverityPill" Property="Background" Value="{StaticResource WatchSuccessSoftBrush}" /><Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource WatchSuccessBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter TargetName="SeverityPill" Property="Background" Value="{StaticResource WatchWarningSoftBrush}" /><Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource WatchWarningBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="SeverityPill" Property="Background" Value="{StaticResource WatchCriticalSoftBrush}" /><Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource WatchCriticalBrush}" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
