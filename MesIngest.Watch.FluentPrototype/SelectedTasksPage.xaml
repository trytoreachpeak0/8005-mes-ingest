<UserControl x:Class="MesIngest.Watch.FluentPrototype.SelectedTasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="任务浏览" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="PageContextText" Text="VISIBLE · 最近成功 12:42:14 · 自动刷新 10 秒" Style="{StaticResource BodySecondary}" Margin="0,3,0,0" />
        </StackPanel>

        <ui:Card Grid.Row="2" Padding="12" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="状态" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="VisibleButton" Appearance="Primary" Content="VISIBLE" Padding="16,6" />
                        <ui:Button x:Name="GoneButton" Appearance="Transparent" Content="GONE" Padding="16,6" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TASK_TYPE" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <ComboBox SelectedIndex="0" AutomationProperties.Name="TASK_TYPE 筛选">
                        <ComboBoxItem Content="全部任务类型" />
                        <ComboBoxItem Content="WIRE_TO_GATE" />
                        <ComboBoxItem Content="DIE_TO_OVEN" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="SUBLOT" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <TextBox AutomationProperties.Name="SUBLOT 筛选" ToolTip="输入 SUBLOT" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="DemandId" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <TextBox AutomationProperties.Name="DemandId 筛选" ToolTip="输入完整 DemandId" />
                </StackPanel>
                <ui:Button x:Name="ClearConditionsButton" Grid.Column="8" Appearance="Secondary" Content="清空条件" IsEnabled="False" Opacity="0.45" Padding="14,6" VerticalAlignment="Bottom" />
                <ui:Button Grid.Column="10" Appearance="Secondary" Content="应用条件" Padding="14,6" VerticalAlignment="Bottom" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.05*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="0.95*" />
            </Grid.RowDefinitions>

            <ui:Card Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="任务列表" Style="{StaticResource Subtitle}" />
                            <TextBlock x:Name="WindowCountText" Text="当前任务窗口 · 本页 5 行 · 已选 1 行" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="窗口最新" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" />
                        </Border>
                    </Grid>
                    <DataGrid x:Name="TasksGrid" Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedIndex="0" CanUserSortColumns="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DemandId" Binding="{Binding DemandId}" SortMemberPath="DemandId" Width="190" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="TASK_TYPE" Binding="{Binding TaskType}" SortMemberPath="TaskType" Width="190" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" SortMemberPath="Sublot" Width="150" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="AREA" Binding="{Binding Area}" SortMemberPath="Area" Width="85" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="EQP" Binding="{Binding Eqp}" SortMemberPath="Eqp" Width="95" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="STEP" Binding="{Binding Step}" SortMemberPath="Step" Width="100" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" SortMemberPath="Status" Width="100" ElementStyle="{StaticResource DataGridTextCell}" />
                            <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeen}" SortMemberPath="LastSeen" Width="120" ElementStyle="{StaticResource DataGridTextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PaginationText" Text="第 1 / 24 页 · 共 2,347 条" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Appearance="Secondary" Content="上一页" IsEnabled="False" Padding="9,5" />
                                <ui:Button Appearance="Primary" Content="1" Padding="9,5" />
                                <ui:Button Appearance="Transparent" Content="2" Padding="9,5" />
                                <ui:Button Appearance="Transparent" Content="3" Padding="9,5" />
                                <ui:Button x:Name="Page4Button" Appearance="Transparent" Content="4" Padding="9,5" />
                                <ui:Button x:Name="Page5Button" Appearance="Transparent" Content="5" Padding="9,5" />
                                <TextBlock x:Name="PageEllipsis" Text="…" Margin="4,0" VerticalAlignment="Center" />
                                <ui:Button x:Name="LastPageButton" Appearance="Transparent" Content="24" Padding="9,5" />
                                <ui:Button Appearance="Secondary" Content="下一页" Padding="9,5" />
                                <TextBlock Text="到" Style="{StaticResource Caption}" Margin="8,0,5,0" VerticalAlignment="Center" />
                                <TextBox Width="44" Padding="6,4" AutomationProperties.Name="目标页码" />
                                <TextBlock Text="页" Style="{StaticResource Caption}" Margin="5,0" VerticalAlignment="Center" />
                                <ui:Button Appearance="Secondary" Content="跳转" Padding="9,5" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="当前任务" Style="{StaticResource Subtitle}" />
                                <TextBlock x:Name="DemandIdText" Text="journey-visible-001" Style="{StaticResource CodeText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border x:Name="DemandStatusBorder" Background="{StaticResource WatchSuccessSoftBrush}" Padding="12,7" Margin="18,0,0,0" CornerRadius="4">
                                <TextBlock x:Name="DemandStatusText" Text="VISIBLE · 最近观察 12:42:14 · 无位置风险" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Transparent" ToolTip="复制 DemandId" AutomationProperties.Name="复制 DemandId"><ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon></ui:Button>
                            <ui:Button Appearance="Secondary" Content="查看完整详情" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />
                    <Grid Grid.Row="2" Margin="16,13,16,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MES 输入" Style="{StaticResource BodyStrong}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="TASK_TYPE" Style="{StaticResource Caption}" /><TextBlock Text="WIRE_TO_GATE" Style="{StaticResource CodeText}" Margin="0,3,12,10" /><TextBlock Text="PACKAGE" Style="{StaticResource Caption}" /><TextBlock Text="QFN48" Style="{StaticResource CodeText}" Margin="0,3,12,0" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="SUBLOT" Style="{StaticResource Caption}" /><TextBlock Text="SLOT-LOT-001" Style="{StaticResource CodeText}" Margin="0,3,12,10" /><TextBlock Text="DATES" Style="{StaticResource Caption}" /><TextBlock Text="2026-08-11 12:32:08 +08:00" Style="{StaticResource CodeText}" TextWrapping="Wrap" Margin="0,3,12,0" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="AREA" Style="{StaticResource Caption}" /><TextBlock Text="A01" Style="{StaticResource CodeText}" Margin="0,3,12,10" /><TextBlock Text="STEP" Style="{StaticResource Caption}" /><TextBlock Text="质检" Style="{StaticResource CodeText}" Margin="0,3,12,0" /></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="EQP" Style="{StaticResource Caption}" /><TextBlock Text="WB-01" Style="{StaticResource CodeText}" Margin="0,3,0,10" /></StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource WatchStrokeBrush}" />
                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                            <TextBlock Text="本地投影" Style="{StaticResource BodyStrong}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="DemandId" Style="{StaticResource Caption}" /><TextBlock x:Name="LocalDemandIdText" Text="journey-visible-001" Style="{StaticResource CodeText}" Margin="0,3,12,10" /><TextBlock Text="disappearCount" Style="{StaticResource Caption}" /><TextBlock x:Name="DisappearCountText" Text="0" Style="{StaticResource CodeText}" Margin="0,3,12,0" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="createdAt" Style="{StaticResource Caption}" /><TextBlock Text="2026-08-11 12:32:10" Style="{StaticResource CodeText}" Margin="0,3,0,10" /><TextBlock Text="locationRisk" Style="{StaticResource Caption}" /><TextBlock Text="false" Style="{StaticResource CodeText}" Margin="0,3,0,0" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
