<UserControl x:Class="MesIngest.Watch.FluentPrototype.AreaFilterLiveVariantE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- PROTOTYPE E: no master column. Profiles collapse into a top chip strip so the editor owns the full width. -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="14" Padding="14,7" Background="{StaticResource WatchSurfaceStrongBrush}" BorderBrush="{StaticResource WatchStrokeStrongBrush}" BorderThickness="1">
                        <TextBlock Text="全部 AREA" Style="{StaticResource BodySecondary}" />
                    </Border>
                    <Border CornerRadius="14" Padding="14,7" Margin="8,0,0,0" Background="{StaticResource WatchAccentBrush}" BorderBrush="{StaticResource WatchAccentBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="老厂前线焊线键合" Foreground="White" Style="{StaticResource BodyStrong}" Margin="7,0,0,0" />
                            <TextBlock Text="7" Foreground="#B8DDFF" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="14" Padding="14,7" Margin="8,0,0,0" Background="{StaticResource WatchSurfaceStrongBrush}" BorderBrush="{StaticResource WatchStrokeStrongBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="老厂前线装片" Style="{StaticResource BodySecondary}" />
                            <TextBlock Text="1" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="14" Padding="14,7" Margin="8,0,0,0" Background="{StaticResource WatchCriticalSoftBrush}" BorderBrush="{StaticResource WatchCriticalBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="临时范围" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodySecondary}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <ui:Button Appearance="Secondary" Content="＋ 新建" Padding="10,5" />
                <ui:Button Appearance="Secondary" Content="⋯" Padding="11,5" Margin="6,0,0,0" ToolTip="另存为 / 重命名 / 删除 / 打开配置文件夹">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="另存为…" />
                            <MenuItem Header="重命名…" />
                            <MenuItem Header="删除…" />
                            <Separator />
                            <MenuItem Header="打开配置文件夹" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="老厂前线焊线键合.txt" Style="{StaticResource Subtitle}" />
                            <TextBlock Text="ⓘ" Style="{StaticResource BodySecondary}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="每行一个 AREA，如 A1-1 或 A11-11；空行和 # 注释会忽略" />
                        </StackPanel>
                        <TextBlock Text="%LocalAppData%\MesIngest.Watch\area-filters · UTF-8" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border x:Name="ValidPill" Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}" VerticalAlignment="Center"><TextBlock Text="✓ 7 个有效 AREA" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></Border>
                    <Border x:Name="InvalidPill" Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="1 项问题 · 无效" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /></Border>
                    <ui:Button Grid.Column="2" Appearance="Secondary" Content="✓ 已应用" Padding="14,6" Margin="12,0,0,0" IsEnabled="False" />
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource WatchSubtleBrush}">
                        <TextBlock x:Name="LineNumbers" Text="1&#x0a;2&#x0a;3&#x0a;4&#x0a;5&#x0a;6&#x0a;7&#x0a;8" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource WatchTextTertiaryBrush}" TextAlignment="Right" LineHeight="24" Padding="0,14,11,10" />
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource WatchStrokeBrush}" />
                    <TextBox x:Name="EditorText" Grid.Column="2" Text="N1-1&#x0a;N1-2&#x0a;N1-3&#x0a;N1-4&#x0a;N1-5&#x0a;N1-6&#x0a;N1-7" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" TextBlock.LineHeight="24" Padding="14,14,14,10" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" />
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource WatchStrokeBrush}" />

                <Grid Grid.Row="4" Margin="16,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="ValidStatus" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✓ 格式有效" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" />
                        <TextBlock Text=" · 42 B · 0 个重复 · 仅影响本机当前用户" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="InvalidStatus" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="⚠ 第 8 行格式无效" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" />
                        <TextBlock Text=" · 显示范围仍为上一次有效的 7 个 AREA" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SyncText" Grid.Column="1" Text="已同步 · 15:07:57" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
