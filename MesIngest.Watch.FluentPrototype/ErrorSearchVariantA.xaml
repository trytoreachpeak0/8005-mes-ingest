<UserControl x:Class="MesIngest.Watch.FluentPrototype.ErrorSearchVariantA"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="370" /></Grid.ColumnDefinitions>

        <ui:Card Padding="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid VerticalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="16,14,16,10"><TextBlock Text="错误分类" Style="{StaticResource Subtitle}" /><TextBlock Text="14 个错误码 · 76 个 Series" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel>
                <TextBox Grid.Row="1" Margin="12,0,12,10" ToolTip="搜索错误分类或错误码" Text="搜索分类或错误码" Foreground="{StaticResource WatchTextTertiaryBrush}" />
                <ListBox Grid.Row="2" BorderThickness="0" SelectedIndex="0" ItemsSource="{Binding ErrorCategories}" Background="Transparent">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,7" Width="198"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Category}" Style="{StaticResource BodyStrong}" /><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding SeriesCount}" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="{Binding ActiveCount, StringFormat=活动 {0}}" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource Caption}" HorizontalAlignment="Right" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Column="2" Padding="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid VerticalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="数据格式" Style="{StaticResource Subtitle}" /><TextBlock Text="字段为空、格式非法或值无法解析" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="31 个 DemandSeries" Style="{StaticResource Caption}" VerticalAlignment="Center" /></Grid>
                <Grid Grid.Row="1" Margin="12,0,12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="185" /><ColumnDefinition Width="10" /><ColumnDefinition Width="135" /><ColumnDefinition Width="10" /><ColumnDefinition Width="150" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox SelectedIndex="0"><ComboBoxItem Content="全部错误码" /><ComboBoxItem Content="MES_AREA_FORMAT_INVALID" /><ComboBoxItem Content="EMPTY_MES_FIELD" /></ComboBox>
                    <ComboBox Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="活动 + 已恢复" /><ComboBoxItem Content="仅活动中" /><ComboBoxItem Content="仅已恢复" /></ComboBox>
                    <ComboBox Grid.Column="4" SelectedIndex="0"><ComboBoxItem Content="最近 24 小时" /><ComboBoxItem Content="最近 7 天" /><ComboBoxItem Content="全部历史" /></ComboBox>
                    <TextBox Grid.Column="6" ToolTip="SeriesId、DemandId 或 SUBLOT" />
                    <ui:Button Grid.Column="7" Appearance="Secondary" Content="应用条件" Margin="10,0,0,0" Padding="12,6" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding ErrorSeries}" SelectedIndex="0" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SeriesId" Binding="{Binding SeriesId}" Width="105" ElementStyle="{StaticResource DataGridTextCell}" />
                        <DataGridTextColumn Header="WORKTYPE" Binding="{Binding WorkType}" Width="165" ElementStyle="{StaticResource DataGridTextCell}" />
                        <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="120" ElementStyle="{StaticResource DataGridTextCell}" />
                        <DataGridTextColumn Header="错误码" Binding="{Binding ErrorCode}" Width="205" ElementStyle="{StaticResource DataGridTextCell}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding ErrorState}" Width="74" ElementStyle="{StaticResource DataGridTextCell}" />
                        <DataGridTextColumn Header="次数" Binding="{Binding Occurrences}" Width="52" ElementStyle="{StaticResource DataGridTextCell}" />
                        <DataGridTextColumn Header="最后发生" Binding="{Binding LastSeen}" Width="95" ElementStyle="{StaticResource DataGridTextCell}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="第 1 / 4 页 · 共 31 条" Style="{StaticResource Caption}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Appearance="Secondary" Content="上一页" IsEnabled="False" Padding="9,4" /><ui:Button Appearance="Primary" Content="1" Padding="9,4" Margin="4,0" /><ui:Button Appearance="Secondary" Content="下一页" Padding="9,4" /></StackPanel></Grid></Border>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Column="4" Padding="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid VerticalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="16,14"><TextBlock Text="DS-000918" Style="{StaticResource Subtitle}" /><TextBlock Text="WIRE_TO_GATE + B240812-17" Style="{StaticResource Caption}" Margin="0,3,0,0" /><Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}" HorizontalAlignment="Left" Margin="0,10,0,0"><TextBlock Text="错误仍活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /></Border></StackPanel>
                <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />
                <Grid Grid.Row="2" Margin="16,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="命中错误" Style="{StaticResource Caption}" /><TextBlock Text="MES_AREA_FORMAT_INVALID" Style="{StaticResource CodeText}" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="6 次 · 2 个 Demand 世代" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="当前原始 AREA" Style="{StaticResource Caption}" /><TextBlock Text="A01-01" Style="{StaticResource CodeText}" Foreground="{StaticResource WatchCriticalBrush}" Margin="0,4,0,0" /><TextBlock Text="格式非法，未规范化" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel></Grid>
                <Border Grid.Row="3" Background="{StaticResource WatchStrokeBrush}" />
                <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Margin="16,12,16,8"><TextBlock Text="错误发生记录" Style="{StaticResource BodyStrong}" /><TextBlock Text="跨 Demand 世代保留的命中证据" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><ListBox Grid.Row="1" BorderThickness="0" ItemsSource="{Binding ErrorEvidence}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,0,0,1" Padding="16,10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ObservedAt}" Style="{StaticResource BodyStrong}" /><TextBlock Grid.Column="1" Text="{Binding Revision}" Style="{StaticResource CodeText}" /></Grid><TextBlock Text="{Binding DemandId}" Style="{StaticResource CodeText}" Margin="0,4,0,0" /><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                <ui:Button Grid.Row="5" Appearance="Secondary" Content="在 DemandSeries 中打开完整详情" Margin="16,10,16,14" Padding="12,7" HorizontalAlignment="Stretch" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
