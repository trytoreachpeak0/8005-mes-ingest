<UserControl x:Class="MesIngest.Watch.FluentPrototype.VariantCView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:NavigationView PaneDisplayMode="LeftMinimal"
                       CompactPaneLength="48"
                       OpenPaneLength="220"
                       IsPaneOpen="False"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True"
                       HeaderVisibility="Collapsed">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="概览" IsActive="True"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
            <ui:NavigationViewItem Content="任务"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="TaskListSquareLtr24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
            <ui:NavigationViewItem Content="告警"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Alert24" /></ui:NavigationViewItem.Icon><ui:NavigationViewItem.InfoBadge><ui:InfoBadge Value="3" /></ui:NavigationViewItem.InfoBadge></ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItem Content="设置"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>
        <ui:NavigationView.ContentOverlay>
            <Grid Margin="24,16,24,72">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="今天需要关注什么" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="异常优先；健康信息保持可见但不抢占注意力" Style="{StaticResource BodySecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}" Margin="0,0,12,0"><TextBlock Text="Host 正常" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></Border>
                        <TextBlock Text="自动刷新 10 秒" Style="{StaticResource BodySecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <ui:InfoBar Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Warning" Title="接入可用，但有 3 个问题需要检查" Message="轮询本身成功；一个任务字段漂移、一个类型进入防骤降暂停、一个业务键重新出现。" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="400" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:Card Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="活动告警" Style="{StaticResource Subtitle}" /><TextBlock Text="严重程度优先" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}" VerticalAlignment="Center"><TextBlock Text="3" Foreground="{StaticResource WatchCriticalBrush}" FontWeight="SemiBold" /></Border>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Alerts}" BorderThickness="0" Background="Transparent" SelectedIndex="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" Style="{StaticResource CodeText}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding LastSeen}" Style="{StaticResource Caption}" /></Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource BodySecondary}" TextWrapping="Wrap" MaxHeight="40" Margin="0,7,0,0" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding TaskType}" Style="{StaticResource CodeText}" /><TextBlock Text="  ·  " Style="{StaticResource Caption}" /><TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" /></StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ui:Card>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="1.05*" /><RowDefinition Height="12" /><RowDefinition Height="0.95*" /></Grid.RowDefinitions>
                        <ui:Card Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="18,15">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="FIELD_DRIFT" Style="{StaticResource CodeText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource WatchCriticalBrush}" /><TextBlock Text="最近出现 12:41:52 · 共 4 次" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
                                    <ui:Button Grid.Column="1" Appearance="Secondary" Content="打开完整详情" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="18,0,18,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="业务定位" Style="{StaticResource BodyStrong}" Margin="0,0,0,12" />
                                        <TextBlock Text="TASK_TYPE" Style="{StaticResource Caption}" /><TextBlock Text="WIRE_TO_GATE" Style="{StaticResource CodeText}" Margin="0,4,0,10" />
                                        <TextBlock Text="SUBLOT" Style="{StaticResource Caption}" /><TextBlock Text="SLOT-LOT-001" Style="{StaticResource CodeText}" Margin="0,4,0,10" />
                                        <TextBlock Text="关系" Style="{StaticResource Caption}" /><TextBlock Text="精确 DemandId" Style="{StaticResource BodyStrong}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource WatchStrokeBrush}" />
                                    <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                        <TextBlock Text="字段比较" Style="{StaticResource BodyStrong}" Margin="0,0,0,12" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="字段" Style="{StaticResource Caption}" /><TextBlock Grid.Column="1" Text="冻结" Style="{StaticResource Caption}" /><TextBlock Grid.Column="2" Text="观测" Style="{StaticResource Caption}" /></Grid>
                                        <Border Background="{StaticResource WatchCriticalSoftBrush}" CornerRadius="4" Padding="8" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="STEP" Style="{StaticResource CodeText}" /><TextBlock Grid.Column="1" Text="焊线" /><TextBlock Grid.Column="2" Text="焊线2" Foreground="{StaticResource WatchCriticalBrush}" FontWeight="SemiBold" /></Grid></Border>
                                        <TextBlock Text="原 TransportDemand 保留冻结值，未被本次 MES 观测覆盖。" Style="{StaticResource BodySecondary}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ui:Card>

                        <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="关联 TransportDemand" Style="{StaticResource Subtitle}" /><TextBlock Text="当前成功窗口中的精确目标" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><ui:Button Grid.Column="1" Appearance="Transparent" Content="进入任务浏览" /></Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedIndex="0" HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TASK_TYPE" Binding="{Binding TaskType}" Width="190" />
                                        <DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="130" />
                                        <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="70" />
                                        <DataGridTextColumn Header="EQP" Binding="{Binding Eqp}" Width="80" />
                                        <DataGridTextColumn Header="STEP" Binding="{Binding Step}" Width="80" />
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </Grid>
            </Grid>
        </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>
</UserControl>
