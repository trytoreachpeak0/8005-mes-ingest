<UserControl x:Class="MesIngest.Watch.FluentPrototype.SelectedSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Host 连接、自动刷新与本机显示偏好" Style="{StaticResource BodySecondary}" Margin="0,3,0,0" />
            </StackPanel>
            <ui:Button Grid.Column="1" Appearance="Secondary" Content="恢复默认设置" VerticalAlignment="Center" />
        </Grid>

        <ui:InfoBar x:Name="ValidationInfo" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Error" Title="无法应用 Host 设置" Message="请求超时必须是 1–300 秒之间的整数。" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:Card Padding="0" Margin="0,0,0,16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchSuccessSoftBrush}"><ui:SymbolIcon Symbol="CloudCheckmark24" Foreground="{StaticResource WatchSuccessBrush}" /></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Host 连接" Style="{StaticResource Subtitle}" /><TextBlock Text="已连接 · 契约兼容 · 最近成功 12:42:16" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="2" Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}" VerticalAlignment="Center"><TextBlock Text="正常" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></Border></Grid>
                            <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />
                            <Grid Grid.Row="2" Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="服务地址" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="http://127.0.0.1:49837" /><TextBlock Grid.Row="2" Text="访问令牌" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><PasswordBox Grid.Row="2" Grid.Column="1" Password="prototype-token" Padding="9,6" /><TextBlock Grid.Row="4" Text="请求超时" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" /><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="TimeoutInput" Text="30" Width="100" /><TextBlock Text="秒 · 合法范围 1–300" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel></Grid>
                        </Grid>
                    </ui:Card>
                    <ui:Card Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="18,16"><TextBlock Text="连接变更" Style="{StaticResource Subtitle}" /><TextBlock Text="应用后取消旧 Host 的全部请求，清空旧业务窗口并返回概览。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel><Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" /><StackPanel Grid.Row="2" Margin="18,16"><ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="凭据仅保存在本机" Message="界面不会显示、复制或记录完整令牌。" /><ui:Button Appearance="Secondary" Content="应用 Host 设置" HorizontalAlignment="Right" Margin="0,14,0,0" /></StackPanel></Grid>
                    </ui:Card>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <ui:Card Padding="0" Margin="0,0,0,16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="18,16"><TextBlock Text="自动刷新间隔" Style="{StaticResource Subtitle}" /><TextBlock Text="所有数据视图始终自动刷新；这里只配置各视图的刷新时间。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
                            <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />
                            <StackPanel Grid.Row="2" Margin="18,10,18,16">
                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="概览" Style="{StaticResource BodyStrong}" /><TextBlock Text="Host、轮询、告警与任务摘要" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="10 秒" /><ComboBoxItem Content="30 秒" /><ComboBoxItem Content="60 秒" /></ComboBox></Grid>
                                <Border Height="1" Background="{StaticResource WatchStrokeBrush}" Margin="0,7" />
                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前可见任务" Style="{StaticResource BodyStrong}" /><TextBlock Text="VISIBLE 任务窗口" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="10 秒" /><ComboBoxItem Content="30 秒" /></ComboBox></Grid>
                                <Border Height="1" Background="{StaticResource WatchStrokeBrush}" Margin="0,7" />
                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="已消失任务" Style="{StaticResource BodyStrong}" /><TextBlock Text="GONE 历史任务窗口" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><ComboBox Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="30 秒" /><ComboBoxItem Content="60 秒" /></ComboBox></Grid>
                                <Border Height="1" Background="{StaticResource WatchStrokeBrush}" Margin="0,7" />
                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="接入告警" Style="{StaticResource BodyStrong}" /><TextBlock Text="IngestAlert 活动与已恢复历史" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><ComboBox Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="10 秒" /><ComboBoxItem Content="30 秒" /><ComboBoxItem Content="60 秒" /></ComboBox></Grid>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="18,16"><TextBlock Text="显示与布局" Style="{StaticResource Subtitle}" /><TextBlock Text="本机偏好，不影响 Host 或业务数据。" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" /><Grid Grid.Row="2" Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="记住任务详情区宽度" Style="{StaticResource BodyStrong}" /><TextBlock Text="重启后恢复最近布局" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="开" OffContent="关" /><ui:Button Grid.Row="1" Grid.ColumnSpan="2" Appearance="Secondary" Content="恢复默认布局" HorizontalAlignment="Left" Margin="0,16,0,0" /></Grid></Grid>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
