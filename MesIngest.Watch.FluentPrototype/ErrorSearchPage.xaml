<UserControl x:Class="MesIngest.Watch.FluentPrototype.ErrorSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MesIngest.Watch.FluentPrototype"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- PROTOTYPE: three error-history search layouts, switched by the review bar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="错误检索" Style="{StaticResource PageTitle}" />
                <TextBlock Text="按错误分类查找曾发生过该错误的 DemandSeries · 最近成功 12:42:16 · 自动刷新 30 秒" Style="{StaticResource BodySecondary}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}"><TextBlock Text="活动错误 19" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /></Border>
                <Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchSubtleBrush}" Margin="8,0,0,0"><TextBlock Text="近 24 小时 76 个 Series" Style="{StaticResource BodyStrong}" /></Border>
            </StackPanel>
        </Grid>

        <ui:InfoBar Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational"
                    Title="历史命中"
                    Message="结果包含已恢复的错误；同一 DemandSeries 只显示一次，详情保留每次命中的 Demand 世代与发生时间。" />

        <!-- The review switcher overlays this full-height surface. It is prototype chrome,
             so it must not shorten or misalign the page columns being evaluated. -->
        <Grid Grid.Row="4">
            <local:ErrorSearchVariantA x:Name="VariantA" />
            <local:ErrorSearchVariantB x:Name="VariantB" Visibility="Collapsed" />
            <local:ErrorSearchVariantC x:Name="VariantC" Visibility="Collapsed" />
        </Grid>

        <Border x:Name="ReviewSwitcher" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Padding="6"
                CornerRadius="18" Background="#E61F1F1F" BorderBrush="#55000000" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="←" Click="OnPreviousVariant" Width="34" Height="30" Padding="0" />
                <TextBlock x:Name="VariantLabel" Text="A — 分类导航 + 证据详情" Foreground="White" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0" MinWidth="205" TextAlignment="Center" />
                <Button Content="→" Click="OnNextVariant" Width="34" Height="30" Padding="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
