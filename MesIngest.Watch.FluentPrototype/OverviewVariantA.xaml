<UserControl x:Class="MesIngest.Watch.FluentPrototype.OverviewVariantA"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources><Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}"><Setter Property="VerticalAlignment" Value="Stretch" /></Style></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="174" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Card Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Timeline24" Foreground="{StaticResource WatchAccentBrush}" /><TextBlock Text="需求系列" Style="{StaticResource BodyStrong}" Margin="8,0,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="查看 →" Style="{StaticResource Caption}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="2,347" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="4 Tracking · 2 Archived" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Row="2" Text="2 个 GONE · 1 个归档后可见" Foreground="{StaticResource WatchWarningBrush}" Style="{StaticResource Caption}" /></Grid></ui:Card>
            <ui:Card Grid.Column="2" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="{StaticResource WatchAccentBrush}" /><TextBlock Text="资格审计" Style="{StaticResource BodyStrong}" Margin="8,0,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="查看 →" Style="{StaticResource Caption}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="1,842 / 2,347" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="当前外部可读" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Row="2" Text="505 个不可见或阻断" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource Caption}" /></Grid></ui:Card>
            <ui:Card Grid.Column="4" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource WatchAccentBrush}" /><TextBlock Text="错误检索" Style="{StaticResource BodyStrong}" Margin="8,0,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="查看 →" Style="{StaticResource Caption}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="19" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource WatchCriticalBrush}" /><TextBlock Text="活动错误" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Row="2" Text="近 24 小时命中 76 个 Series" Style="{StaticResource Caption}" /></Grid></ui:Card>
            <ui:Card Grid.Column="6" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Filter24" Foreground="{StaticResource WatchAccentBrush}" /><TextBlock Text="AREA 筛选" Style="{StaticResource BodyStrong}" Margin="8,0,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="管理 →" Style="{StaticResource Caption}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="东区" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="当前应用 · 12 个 AREA" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Row="2" Text="需求系列与资格审计共享" Style="{StaticResource Caption}" /></Grid></ui:Card>
            <ui:Card Grid.Column="8" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Alert24" Foreground="{StaticResource WatchCriticalBrush}" /><TextBlock Text="接入告警" Style="{StaticResource BodyStrong}" Margin="8,0,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="查看 →" Style="{StaticResource Caption}" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="3" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource WatchCriticalBrush}" /><TextBlock Text="活动告警" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Row="2" Text="2 ERROR · 1 WARNING" Style="{StaticResource Caption}" /></Grid></ui:Card>
        </Grid>

        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <ui:Card Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="16,14,16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="跨页重点动态" Style="{StaticResource Subtitle}" /><TextBlock Text="最近成功窗口中最值得关注的变化" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="按时间倒序" Style="{StaticResource Caption}" VerticalAlignment="Center" /></Grid><StackPanel Grid.Row="1">
                <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource WatchCriticalBrush}" /><StackPanel Grid.Column="1"><TextBlock Text="错误检索 · AREA 格式异常仍活动" Style="{StaticResource BodyStrong}" /><TextBlock Text="DS-000918 · A01-01 · 已连续命中 6 次" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="12:41:52" Style="{StaticResource Caption}" /></Grid></Border>
                <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="{StaticResource WatchWarningBrush}" /><StackPanel Grid.Column="1"><TextBlock Text="资格审计 · 505 个 Demand 当前不可读" Style="{StaticResource BodyStrong}" /><TextBlock Text="最大阻断项 EMPTY_MES_FIELD · AREA，共 82 个" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="12:42:14" Style="{StaticResource Caption}" /></Grid></Border>
                <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Timeline24" Foreground="{StaticResource WatchWarningBrush}" /><StackPanel Grid.Column="1"><TextBlock Text="需求系列 · 1 个 Series 归档后仍可见" Style="{StaticResource BodyStrong}" /><TextBlock Text="DS-000577 · WIRE_TO_NITROGEN + B240810-09" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="12:42:11" Style="{StaticResource Caption}" /></Grid></Border>
                <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Alert24" Foreground="{StaticResource WatchCriticalBrush}" /><StackPanel Grid.Column="1"><TextBlock Text="接入告警 · FIELD_DRIFT" Style="{StaticResource BodyStrong}" /><TextBlock Text="冻结字段 STEP 从 焊线 变为 焊线2；保留原投影" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="12:41:52" Style="{StaticResource Caption}" /></Grid></Border>
            </StackPanel></Grid></ui:Card>
            <ui:Card Grid.Column="2" Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="16,14,16,10"><TextBlock Text="当前显示范围" Style="{StaticResource Subtitle}" /><TextBlock Text="AREA 配置会同时影响两个数据页" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Row="1" Margin="16,6"><Border Padding="14" CornerRadius="8" Background="{StaticResource WatchAccentSoftBrush}"><StackPanel><TextBlock Text="东区 · 12 个 AREA" Style="{StaticResource BodyStrong}" /><TextBlock Text="已成功应用于 12:42:16 的结果" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel></Border><TextBlock Text="需求系列" Style="{StaticResource BodyStrong}" Margin="0,18,0,0" /><TextBlock Text="6 / 2,347 个 Series 在当前范围" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /><TextBlock Text="资格审计" Style="{StaticResource BodyStrong}" Margin="0,16,0,0" /><TextBlock Text="7 个 Demand · 4 可读 · 3 不可见或阻断" Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /></StackPanel><ui:Button Grid.Row="2" Appearance="Secondary" Content="管理 AREA 筛选" Margin="16,10,16,16" Padding="12,7" HorizontalAlignment="Stretch" /></Grid></ui:Card>
        </Grid>
    </Grid>
</UserControl>
