<UserControl x:Class="MesIngest.Watch.FluentPrototype.SelectedOverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MesIngest.Watch.FluentPrototype"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- PROTOTYPE: three cross-page overview layouts, switched by the review bar. -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="概览" Style="{StaticResource PageTitle}" /><TextBlock x:Name="PageContextText" Text="各分页运行摘要 · 最近成功 12:42:16 · 自动刷新 10 秒" Style="{StaticResource BodySecondary}" Margin="0,3,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon x:Name="HostIcon" Symbol="CloudCheckmark24" Foreground="{StaticResource WatchSuccessBrush}" Margin="0,0,6,0" /><TextBlock x:Name="HostStateText" Text="Host 已连接" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></StackPanel></Border><TextBlock Text="契约兼容 · 轮询 3.0 秒" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" /></StackPanel>
        </Grid>
        <ui:InfoBar x:Name="OfflineInfo" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Error" Title="无法连接 Host" Message="各分页保留 12:39:44 的最后成功摘要；当前数据可能已过期。" />
        <Grid Grid.Row="4"><local:OverviewVariantA x:Name="VariantA" /><local:OverviewVariantB x:Name="VariantB" Visibility="Collapsed" /><local:OverviewVariantC x:Name="VariantC" Visibility="Collapsed" /></Grid>
        <Border x:Name="ReviewSwitcher" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Padding="6" CornerRadius="18" Background="#E61F1F1F" BorderBrush="#55000000" BorderThickness="1">
            <StackPanel Orientation="Horizontal"><Button Content="←" Click="OnPreviousVariant" Width="34" Height="30" Padding="0" /><TextBlock x:Name="VariantLabel" Text="A — 分页卡片 + 重点动态" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" MinWidth="210" TextAlignment="Center" /><Button Content="→" Click="OnNextVariant" Width="34" Height="30" Padding="0" /></StackPanel>
        </Border>
    </Grid>
</UserControl>
