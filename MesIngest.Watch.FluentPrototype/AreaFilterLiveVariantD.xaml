<UserControl x:Class="MesIngest.Watch.FluentPrototype.AreaFilterLiveVariantD"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- PROTOTYPE D: master-detail, every file command lives in the left profile card. -->
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="318" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <ui:Card Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Grid Margin="16,14,16,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="筛选配置" Style="{StaticResource Subtitle}" /><TextBlock Text="3 个文件 · 1 个需要修复" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Secondary" Content="＋ 新建" Padding="10,5" />
                        <ui:Button Appearance="Secondary" Content="📁" Padding="9,5" Margin="6,0,0,0" ToolTip="打开配置文件夹" />
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="1" Margin="12,0,12,10" Text="搜索配置" Foreground="{StaticResource WatchTextTertiaryBrush}" />

                <ListBox Grid.Row="2" SelectedIndex="1" BorderThickness="0" Background="Transparent">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="另存为…" />
                            <MenuItem Header="重命名…" />
                            <Separator />
                            <MenuItem Header="删除…" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBoxItem Padding="0" HorizontalContentAlignment="Stretch">
                        <Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="全部 AREA（不筛选）" Style="{StaticResource BodyStrong}" /><TextBlock Text="不限制显示范围" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel></Grid>
                    </ListBoxItem>
                    <ListBoxItem Padding="0" HorizontalContentAlignment="Stretch">
                        <Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="老厂前线焊线键合" Style="{StaticResource BodyStrong}" /><TextBlock x:Name="SelectedRowMeta" Text="7 个 AREA · 15:07:57 已同步" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel><Border x:Name="SelectedRowAppliedPill" Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchAccentSoftBrush}" VerticalAlignment="Center"><TextBlock Text="当前应用" Foreground="{StaticResource WatchAccentBrush}" Style="{StaticResource Caption}" /></Border><Border x:Name="SelectedRowInvalidPill" Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="无效" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource Caption}" /></Border><TextBlock Grid.Column="2" Text="⋯" Style="{StaticResource BodyStrong}" Foreground="{StaticResource WatchTextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="另存为 / 重命名 / 删除" /></Grid>
                    </ListBoxItem>
                    <ListBoxItem Padding="0" HorizontalContentAlignment="Stretch">
                        <Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="老厂前线装片" Style="{StaticResource BodyStrong}" /><TextBlock Text="1 个 AREA · 15:03:58 已同步" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="有效" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource Caption}" VerticalAlignment="Center" /></Grid>
                    </ListBoxItem>
                    <ListBoxItem Padding="0" HorizontalContentAlignment="Stretch">
                        <Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="临时范围" Style="{StaticResource BodyStrong}" /><TextBlock Text="第 3 行格式无效" Style="{StaticResource Caption}" Foreground="{StaticResource WatchCriticalBrush}" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}" VerticalAlignment="Center"><TextBlock Text="无效" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource Caption}" /></Border></Grid>
                    </ListBoxItem>
                </ListBox>

                <Border Grid.Row="3" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="仅影响本机当前用户" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <ui:Button x:Name="ApplyButtonApplied" Grid.Column="1" Appearance="Secondary" Content="✓ 已应用" Padding="14,6" IsEnabled="False" />
                        <ui:Button x:Name="ApplyButtonBlocked" Grid.Column="1" Appearance="Primary" Content="应用此配置" Padding="14,6" IsEnabled="False" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Column="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="老厂前线焊线键合.txt" Style="{StaticResource Subtitle}" />
                        <TextBlock Text="%LocalAppData%\MesIngest.Watch\area-filters · UTF-8 · 每行一个 AREA，如 A1-1，# 开头忽略" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border x:Name="ValidPill" Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}" VerticalAlignment="Center"><TextBlock Text="✓ 7 个有效 AREA" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></Border>
                    <Border x:Name="InvalidPill" Grid.Column="1" Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="1 项问题 · 无效" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /></Border>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource WatchStrokeBrush}" />

                <Border Grid.Row="2" Margin="16,14" BorderBrush="{StaticResource WatchStrokeStrongBrush}" BorderThickness="1" CornerRadius="4" Background="{StaticResource WatchSurfaceStrongBrush}" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource WatchSubtleBrush}">
                            <TextBlock x:Name="LineNumbers" Text="1&#x0a;2&#x0a;3&#x0a;4&#x0a;5&#x0a;6&#x0a;7&#x0a;8" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource WatchTextTertiaryBrush}" TextAlignment="Right" LineHeight="24" Padding="0,10,9,10" />
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource WatchStrokeBrush}" />
                        <TextBox x:Name="EditorText" Grid.Column="2" Text="N1-1&#x0a;N1-2&#x0a;N1-3&#x0a;N1-4&#x0a;N1-5&#x0a;N1-6&#x0a;N1-7" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" TextBlock.LineHeight="24" Padding="12,10" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="{StaticResource WatchStrokeBrush}" />

                <Grid Grid.Row="4" Margin="16,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="ValidStatus" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✓ 格式有效" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" />
                        <TextBlock Text=" · 42 B · 0 个重复" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="InvalidStatus" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="⚠ 第 8 行格式无效" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" />
                        <TextBlock Text=" · 显示范围仍为上一次有效的 7 个 AREA" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SyncText" Grid.Column="1" Text="已同步 · 15:07:57" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
