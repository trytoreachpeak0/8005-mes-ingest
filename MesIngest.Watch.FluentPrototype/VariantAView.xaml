<UserControl x:Class="MesIngest.Watch.FluentPrototype.VariantAView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:NavigationView PaneDisplayMode="LeftFluent"
                       OpenPaneLength="232"
                       CompactPaneLength="48"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True"
                       IsPaneOpen="True"
                       HeaderVisibility="Collapsed"
                       IsFooterSeparatorVisible="True">
        <ui:NavigationView.PaneHeader>
            <TextBlock Text="工作区" Style="{StaticResource Caption}" Margin="12,8,0,12" />
        </ui:NavigationView.PaneHeader>
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="概览" IsActive="True">
                <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="任务浏览">
                <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="TaskListSquareLtr24" /></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="接入告警">
                <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Alert24" /></ui:NavigationViewItem.Icon>
                <ui:NavigationViewItem.InfoBadge><ui:InfoBadge Value="3" /></ui:NavigationViewItem.InfoBadge>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItem Content="设置">
                <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>
        <ui:NavigationView.ContentOverlay>
            <Grid Margin="24,16,24,72">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="概览" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Host、轮询、告警与任务的单屏运行摘要" Style="{StaticResource BodySecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="自动刷新 10 秒" Style="{StaticResource BodySecondary}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Card Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchSuccessSoftBrush}">
                                <ui:SymbolIcon Symbol="Server24" Foreground="{StaticResource WatchSuccessBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Host 接入" Style="{StaticResource Caption}" />
                                <TextBlock Text="已连接 · 契约兼容" Style="{StaticResource BodyStrong}" Margin="0,3,0,0" />
                                <TextBlock Text="最近成功 12:42:16" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card Grid.Column="2" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchSuccessSoftBrush}">
                                <ui:SymbolIcon Symbol="Pulse24" Foreground="{StaticResource WatchSuccessBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="最近轮询" Style="{StaticResource Caption}" />
                                <TextBlock Text="成功 · 3.0 秒" Style="{StaticResource BodyStrong}" Margin="0,3,0,0" />
                                <TextBlock Text="MES 快照 100 行" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card Grid.Column="4" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WatchCriticalSoftBrush}">
                                <ui:SymbolIcon Symbol="Alert24" Foreground="{StaticResource WatchCriticalBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="活动告警" Style="{StaticResource Caption}" />
                                <TextBlock Text="3 条需要查看" Style="{StaticResource BodyStrong}" Margin="0,3,0,0" Foreground="{StaticResource WatchCriticalBrush}" />
                                <TextBlock Text="2 ERROR · 1 WARNING" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <ui:Card Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="16,14,16,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="需要关注" Style="{StaticResource Subtitle}" />
                                    <TextBlock Text="按严重程度和最近出现时间排序" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Transparent" Content="查看全部" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource WatchCriticalBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Code}" Style="{StaticResource CodeText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                                                        <TextBlock Text="{Binding TaskType}" Style="{StaticResource CodeText}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BodySecondary}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding LastSeen}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" Margin="0,5,0,0" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ui:Card>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="1*" /><RowDefinition Height="12" /><RowDefinition Height="1*" /></Grid.RowDefinitions>
                        <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="VISIBLE TransportDemand" Style="{StaticResource Subtitle}" />
                                        <TextBlock Text="当前成功窗口" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="100+" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource WatchAccentBrush}" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TaskTypeCounts}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TaskType}" Style="{StaticResource CodeText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource BodyStrong}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ui:Card>
                        <ui:Card Grid.Row="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="运行边界" Style="{StaticResource Subtitle}" />
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock Text="✓  只读，不修改业务数据" Style="{StaticResource BodySecondary}" Margin="0,0,0,8" />
                                    <TextBlock Text="✓  单 Host、固定 100 行游标窗口" Style="{StaticResource BodySecondary}" Margin="0,0,0,8" />
                                    <TextBlock Text="✓  Host 故障不伪装为 IngestAlert" Style="{StaticResource BodySecondary}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </Grid>
            </Grid>
        </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>
</UserControl>
