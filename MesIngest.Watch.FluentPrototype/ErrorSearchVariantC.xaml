<UserControl x:Class="MesIngest.Watch.FluentPrototype.ErrorSearchVariantC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="210" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:Card Padding="12" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="170" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="查找错误码、说明、SeriesId、DemandId 或 SUBLOT" Style="{StaticResource Caption}" Margin="0,0,0,5" /><TextBox ToolTip="全文搜索" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="发生时间" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="最近 24 小时" /><ComboBoxItem Content="最近 7 天" /><ComboBoxItem Content="全部历史" /></ComboBox></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="状态" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="活动 + 已恢复" /><ComboBoxItem Content="活动中" /></ComboBox></StackPanel><ui:Button Grid.Column="6" Appearance="Secondary" Content="应用条件" Padding="14,6" VerticalAlignment="Bottom" /></Grid></ui:Card>

        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Card Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="数据格式" Style="{StaticResource Subtitle}" /><TextBlock Text="31" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="7 个仍活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /><TextBlock Text="4 个错误码" Style="{StaticResource Caption}" Margin="0,7,0,0" /><ui:Button Appearance="Secondary" Content="查看结果" HorizontalAlignment="Left" Margin="0,16,0,0" /></StackPanel></ui:Card>
            <ui:Card Grid.Column="2" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="一致性冲突" Style="{StaticResource Subtitle}" /><TextBlock Text="18" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="5 个仍活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /><TextBlock Text="3 个错误码" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel></ui:Card>
            <ui:Card Grid.Column="4" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="生命周期" Style="{StaticResource Subtitle}" /><TextBlock Text="12" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="2 个仍活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /><TextBlock Text="3 个错误码" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel></ui:Card>
            <ui:Card Grid.Column="6" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="源数据漂移" Style="{StaticResource Subtitle}" /><TextBlock Text="9" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="4 个仍活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /><TextBlock Text="2 个错误码" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel></ui:Card>
            <ui:Card Grid.Column="8" Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="接入质量" Style="{StaticResource Subtitle}" /><TextBlock Text="6" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="1 个仍活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /><TextBlock Text="2 个错误码" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel></ui:Card>
        </Grid>

        <ui:Card Grid.Row="4" Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="数据格式 · 31 个 DemandSeries" Style="{StaticResource Subtitle}" /><TextBlock Text="已从分类总览下钻 · 结果包含活动与已恢复错误" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox SelectedIndex="0" Width="210"><ComboBoxItem Content="全部数据格式错误码" /><ComboBoxItem Content="AREA 格式非法" /><ComboBoxItem Content="字段为空" /></ComboBox><ui:Button Appearance="Secondary" Content="清除下钻" Margin="8,0,0,0" /></StackPanel></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding ErrorSeries}" SelectedIndex="0" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="SeriesId" Binding="{Binding SeriesId}" Width="110" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="WORKTYPE" Binding="{Binding WorkType}" Width="185" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="130" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="90" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="错误码" Binding="{Binding ErrorCode}" Width="225" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="状态" Binding="{Binding ErrorState}" Width="85" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="次数" Binding="{Binding Occurrences}" Width="65" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="命中 Demand" Binding="{Binding AffectedDemand}" Width="155" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="首次发生" Binding="{Binding FirstSeen}" Width="110" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="最后发生" Binding="{Binding LastSeen}" Width="110" ElementStyle="{StaticResource DataGridTextCell}" /></DataGrid.Columns></DataGrid></Grid></ui:Card>
    </Grid>
</UserControl>
