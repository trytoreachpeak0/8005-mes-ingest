<UserControl x:Class="MesIngest.Watch.FluentPrototype.ErrorSearchVariantB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:Card Padding="16" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="170" /><ColumnDefinition Width="12" /><ColumnDefinition Width="170" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="错误码、分类或说明" Style="{StaticResource Caption}" Margin="0,0,0,5" /><TextBox FontSize="16" Text="AREA 格式" Padding="10,7" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="状态" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="活动 + 已恢复" /><ComboBoxItem Content="活动中" /><ComboBoxItem Content="已恢复" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="发生时间" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="最近 24 小时" /><ComboBoxItem Content="最近 7 天" /><ComboBoxItem Content="全部历史" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="AREA 范围" Style="{StaticResource Caption}" Margin="0,0,0,5" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="全部 AREA" /><ComboBoxItem Content="东区 · 12" /><ComboBoxItem Content="西区 · 9" /></ComboBox></StackPanel>
                <ui:Button Grid.Column="8" Appearance="Secondary" Content="搜索" Padding="18,7" VerticalAlignment="Bottom" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Card Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,14"><TextBlock Text="缩小结果" Style="{StaticResource Subtitle}" /><TextBlock Text="当前 18 个 DemandSeries" Style="{StaticResource Caption}" Margin="0,3,0,14" />
                <TextBlock Text="错误分类" Style="{StaticResource BodyStrong}" /><CheckBox Content="数据格式 (31)" IsChecked="True" Margin="0,9,0,0" /><CheckBox Content="一致性冲突 (18)" Margin="0,7,0,0" /><CheckBox Content="生命周期 (12)" Margin="0,7,0,0" /><CheckBox Content="源数据漂移 (9)" Margin="0,7,0,0" />
                <Border Height="1" Background="{StaticResource WatchStrokeBrush}" Margin="0,16" /><TextBlock Text="错误码" Style="{StaticResource BodyStrong}" /><CheckBox Content="AREA 格式非法 (12)" IsChecked="True" Margin="0,9,0,0" /><CheckBox Content="字段为空 (11)" Margin="0,7,0,0" /><CheckBox Content="值解析失败 (8)" Margin="0,7,0,0" />
                <Border Height="1" Background="{StaticResource WatchStrokeBrush}" Margin="0,16" /><TextBlock Text="当前状态" Style="{StaticResource BodyStrong}" /><CheckBox Content="活动中 (7)" IsChecked="True" Margin="0,9,0,0" /><CheckBox Content="已恢复 (11)" IsChecked="True" Margin="0,7,0,0" />
            </StackPanel></ScrollViewer></ui:Card>

            <ui:Card Grid.Column="2" Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="搜索结果" Style="{StaticResource Subtitle}" /><TextBlock Text="匹配“AREA 格式” · 同一 Series 去重 · 按最后发生时间排序" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchCriticalSoftBrush}"><TextBlock Text="7 活动" Foreground="{StaticResource WatchCriticalBrush}" Style="{StaticResource BodyStrong}" /></Border><Border Style="{StaticResource StatusPill}" Background="{StaticResource WatchSuccessSoftBrush}" Margin="8,0,0,0"><TextBlock Text="11 已恢复" Foreground="{StaticResource WatchSuccessBrush}" Style="{StaticResource BodyStrong}" /></Border></StackPanel></Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ErrorSeries}" SelectedIndex="0" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
                    <DataGridTextColumn Header="SeriesId" Binding="{Binding SeriesId}" Width="110" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="WORKTYPE" Binding="{Binding WorkType}" Width="180" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="SUBLOT" Binding="{Binding Sublot}" Width="130" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="85" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="匹配错误码" Binding="{Binding ErrorCode}" Width="220" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="错误状态" Binding="{Binding ErrorState}" Width="85" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="发生次数" Binding="{Binding Occurrences}" Width="75" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="命中 Demand" Binding="{Binding AffectedDemand}" Width="150" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="首次发生" Binding="{Binding FirstSeen}" Width="105" ElementStyle="{StaticResource DataGridTextCell}" /><DataGridTextColumn Header="最后发生" Binding="{Binding LastSeen}" Width="105" ElementStyle="{StaticResource DataGridTextCell}" />
                </DataGrid.Columns></DataGrid>
                <Border Grid.Row="2" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="已选择 DS-000918 · 6 次命中 · 当前仍活动" Style="{StaticResource BodyStrong}" /><TextBlock Text="最近：D-002311 第 2 代 · MES_AREA_FORMAT_INVALID · 12:41:52" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Appearance="Secondary" Content="查看命中记录" Padding="12,6" /><ui:Button Appearance="Secondary" Content="打开 Series 详情" Margin="8,0,0,0" Padding="12,6" /></StackPanel></Grid></Border>
            </Grid></ui:Card>
        </Grid>
    </Grid>
</UserControl>
