<UserControl x:Class="MesIngest.Watch.FluentPrototype.NotificationToastVariantB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="通知方案 B：分组活动面板">
    <Border Background="{StaticResource WatchSurfaceStrongBrush}" BorderBrush="{StaticResource WatchStrokeStrongBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="14,12,10,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Alert24" Foreground="{StaticResource WatchAccentBrush}" />
                    <TextBlock Text="活动通知" Style="{StaticResource BodyStrong}" Margin="8,0,0,0" />
                    <Border Background="{StaticResource WatchAccentSoftBrush}" CornerRadius="10" Padding="7,2" Margin="8,0,0,0"><TextBlock Text="{Binding Toasts.Count}" Style="{StaticResource Caption}" /></Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="按优先级" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ToastRow" BorderBrush="{StaticResource WatchStrokeBrush}" BorderThickness="0,1,0,0" Padding="14,11" AutomationProperties.Name="{Binding Title}" AutomationProperties.LiveSetting="Polite">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="SeverityIcon" Symbol="Info24" Foreground="{StaticResource WatchAccentBrush}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel><TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" DockPanel.Dock="Left" /><TextBlock Text="{Binding TimerText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" /></DockPanel>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodySecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Source, StringFormat=来源 · {0}}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Command="{Binding DismissCommand}" Appearance="Transparent" Width="32" Height="32" Padding="0" ToolTip="关闭通知" AutomationProperties.Name="关闭通知"><ui:SymbolIcon Symbol="Dismiss20" /></ui:Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Success"><Setter TargetName="SeverityIcon" Property="Symbol" Value="CheckmarkCircle24" /><Setter TargetName="SeverityIcon" Property="Foreground" Value="{StaticResource WatchSuccessBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter TargetName="SeverityIcon" Property="Symbol" Value="Warning24" /><Setter TargetName="SeverityIcon" Property="Foreground" Value="{StaticResource WatchWarningBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="SeverityIcon" Property="Symbol" Value="ErrorCircle24" /><Setter TargetName="SeverityIcon" Property="Foreground" Value="{StaticResource WatchCriticalBrush}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
